  <Item class="StarterPlayer" referent="7">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="8">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="9">
        <Properties>
          <string name="Name">CarSpinner</string>
          <string name="Source"><![CDATA[-- ============================================================
-- Fait tourner les voitures des showrooms (côté joueur).
-- Le serveur pose les voitures et les marque "SpinningCar" ;
-- ici on les fait tourner localement, sans rien envoyer sur le réseau.
-- ============================================================

local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")

local SPEED = math.rad(30) -- degrés par seconde
local MAX_DISTANCE = 150 -- on ne fait tourner que les voitures proches (moins de calculs)

local cars = {} -- [voiture] = { root, base, offset }

local function add(car)
	cars[car] = {}
end

local function remove(car)
	cars[car] = nil
end

CollectionService:GetInstanceAddedSignal("SpinningCar"):Connect(add)
CollectionService:GetInstanceRemovedSignal("SpinningCar"):Connect(remove)
for _, car in ipairs(CollectionService:GetTagged("SpinningCar")) do
	add(car)
end

RunService.RenderStepped:Connect(function()
	local rotation = CFrame.Angles(0, os.clock() * SPEED, 0)
	for car, state in pairs(cars) do
		if not state.offset then
			-- Les pièces peuvent arriver un peu après la voiture : on attend qu'elles soient là
			local root = car.PrimaryPart
			local base = car:GetAttribute("SpinBase")
			if not root or not base then
				continue
			end
			state.root = root
			state.base = base
			state.offset = base:ToObjectSpace(root.CFrame)
		end
		local camera = workspace.CurrentCamera
		if camera and (camera.CFrame.Position - state.base.Position).Magnitude < MAX_DISTANCE then
			state.root.CFrame = state.base * rotation * state.offset
		end
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="10">
        <Properties>
          <string name="Name">CashHud</string>
          <string name="Source"><![CDATA[-- ============================================================
-- Compteur d'argent affiché en bas de l'écran (côté joueur)
-- ============================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local formatMoney = require(ReplicatedStorage:WaitForChild("FormatMoney"))
local player = Players.LocalPlayer

local gui = Instance.new("ScreenGui")
gui.Name = "CashHud"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.AnchorPoint = Vector2.new(0.5, 1)
frame.Position = UDim2.new(0.5, 0, 1, -24)
frame.Size = UDim2.fromOffset(240, 64)
frame.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
frame.BackgroundTransparency = 0.2
frame.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 14)
corner.Parent = frame

local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromRGB(255, 200, 0)
stroke.Thickness = 2
stroke.Parent = frame

local scale = Instance.new("UIScale")
scale.Parent = frame

local label = Instance.new("TextLabel")
label.Size = UDim2.fromScale(1, 1)
label.BackgroundTransparency = 1
label.Font = Enum.Font.GothamBlack
label.TextScaled = true
label.TextColor3 = Color3.fromRGB(255, 200, 0)
label.Text = "$0"
label.Parent = frame

local padding = Instance.new("UIPadding")
padding.PaddingTop = UDim.new(0, 10)
padding.PaddingBottom = UDim.new(0, 10)
padding.Parent = frame

-- Bonus de rebirth affiché au-dessus du compteur
local bonusLabel = Instance.new("TextLabel")
bonusLabel.AnchorPoint = Vector2.new(0.5, 1)
bonusLabel.Position = UDim2.new(0.5, 0, 0, -4)
bonusLabel.Size = UDim2.new(1, 0, 0, 22)
bonusLabel.BackgroundTransparency = 1
bonusLabel.Font = Enum.Font.GothamBold
bonusLabel.TextScaled = true
bonusLabel.TextColor3 = Color3.fromRGB(200, 140, 255)
bonusLabel.TextStrokeTransparency = 0.3
bonusLabel.Visible = false
bonusLabel.Parent = frame

local leaderstats = player:WaitForChild("leaderstats")
local cash = leaderstats:WaitForChild("Cash")
local rebirths = leaderstats:WaitForChild("Rebirths")
local Config = require(ReplicatedStorage:WaitForChild("Config"))

local function updateBonus()
	local bonus = math.floor(Config.RebirthBonus * rebirths.Value * 100 + 0.5)
	bonusLabel.Text = "Rebirth " .. rebirths.Value .. "  ·  +" .. bonus .. "% cash"
	bonusLabel.Visible = rebirths.Value > 0
end
rebirths.Changed:Connect(updateBonus)
updateBonus()
local lastValue = cash.Value

local function update()
	label.Text = "$" .. formatMoney(cash.Value)
	-- Petit effet "pop" quand l'argent augmente
	if cash.Value > lastValue then
		scale.Scale = 1.12
		TweenService:Create(scale, TweenInfo.new(0.2), { Scale = 1 }):Play()
	end
	lastValue = cash.Value
end

cash.Changed:Connect(update)
update()

-- Notifications envoyées par le serveur (ventes au marché, etc.)
local StarterGui = game:GetService("StarterGui")
ReplicatedStorage:WaitForChild("Notify").OnClientEvent:Connect(function(text)
	pcall(function()
		StarterGui:SetCore("SendNotification", { Title = "Garage Tycoon", Text = text, Duration = 5 })
	end)
end)
]]></string>
        </Properties>
      </Item>
    </Item>
