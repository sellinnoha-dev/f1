	},
}

return Config
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="4">
      <Properties>
        <string name="Name">FormatMoney</string>
        <string name="Source"><![CDATA[-- Transforme un nombre en texte court : 1500 -> "1.5K", 2000000 -> "2M"
-- Utilisé par le serveur (boutons) et par le client (compteur d'argent).
return function(n)
	local text
	if n >= 1e6 then
		text = string.format("%.1fM", n / 1e6)
	elseif n >= 1e3 then
		text = string.format("%.1fK", n / 1e3)
	else
		return tostring(n)
	end
	return (text:gsub("%.0([KM])", "%1"))
end
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="5">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="6">
      <Properties>
        <string name="Name">TycoonServer</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- ============================================================
-- Garage Tycoon : script serveur principal
-- Construit les garages, fait tourner les machines, gère l'argent,
-- les achats, la sauvegarde et le Game Pass.
-- Les réglages (prix, gains...) sont dans ReplicatedStorage > Config.
-- ============================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")
local MarketplaceService = game:GetService("MarketplaceService")
local Debris = game:GetService("Debris")
local PathfindingService = game:GetService("PathfindingService")
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local formatMoney = require(ReplicatedStorage:WaitForChild("FormatMoney"))
-- Le script serveur et Config doivent venir de la même mise à jour
local EXPECTED_CONFIG_VERSION = "16 - logos retires"
print("[Tycoon] Garage Tycoon version " .. tostring(Config.Version))
if Config.Version ~= EXPECTED_CONFIG_VERSION then
	warn("[Tycoon] ATTENTION : Config n'est pas à jour (" .. tostring(Config.Version) .. " au lieu de "
		.. EXPECTED_CONFIG_VERSION .. "). Ferme l'onglet Config s'il est ouvert, puis relance la mise à jour.")
end

-- On fait apparaître les persos nous-mêmes, directement dans leur garage
Players.CharacterAutoLoads = false

-- Couleurs utilisées partout
local COLOR_FLOOR = Color3.fromRGB(70, 70, 75)
local COLOR_DARK = Color3.fromRGB(35, 35, 40)
local COLOR_BUTTON = Color3.fromRGB(0, 200, 90)
local COLOR_BUTTON_DENIED = Color3.fromRGB(220, 40, 40)
local COLOR_GOLD = Color3.fromRGB(255, 200, 0)
local COLOR_REBIRTH = Color3.fromRGB(170, 70, 255)
local COLOR_CHOICE = Color3.fromRGB(60, 140, 255)

-- Accès rapide à un objet par son id : itemsById["paint"]
local carsById, raritiesById = {}, {}
for _, car in ipairs(Config.Cars or {}) do
	carsById[car.id] = car
end
for _, rarity in ipairs(Config.Rarities or {}) do
	raritiesById[rarity.id] = rarity
end

local itemsById = {}
for _, item in ipairs(Config.Items) do
	itemsById[item.id] = item
end

-- La DataStore peut échouer (jeu pas encore publié, accès API désactivé dans Studio).
-- Dans ce cas on joue sans sauvegarde au lieu de planter.
local dataStore = nil
if Config.SaveEnabled then
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		dataStore = result
	else
		warn("[Tycoon] Sauvegarde désactivée :", result)
	end
end

local plotsFolder = Instance.new("Folder")
plotsFolder.Name = "Tycoons"
plotsFolder.Parent = workspace

local plots = {}      -- la liste des garages
local playerData = {} -- [player] = { owned = {}, cash = n, loaded = bool, plot = garage }

-- ============================================================
-- Petits outils
-- ============================================================

-- Crée une pièce ancrée avec les propriétés données, puis la place dans parent
local function makePart(parent, props)
	local part = Instance.new("Part")
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in pairs(props) do
		part[key] = value
	end
	part.Parent = parent
	return part
end

-- Position dans le repère du garage : (0, 0, 0) = centre du sol du garage
local function at(plot, x, y, z)
	return plot.cframe * CFrame.new(x, y, z)
end

-- Texte flottant au-dessus d'une pièce
-- Texte flottant au-dessus d'une pièce : un titre blanc et, en option, une ligne dorée.
-- La taille est en studs : le texte rapetisse avec la distance, comme un vrai panneau,
-- donc les textes lointains ne se chevauchent plus.
local function createBillboard(part, title, subtitle, offsetY, width, titleColor)
	width = width or 7
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.new(width, 0, subtitle and 2.6 or 1.4, 0)
	gui.StudsOffset = Vector3.new(0, offsetY, 0)
	gui.MaxDistance = 80
	gui.LightInfluence = 0
	gui.Parent = part

	local function addLabel(text, posY, height, color)
		local label = Instance.new("TextLabel")
		label.Position = UDim2.fromScale(0, posY)
		label.Size = UDim2.fromScale(1, height)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.GothamBold
		label.TextScaled = true
		label.TextColor3 = color
		label.TextStrokeTransparency = 0
		label.Text = text
		label.Parent = gui
		return label
	end

	if subtitle then
		addLabel(title, 0, 0.5, titleColor or Color3.new(1, 1, 1))
		addLabel(subtitle, 0.52, 0.48, COLOR_GOLD)
	else
		addLabel(title, 0, 1, Color3.new(1, 1, 1))
	end
	return gui
end

local function getCash(player)
	local stats = player:FindFirstChild("leaderstats")
	return stats and stats:FindFirstChild("Cash")
end

local function getRebirths(player)
	local stats = player:FindFirstChild("leaderstats")
	local rebirths = stats and stats:FindFirstChild("Rebirths")
	return rebirths and rebirths.Value or 0
end

-- Nom affiché d'un propriétaire (joueur ou bot)
local function displayName(owner)
	return owner:IsA("Player") and owner.DisplayName or owner.Name
end

-- Messages en bas à droite de l'écran du joueur (ignorés pour les bots)
local notifyEvent = Instance.new("RemoteEvent")
notifyEvent.Name = "Notify"
notifyEvent.Parent = ReplicatedStorage

local function notify(owner, text)
	if owner and owner:IsA("Player") then
		notifyEvent:FireClient(owner, text)
	end
end

-- Niveau du garage selon le nombre de rebirths (Standard, Bronze, Argent...)
-- Niveau de secours si Config est une ancienne version (évite de bloquer le jeu)
local FALLBACK_TIERS = {
	{
		name = "STANDARD", lamps = 0,
		floorColor = Color3.fromRGB(70, 70, 75), floorMaterial = Enum.Material.Concrete,
		wallColor = Color3.fromRGB(200, 200, 205), wallMaterial = Enum.Material.Brick,
		trimColor = Color3.fromRGB(255, 200, 0),
	},
}

local function getTier(owner)
	local tiers = Config.GarageTiers or FALLBACK_TIERS
	local index = math.min((owner and getRebirths(owner) or 0) + 1, #tiers)
	return tiers[index], index
end

-- Somme d'un bonus donné par les "perks" possédés (ex : carIncomeBonus, marketBonus)
local function perkBonus(owned, field)
	local total = 0
	for _, item in ipairs(Config.Items) do
		if owned[item.id] and item[field] then
			total += item[field]
		end
	end
	return total
end

-- Embranchement : un autre objet du même choix a-t-il déjà été pris ?
local function choiceTaken(owned, item)
	if not item.choice then
		return false
	end
	for _, other in ipairs(Config.Items) do
		if other.choice == item.choice and other.id ~= item.id and owned[other.id] then
			return true
		end
	end
	return false
end

-- Multiplicateur total d'argent : Game Pass x2 et bonus de rebirth
local function getMultiplier(player)
	return (player:GetAttribute("CashMultiplier") or 1) * (1 + Config.RebirthBonus * getRebirths(player))
end

-- ============================================================
-- Les pièces qui roulent sur le tapis
-- ============================================================

-- ============================================================
-- Modèles de la Boîte à outils (optionnels)
-- Range tes modèles dans ServerStorage > Assets, avec les noms indiqués
-- dans Config ("model = ..."). S'ils n'y sont pas, on garde les formes simples.
-- ============================================================

local function getAsset(name)
	local folder = ServerStorage:FindFirstChild("Assets")
	return name and folder and folder:FindFirstChild(name)
end

-- Un élément ressemble-t-il à un logo de marque ? (autocollant, texte, pièce "Logo"...)
local LOGO_WORDS = { "logo", "badge", "emblem", "brand", "decal", "plate", "sticker" }
local function looksLikeLogo(instance)
	if instance:IsA("Decal") or instance:IsA("SurfaceGui") then
		return true -- les logos et plaques sont presque toujours des autocollants
	end
	if instance:IsA("BasePart") then
		local name = instance.Name:lower()
		for _, word in ipairs(LOGO_WORDS) do
			if name:find(word, 1, true) then
				return true
			end
		end
	end
	return false
end

-- Copie un modèle sans ses scripts (sécurité), ses sons ni ses logos, et le met à la bonne taille
local function cloneAsset(asset, targetSize)
	local clone = asset:Clone()
	for _, descendant in ipairs(clone:GetDescendants()) do
		if descendant.Parent and (descendant:IsA("LuaSourceContainer") or descendant:IsA("Sound")
			or (Config.RemoveLogos and looksLikeLogo(descendant))) then
			descendant:Destroy()
		end
	end
	if clone:IsA("BasePart") then
		local biggest = math.max(clone.Size.X, clone.Size.Y, clone.Size.Z)
		clone.Size *= targetSize / biggest
	elseif clone:IsA("Model") then
		local _, size = clone:GetBoundingBox()
		local biggest = math.max(size.X, size.Y, size.Z)
		clone:ScaleTo(clone:GetScale() * targetSize / biggest)
	else
		clone:Destroy()
		return nil
	end
	return clone
end

local function getParts(object)
	if object:IsA("BasePart") then
		return { object }
	end
	local parts = {}
	for _, descendant in ipairs(object:GetDescendants()) do
		if descendant:IsA("BasePart") then
			table.insert(parts, descendant)
		end
	end
	return parts
end

-- Retrouve la pièce (ou le modèle) qui porte la valeur à partir de la partie touchée
local function getDrop(hit)
	local current = hit
	while current and current ~= workspace do
		if current:GetAttribute("Value") then
			return current
		end
		current = current.Parent
	end
	return nil
end

-- Forme des pièces auto qui sortent des machines (voir "drop" dans Config)
local DROP_SHAPES = {
	bolt = { size = Vector3.new(1.4, 0.7, 0.7), shape = Enum.PartType.Cylinder, material = Enum.Material.Metal },
	tire = { size = Vector3.new(0.9, 2, 2), shape = Enum.PartType.Cylinder, material = Enum.Material.Rubber, flat = true },
	engine = { size = Vector3.new(1.8, 1.4, 1.6), shape = Enum.PartType.Block, material = Enum.Material.Metal },
	panel = { size = Vector3.new(2.2, 0.5, 1.6), shape = Enum.PartType.Block, material = Enum.Material.SmoothPlastic },
	rim = { size = Vector3.new(0.6, 2, 2), shape = Enum.PartType.Cylinder, material = Enum.Material.Foil, flat = true },
}

-- Crée une pièce à partir d'un modèle de la Boîte à outils, soudé en un seul bloc
-- Pièce à partir d'un modèle de la Boîte à outils.
-- Pour éviter le lag, la physique est gérée par une simple boîte invisible ;
-- le modèle n'est qu'un "habillage" soudé dessus, sans collisions.
local function makeDropFromAsset(asset, look, spawnCFrame)
	local clone = cloneAsset(asset, math.max(look.size.X, look.size.Y, look.size.Z) * 1.4)
	if not clone then
		return nil, nil
	end
	local parts = getParts(clone)
	if #parts == 0 then
		clone:Destroy()
		return nil, nil
	end

	local drop = Instance.new("Model")
	local root = Instance.new("Part")
	root.Name = "Hitbox"
	root.Size = look.size
	root.Transparency = 1
	root.CFrame = spawnCFrame
	root.Parent = drop
	drop.PrimaryPart = root

	-- Centre l'habillage sur la boîte
	local box = clone:IsA("Model") and clone:GetBoundingBox() or clone.CFrame
	clone:PivotTo(clone:GetPivot() + (spawnCFrame.Position - box.Position))
	for _, part in ipairs(parts) do
		part.Anchored = false
		part.CanCollide = false
		part.CanTouch = false
		part.CanQuery = false
		part.Massless = true
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = part
		weld.Parent = root
	end
	clone.Parent = drop
	return drop, root
end

local function spawnDrop(plot, item)
	local look = DROP_SHAPES[item.drop] or DROP_SHAPES.bolt
	local spawnCFrame = at(plot, -25, 5, item.z)
	local drop, root

	-- Trop de pièces sur le tapis : on attend qu'il se vide (évite le lag)
	if #plot.drops:GetChildren() >= Config.MaxDropsPerPlot then
		return
	end

	local asset = getAsset(item.model)
	if asset then
		drop, root = makeDropFromAsset(asset, look, spawnCFrame)
	end
	if not drop then
		drop = Instance.new("Part")
		drop.Shape = look.shape
		drop.Size = look.size
		drop.Color = item.color
		drop.Material = look.material
		drop.CFrame = spawnCFrame
		if look.flat then
			-- Pneus et jantes posés à plat sur le tapis
			drop.CFrame *= CFrame.Angles(0, 0, math.rad(90))
		end
		drop:SetAttribute("Tintable", true)
		root = drop
	end

	drop.Name = "Drop"
	drop:SetAttribute("Value", item.value)
	drop:SetAttribute("Plot", plot.index)
	drop.Parent = plot.drops
	-- Le serveur gère la physique : un tricheur ne peut pas déplacer les pièces
	root:SetNetworkOwner(nil)
	Debris:AddItem(drop, Config.DropLifetime)
end

-- Une pièce touche le collecteur : on la vend
local function onCollect(plot, hit)
	local drop = getDrop(hit)
	local value = drop and drop:GetAttribute("Value")
	if not value or drop:GetAttribute("Plot") ~= plot.index then
		return
	end
	drop:SetAttribute("Plot", nil) -- empêche de compter la même pièce deux fois
	drop:Destroy()

	local owner = plot.owner
	local cash = owner and getCash(owner)
	if cash then
		local multiplier = getMultiplier(owner)
		cash.Value += math.floor(value * multiplier + 0.5)
	end
end

-- ============================================================
-- Construction des objets achetés
-- ============================================================

local function buildDropper(plot, item, model)
	makePart(model, {
		Name = "Pillar", Size = Vector3.new(1, 8, 1), CFrame = at(plot, -28, 4, item.z),
		Color = COLOR_DARK, Material = Enum.Material.Metal,
	})
	local head = makePart(model, {
		Name = "Head", Size = Vector3.new(6, 3, 4), CFrame = at(plot, -25.5, 7.5, item.z),
		Color = item.color, Material = Enum.Material.Metal,
	})
	createBillboard(head, item.name, "+$" .. formatMoney(item.value), 3.2, 6)

	-- Boucle de production : s'arrête toute seule quand la machine est détruite
	task.spawn(function()
		while model.Parent do
			task.wait(item.interval)
			if not model.Parent then
				break
			end
			spawnDrop(plot, item)
		end
	end)
end

local function buildUpgrader(plot, item, model)
	for _, x in ipairs({ -27.75, -22.25 }) do
		makePart(model, {
			Name = "Post", Size = Vector3.new(0.5, 5, 0.5), CFrame = at(plot, x, 2.5, item.z),
			Color = COLOR_DARK, Material = Enum.Material.Metal,
		})
	end
	makePart(model, {
		Name = "Top", Size = Vector3.new(6, 0.5, 0.5), CFrame = at(plot, -25, 5.25, item.z),
		Color = COLOR_DARK, Material = Enum.Material.Metal,
	})
	local gate = makePart(model, {
		Name = "Gate", Size = Vector3.new(5, 4, 0.4), CFrame = at(plot, -25, 2.5, item.z),
		Color = item.color, Material = Enum.Material.Neon, Transparency = 0.5, CanCollide = false,
	})
	createBillboard(gate, item.name, nil, 3.6, 6)

	local tag = "Upgraded_" .. item.id
	gate.Touched:Connect(function(hit)
		local drop = getDrop(hit)
		local value = drop and drop:GetAttribute("Value")
		if not value or drop:GetAttribute("Plot") ~= plot.index or drop:GetAttribute(tag) then
			return
		end
		drop:SetAttribute(tag, true)
		drop:SetAttribute("Value", value * item.multiplier)
		if drop:GetAttribute("Tintable") then
			drop.Color = item.color -- la pièce prend la couleur de la machine
		end
	end)
end

local function buildWalls(plot, item, model)
	local walls = {
		{ Vector3.new(80, 16, 1), Vector3.new(0, 8, -40) }, -- fond
		{ Vector3.new(1, 16, 80), Vector3.new(-40, 8, 0) }, -- gauche
		{ Vector3.new(1, 16, 80), Vector3.new(40, 8, 0) },  -- droite
	}
	local tier = getTier(plot.owner)
	for _, wall in ipairs(walls) do
		local size, pos = wall[1], wall[2]
		makePart(model, {
			Name = "Wall", Size = size, CFrame = at(plot, pos.X, pos.Y, pos.Z),
			Color = tier.wallColor, Material = tier.wallMaterial,
		})
	end
end

-- Prépare une voiture à tourner sur son podium.
-- La rotation est faite par chaque joueur (script CarSpinner) : le serveur ne déplace rien,
-- donc pas de lag réseau, même avec des voitures de centaines de pièces.
local function spinOnPodium(car, base, noSpin)
	local parts = getParts(car)
	if #parts == 0 then
		return
	end
	-- La plus grosse pièce sert d'axe, toutes les autres lui sont soudées
	local root = parts[1]
	for _, part in ipairs(parts) do
		if part.Size.Magnitude > root.Size.Magnitude then
			root = part
		end
	end
	for _, part in ipairs(parts) do
		part.CanCollide = false
		part.CanTouch = false
		if part ~= root then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = root
			weld.Part1 = part
			weld.Parent = root
		end
	end
	for _, part in ipairs(parts) do
		if part ~= root then
			part.Anchored = false
			part.Massless = true
		end
	end
	root.Anchored = true
	car.PrimaryPart = root
	if not noSpin then
		car:SetAttribute("SpinBase", base)
		CollectionService:AddTag(car, "SpinningCar")
	end
end

-- Place une voiture de la Boîte à outils sur le podium. Renvoie false si impossible.
local function placeAssetCar(item, model, base, noSpin)
	local asset = getAsset(item.model)
	local clone = asset and cloneAsset(asset, item.style == "super" and 12 or 11)
	if not clone then
		return nil
	end
	local car = clone
	if clone:IsA("BasePart") then
		car = Instance.new("Model")
		clone.Parent = car
	end
	for _, part in ipairs(getParts(car)) do
		part.Anchored = true
	end
	-- Le point de pivot devient le dessous de la voiture, pour la poser pile sur le podium
	local box, size = car:GetBoundingBox()
	car.WorldPivot = CFrame.new(box.Position - Vector3.new(0, size.Y / 2, 0))
	car.Name = "Car"
	car.Parent = model
	car:PivotTo(base)
	spinOnPodium(car, base, noSpin)
	return car
end

-- Pose une voiture (modèle de la Boîte à outils, sinon voiture simple) sur un podium.
-- noSpin = true : elle ne tourne pas (voitures du tapis de livraison). Renvoie le modèle.
local function placeCar(item, model, base, noSpin)
	local assetCar = placeAssetCar(item, model, base, noSpin)
	if assetCar then
		return assetCar
	end

	local car = Instance.new("Model")
	car.Name = "Car"
	car.Parent = model

	local function carPart(name, size, x, y, z, color, material, extra)
		local props = {
			Name = name, Size = size, CFrame = base * CFrame.new(x, y, z),
			Color = color, Material = material,
		}
		for key, value in pairs(extra or {}) do
			props[key] = value
		end
		return makePart(car, props)
	end

	local glass = Color3.fromRGB(20, 25, 35)
	if item.style == "super" then
		carPart("Body", Vector3.new(5.4, 1.2, 11), 0, 1.4, 0, item.color, Enum.Material.SmoothPlastic)
		carPart("Cabin", Vector3.new(4.6, 1.1, 4.5), 0, 2.55, 0.5, glass, Enum.Material.Glass, { Transparency = 0.2 })
		carPart("Spoiler", Vector3.new(5, 0.3, 1.2), 0, 2.9, 5, COLOR_DARK, Enum.Material.SmoothPlastic)
		for _, x in ipairs({ -1.8, 1.8 }) do
			carPart("SpoilerLeg", Vector3.new(0.3, 0.9, 0.3), x, 2.35, 5, COLOR_DARK, Enum.Material.SmoothPlastic)
		end
	else
		carPart("Body", Vector3.new(5, 1.6, 10), 0, 1.6, 0, item.color, Enum.Material.SmoothPlastic)
		carPart("Cabin", Vector3.new(4.4, 1.6, 5), 0, 3.2, 0.5, glass, Enum.Material.Glass, { Transparency = 0.2 })
	end
	for _, x in ipairs({ -1.6, 1.6 }) do
		carPart("Headlight", Vector3.new(1, 0.4, 0.2), x, 1.6, -5.1, Color3.new(1, 1, 1), Enum.Material.Neon)
	end
	for _, x in ipairs({ -2.6, 2.6 }) do
		for _, z in ipairs({ -3.2, 3.2 }) do
			carPart("Wheel", Vector3.new(1, 2.4, 2.4), x, 1.2, z, Color3.fromRGB(20, 20, 20),
				Enum.Material.SmoothPlastic, { Shape = Enum.PartType.Cylinder })
		end
	end

	car.WorldPivot = base
	spinOnPodium(car, base, noSpin)
	return car
end

-- Paillettes sur les voitures des raretés les plus hautes
local function decorateRarity(car, carDef)
	local rarity = raritiesById[carDef.rarity]
	if rarity and rarity.sparkles and car.PrimaryPart then
		local sparkles = Instance.new("Sparkles")
		sparkles.SparkleColor = rarity.color
		sparkles.Parent = car.PrimaryPart
	end
end

-- Podium de luxe : socle sombre, anneau lumineux et plateau en marbre blanc.
-- ground = position au sol ; renvoie le plateau et le CFrame du dessus (où poser la voiture)
local function makePodium(parent, ground, trimColor)
	local turn = CFrame.Angles(0, 0, math.rad(90))
	makePart(parent, {
		Name = "PodiumBase", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.2, 13, 13),
		CFrame = ground * CFrame.new(0, 0.6, 0) * turn, Color = COLOR_DARK, Material = Enum.Material.Metal,
	})
	makePart(parent, {
		Name = "PodiumRing", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.25, 13.6, 13.6),
		CFrame = ground * CFrame.new(0, 0.75, 0) * turn, Color = trimColor, Material = Enum.Material.Neon,
	})
	local top = makePart(parent, {
		Name = "Podium", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 12, 12),
		CFrame = ground * CFrame.new(0, 1.35, 0) * turn,
		Color = Color3.fromRGB(240, 240, 245), Material = Enum.Material.Marble,
	})
	return top, ground * CFrame.new(0, 1.5, 0)
end

local listCar -- défini plus bas, dans la partie "Marché"

-- ============================================================
-- Places de parking du garage : chaque voiture possédée y est exposée
-- ============================================================

local function slotUnlocked(data, slotDef)
	return slotDef.requires == nil or data.owned[slotDef.requires] == true
end

-- Première place libre et débloquée (nil si le garage est plein)
local function freeSlotIndex(data)
	for index, slotDef in ipairs(Config.CarSlots) do
		if slotUnlocked(data, slotDef) and not data.cars[index] then
			return index
		end
	end
	return nil
end

-- Voiture qui rapporte le moins (pour la remplacer par une meilleure)
local function worstCarSlot(data)
	local worstIndex, worstIncome = nil, math.huge
	for index, carId in pairs(data.cars) do
		local car = carsById[carId]
		if car and car.income < worstIncome then
			worstIndex, worstIncome = index, car.income
		end
	end
	return worstIndex, worstIncome
end

local quickSell -- défini juste après

-- (Re)construit une place : podium + voiture + touches E (marché) et F (vente rapide)
local function renderSlot(plot, index)
	local old = plot.carSlots:FindFirstChild("Slot" .. index)
	if old then
		old:Destroy()
	end
	local owner = plot.owner
	local data = owner and playerData[owner]
	local slotDef = Config.CarSlots[index]
	if not data or not slotDef or not slotUnlocked(data, slotDef) then
		return
	end

	local model = Instance.new("Model")
	model.Name = "Slot" .. index
	model.Parent = plot.carSlots
	local p = slotDef.position
	local podium, top = makePodium(model, at(plot, p.X, p.Y, p.Z), getTier(owner).trimColor)
	local car = data.cars[index] and carsById[data.cars[index]]
	if not car then
		createBillboard(podium, "EMPTY SPOT", "Buy cars on the delivery belt", 7, 10)
		return
	end

	local rarity = raritiesById[car.rarity]
	createBillboard(podium, car.name, rarity.name .. "  ·  +$" .. formatMoney(car.income) .. "/s", 7, 11, rarity.color)

	local sellPrompt = Instance.new("ProximityPrompt")
	sellPrompt.ActionText = "Sell at Market"
	sellPrompt.ObjectText = "Get $" .. formatMoney(math.floor(car.price * Config.MarketSellerBonus))
	sellPrompt.HoldDuration = 1
	sellPrompt.MaxActivationDistance = 12
	sellPrompt.RequiresLineOfSight = false
	sellPrompt.Parent = podium
	sellPrompt.Triggered:Connect(function(player)
		if player == plot.owner then
			listCar(plot, index)
		end
	end)

	local quickPrompt = Instance.new("ProximityPrompt")
	quickPrompt.ActionText = "Quick Sell $" .. formatMoney(math.floor(car.price * Config.QuickSellRatio))
	quickPrompt.ObjectText = car.name
	quickPrompt.KeyboardKeyCode = Enum.KeyCode.F
	quickPrompt.HoldDuration = 1.5
	quickPrompt.MaxActivationDistance = 12
	quickPrompt.RequiresLineOfSight = false
	quickPrompt.UIOffset = Vector2.new(0, 70)
	quickPrompt.Parent = podium
	quickPrompt.Triggered:Connect(function(player)
		if player == plot.owner then
			quickSell(plot, index)
		end
	end)

	decorateRarity(placeCar(car, model, top), car)
end

local function renderSlots(plot)
	plot.carSlots:ClearAllChildren()
	for index in ipairs(Config.CarSlots) do
		renderSlot(plot, index)
	end
end

-- Vente rapide : la voiture disparaît, on récupère une partie de son prix
function quickSell(plot, index)
	local owner = plot.owner
	local data = owner and playerData[owner]
	local cash = owner and getCash(owner)
	local car = data and data.cars[index] and carsById[data.cars[index]]
	if not car or not cash then
		return
	end
	data.cars[index] = nil
	local earned = math.floor(car.price * Config.QuickSellRatio)
	cash.Value += earned
	renderSlot(plot, index)
	notify(owner, "Sold " .. car.name .. " for $" .. formatMoney(earned))
end

-- Étage VIP : dalle sur la moitié droite du garage, escalier, rambardes et murs
local FLOOR_Y = 16 -- hauteur du sol de l'étage

local function buildUpperFloor(plot, item, model)
	local function block(name, size, x, y, z, color, material, extra)
		local props = {
			Name = name, Size = size, CFrame = at(plot, x, y, z),
			Color = color, Material = material,
		}
		for key, value in pairs(extra or {}) do
			props[key] = value
		end
		return makePart(model, props)
	end
	local tier = getTier(plot.owner)
	local floorColor = Color3.fromRGB(225, 225, 230)
	local glass = { Transparency = 0.5 }

	-- Dalle de l'étage et palier en haut de l'escalier
	block("UpperFloor", Vector3.new(24, 1, 80), 28, FLOOR_Y - 0.5, 0, floorColor, Enum.Material.Marble)
	block("Landing", Vector3.new(14, 1, 4.5), 9, FLOOR_Y - 0.5, -37.25, floorColor, Enum.Material.Marble)

	-- Escalier contre le mur du fond : 16 marches de 1 stud
	local steps = 16
	local depth = 1.6
	for i = 1, steps do
		local height = FLOOR_Y * i / steps
		block("Step", Vector3.new(6, height, depth), 5, height / 2, -12 - (i - 0.5) * depth,
			COLOR_DARK, Enum.Material.Concrete)
	end

	-- Piliers sous la dalle
	for _, z in ipairs({ 36, 4, -24 }) do
		block("Pillar", Vector3.new(1, FLOOR_Y - 1, 1), 16.5, (FLOOR_Y - 1) / 2, z, COLOR_DARK, Enum.Material.Metal)
	end

	-- Rambardes en verre et murs de l'étage
	block("Railing", Vector3.new(0.4, 3, 75), 16.2, FLOOR_Y + 1.5, 2.5, item.color, Enum.Material.Glass, glass)
	block("Railing", Vector3.new(8, 3, 0.4), 12, FLOOR_Y + 1.5, -35.2, item.color, Enum.Material.Glass, glass)
	block("Railing", Vector3.new(24, 3, 0.4), 28, FLOOR_Y + 1.5, 39.8, item.color, Enum.Material.Glass, glass)
	block("UpperWall", Vector3.new(1, 10, 80), 40, FLOOR_Y + 5, 0, tier.wallColor, tier.wallMaterial)
	block("UpperWall", Vector3.new(38, 10, 1), 21, FLOOR_Y + 5, -40, tier.wallColor, tier.wallMaterial)

	-- Bande lumineuse et panneau
	local strip = block("NeonStrip", Vector3.new(0.3, 0.4, 78), 39.4, FLOOR_Y + 9, 0, tier.trimColor, Enum.Material.Neon)
	createBillboard(strip, "VIP SHOWROOM", nil, 2, 16)
end

-- Bureau d'un "perk" (bonus permanent choisi dans un embranchement)
local function buildPerk(plot, item, model)
	local p = item.position
	makePart(model, {
		Name = "Desk", Size = Vector3.new(6, 3, 3), CFrame = at(plot, p.X, 1.5, p.Z),
		Color = Color3.fromRGB(90, 60, 40), Material = Enum.Material.Wood,
	})
	local screen = makePart(model, {
		Name = "Screen", Size = Vector3.new(3, 2, 0.3), CFrame = at(plot, p.X, 4, p.Z),
		Color = item.color, Material = Enum.Material.Neon,
	})
	createBillboard(screen, item.name, "ACTIVE", 3, 9)
end

-- Places de parking en plus : marquage au sol
local function buildParking(plot, item, model)
	for _, z in ipairs({ -16, -30 }) do
		makePart(model, {
			Name = "ParkingLine", Size = Vector3.new(14, 0.1, 0.4), CFrame = at(plot, 28, 0.05, z + 7),
			Color = Color3.new(1, 1, 1), Material = Enum.Material.SmoothPlastic,
		})
	end
end

local builders = {
	perk = buildPerk,
	parking = buildParking,
	dropper = buildDropper,
	upgrader = buildUpgrader,
	walls = buildWalls,
	floor = buildUpperFloor,
}

local function buildItem(plot, item)
	local model = Instance.new("Model")
	model.Name = item.id
	model.Parent = plot.items
	builders[item.kind](plot, item, model)
end

-- ============================================================
-- Boutons d'achat
-- ============================================================

local refreshButtons -- déclarée ici car createButton en a besoin

-- Pas assez d'argent : le bouton clignote en rouge
local function flashDenied(button)
	if button:GetAttribute("Flashing") then
		return
	end
	local original = button.Color
	button:SetAttribute("Flashing", true)
	button.Color = COLOR_BUTTON_DENIED
	task.delay(0.5, function()
		button.Color = original
		button:SetAttribute("Flashing", nil)
	end)
end

-- Achat d'un objet par le propriétaire du garage (joueur ou bot). Renvoie true si acheté.
local function purchase(plot, owner, item)
	if owner ~= plot.owner or plot.buying then
		return false
	end
	local data = playerData[owner]
	local cash = getCash(owner)
	if not data or not cash or data.owned[item.id] or cash.Value < item.price then
		return false
	end
	plot.buying = true
	cash.Value -= item.price
	data.owned[item.id] = true
	buildItem(plot, item)
	refreshButtons(plot)
	if item.kind == "parking" or item.kind == "floor" then
		renderSlots(plot) -- nouvelles places de parking
	end
	plot.buying = false
	return true
end

local function tryBuy(plot, item, button, hit)
	local player = Players:GetPlayerFromCharacter(hit.Parent)
	if not player or player ~= plot.owner then
		return
	end
	local cash = getCash(player)
	if cash and cash.Value < item.price then
		flashDenied(button)
		return
	end
	purchase(plot, player, item)
end

local function createButton(plot, item)
	local pos = item.button
	-- Les boutons d'un embranchement sont bleus : on ne peut en prendre qu'un
	local button = makePart(plot.model, {
		Name = "Button_" .. item.id, Size = Vector3.new(4, 0.6, 4),
		CFrame = at(plot, pos.X, 0.3, pos.Z), Color = item.choice and COLOR_CHOICE or COLOR_BUTTON,
		Material = Enum.Material.Neon,
	})
	local priceText = item.price == 0 and "FREE" or ("$" .. formatMoney(item.price))
	if item.choice then
		priceText = priceText .. " · CHOOSE ONE"
	end
	createBillboard(button, item.name, priceText, 3, 8)
	button.Touched:Connect(function(hit)
		tryBuy(plot, item, button, hit)
	end)
	return button
end

-- ============================================================
-- Rebirth : quand tout est acheté, on recommence à zéro
-- contre un bonus d'argent permanent
-- ============================================================

local function getRebirthCost(player)
	return Config.RebirthCost * (getRebirths(player) + 1)
end

local applyTheme -- défini plus bas : décore le garage selon son niveau

-- Rebirth du propriétaire (joueur ou bot). Renvoie true si effectué.
local function performRebirth(plot, owner)
	if owner ~= plot.owner or plot.buying then
		return false
	end
	local data = playerData[owner]
	local cash = getCash(owner)
	local rebirths = owner.leaderstats:FindFirstChild("Rebirths")
	if not data or not cash or not rebirths or cash.Value < getRebirthCost(owner) then
		return false
	end

	plot.buying = true
	rebirths.Value += 1
	cash.Value = Config.StartingCash
	data.owned = {}
	for index in pairs(data.cars) do
		if index > Config.RebirthKeepSlots then
			data.cars[index] = nil
		end
	end
	plot.items:ClearAllChildren()
	plot.drops:ClearAllChildren()
	for _, oldButton in pairs(plot.buttons) do
		oldButton:Destroy()
	end
	plot.buttons = {}
	plot.rebirthButton:Destroy()
	plot.rebirthButton = nil
	applyTheme(plot)
	renderSlots(plot)
	refreshButtons(plot)
	plot.buying = false
	local tier = getTier(owner)
	notify(owner, "Rebirth! Your garage is now " .. tier.name .. " level!")
	return true
end

local function doRebirth(plot, button, hit)
	local player = Players:GetPlayerFromCharacter(hit.Parent)
	if not player or player ~= plot.owner then
		return
	end
	local cash = getCash(player)
	if cash and cash.Value < getRebirthCost(player) then
		flashDenied(button)
		return
	end
	performRebirth(plot, player)
end

local function createRebirthButton(plot)
	local pos = Config.RebirthButton
	local button = makePart(plot.model, {
		Name = "RebirthButton", Size = Vector3.new(5, 0.6, 5),
		CFrame = at(plot, pos.X, 0.3, pos.Z), Color = COLOR_REBIRTH, Material = Enum.Material.Neon,
	})
	local bonus = math.floor(Config.RebirthBonus * 100 + 0.5)
	createBillboard(button, "REBIRTH (+" .. bonus .. "% cash)", "$" .. formatMoney(getRebirthCost(plot.owner)), 3, 9)
	button.Touched:Connect(function(hit)
		doRebirth(plot, button, hit)
	end)
	return button
end

-- Affiche les boutons des objets débloqués et pas encore achetés
function refreshButtons(plot)
	local data = plot.owner and playerData[plot.owner]
	if not data then
		return
	end
	for _, item in ipairs(Config.Items) do
		local visible = not data.owned[item.id] and not choiceTaken(data.owned, item)
			and (item.requires == nil or data.owned[item.requires])
		local button = plot.buttons[item.id]
		if visible and not button then
			plot.buttons[item.id] = createButton(plot, item)
		elseif not visible and button then
			button:Destroy()
			plot.buttons[item.id] = nil
		end
	end

	-- Le bouton de rebirth apparaît quand tout est acheté
	local allOwned = true
	for _, item in ipairs(Config.Items) do
		if not data.owned[item.id] and not choiceTaken(data.owned, item) then
			allOwned = false
			break
		end
	end
	if allOwned and not plot.rebirthButton then
		plot.rebirthButton = createRebirthButton(plot)
	elseif not allOwned and plot.rebirthButton then
		plot.rebirthButton:Destroy()
		plot.rebirthButton = nil
	end
end

-- Bouton doré pour acheter le Game Pass "Argent x2"
local function createGamePassPad(plot)
	local owner = plot.owner
	if Config.CashX2GamePassId == 0 or not owner or not owner:IsA("Player") or owner:GetAttribute("CashMultiplier") == 2 then
		return
	end
	local pad = makePart(plot.model, {
		Name = "GamePassPad", Size = Vector3.new(5, 0.6, 5), CFrame = at(plot, Config.GamePassPad.X, 0.3, Config.GamePassPad.Z),
		Color = COLOR_GOLD, Material = Enum.Material.Neon,
	})
	createBillboard(pad, "2x CASH", "Game Pass", 3, 7)

	local cooldown = false
	pad.Touched:Connect(function(hit)
		local player = Players:GetPlayerFromCharacter(hit.Parent)
		if cooldown or not player or player ~= plot.owner or player:GetAttribute("CashMultiplier") == 2 then
			return
		end
		cooldown = true
		MarketplaceService:PromptGamePassPurchase(player, Config.CashX2GamePassId)
		task.delay(5, function()
			cooldown = false
		end)
	end)
	plot.passPad = pad
end

-- ============================================================
-- Création des garages (vides au démarrage)
-- ============================================================

local function createPlot(index)
	-- Les garages sont répartis en cercle, l'entrée tournée vers le centre
	local angle = (index - 1) * (2 * math.pi / Config.PlotCount)
	local position = Vector3.new(math.cos(angle), 0, math.sin(angle)) * Config.PlotDistance + Vector3.new(0, 1, 0)
	local outward = Vector3.new(position.X, 0, position.Z).Unit

	local model = Instance.new("Model")
	model.Name = "Plot" .. index
	model.Parent = plotsFolder

	local plot = {
		index = index,
		cframe = CFrame.lookAt(position, position + outward),
		model = model,
		owner = nil,
		buttons = {},
		buying = false,
	}

	plot.items = Instance.new("Folder")
	plot.items.Name = "Items"
	plot.items.Parent = model
	plot.drops = Instance.new("Folder")
	plot.drops.Name = "Drops"
	plot.drops.Parent = model

	plot.decor = Instance.new("Folder")
	plot.decor.Name = "Decor"
	plot.decor.Parent = model
	plot.carSlots = Instance.new("Folder")
	plot.carSlots.Name = "CarSlots"
	plot.carSlots.Parent = model

	plot.floor = makePart(model, {
		Name = "Floor", Size = Vector3.new(80, 1, 80), CFrame = at(plot, 0, -0.5, 0),
		Color = COLOR_FLOOR, Material = Enum.Material.Concrete,
	})

	-- Tapis roulant : une pièce ancrée avec une vitesse pousse ce qui est posé dessus
	local conveyor = makePart(model, {
		Name = "Conveyor", Size = Vector3.new(4, 1, 52), CFrame = at(plot, -25, 0.5, -2),
		Color = Color3.fromRGB(25, 25, 25), Material = Enum.Material.DiamondPlate,
	})
	conveyor.AssemblyLinearVelocity = plot.cframe:VectorToWorldSpace(Vector3.new(0, 0, -Config.ConveyorSpeed))
	for _, x in ipairs({ -27.25, -22.75 }) do
		makePart(model, {
			Name = "Rail", Size = Vector3.new(0.5, 1.5, 52), CFrame = at(plot, x, 1.25, -2),
			Color = COLOR_DARK, Material = Enum.Material.Metal,
		})
	end

	local collector = makePart(model, {
		Name = "Collector", Size = Vector3.new(6, 3, 4), CFrame = at(plot, -25, 1.5, -30),
		Color = Color3.fromRGB(0, 255, 120), Material = Enum.Material.Neon,
	})
	createBillboard(collector, "SELL", nil, 3, 5)
	collector.Touched:Connect(function(hit)
		onCollect(plot, hit)
	end)

	-- Arche d'entrée avec le nom du propriétaire
	for _, x in ipairs({ -15.5, 15.5 }) do
		makePart(model, {
			Name = "SignPost", Size = Vector3.new(1, 14, 1), CFrame = at(plot, x, 7, 40),
			Color = COLOR_DARK, Material = Enum.Material.Metal,
		})
	end
	local sign = makePart(model, {
		Name = "Sign", Size = Vector3.new(32, 5, 1), CFrame = at(plot, 0, 14.5, 40),
		Color = COLOR_DARK, Material = Enum.Material.SmoothPlastic,
	})
	local surface = Instance.new("SurfaceGui")
	surface.Face = Enum.NormalId.Back -- face tournée vers le centre de la carte
	surface.Parent = sign
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextColor3 = COLOR_GOLD
	label.Text = "Free Garage"
	label.Parent = surface
	plot.signLabel = label

	-- Route entre le centre de la carte et l'entrée du garage
	local roadEnd = Config.PlotDistance - 30 -- s'arrête au bord du marché
	local roadLength = roadEnd - 40
	makePart(model, {
		Name = "Road", Size = Vector3.new(16, 0.2, roadLength), CFrame = at(plot, 0, -0.9, 40 + roadLength / 2),
		Color = Color3.fromRGB(45, 45, 50), Material = Enum.Material.Asphalt,
	})
	for z = 44, roadEnd - 4, 8 do
		makePart(model, {
			Name = "RoadLine", Size = Vector3.new(0.6, 0.2, 3), CFrame = at(plot, 0, -0.78, z),
			Color = Color3.new(1, 1, 1), Material = Enum.Material.SmoothPlastic,
		})
	end

	return plot
end

for i = 1, Config.PlotCount do
	plots[i] = createPlot(i)
end

-- ============================================================
-- Marché de voitures (au centre de la carte)
-- Un joueur y met une de ses voitures ; les autres peuvent l'acheter moins cher
-- qu'en boutique, et le vendeur touche un bonus. Invendue = elle revient.
-- ============================================================

-- Le point de spawn du centre ne sert plus (on apparaît dans son garage) : on le cache
local centerSpawn = workspace:FindFirstChildOfClass("SpawnLocation")
if centerSpawn then
	centerSpawn.Transparency = 1
	centerSpawn.CanCollide = false
	for _, child in ipairs(centerSpawn:GetChildren()) do
		if child:IsA("Decal") then
			child:Destroy()
		end
	end
end

local marketFolder = Instance.new("Folder")
marketFolder.Name = "CarMarket"
marketFolder.Parent = workspace

makePart(marketFolder, {
	Name = "MarketFloor", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, 64, 64),
	CFrame = CFrame.new(0, 0.1, 0) * CFrame.Angles(0, 0, math.rad(90)),
	Color = Color3.fromRGB(45, 45, 50), Material = Enum.Material.Asphalt,
})
local marketSign = makePart(marketFolder, {
	Name = "MarketSign", Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(0, 14, 0),
	Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false,
})
createBillboard(marketSign, "CAR MARKET", "Buy cars from other players!", 0, 26)

local slots = {}

local function setSlotLabel(slot, title, subtitle)
	if slot.label then
		slot.label:Destroy()
	end
	slot.label = createBillboard(slot.podium, title, subtitle, 7, 10)
end

local function buyPrice(car)
	return math.floor(car.price * Config.MarketBuyerPrice)
end

local function clearSlot(slot)
	slot.listing = nil
	slot.display:ClearAllChildren()
	slot.prompt.Enabled = false
	setSlotLabel(slot, "EMPTY SPOT", "Sell a car from your garage")
end

-- Donne une voiture à quelqu'un : place libre, sinon on le rembourse
local function giveCar(owner, car)
	local data = playerData[owner]
	if not data then
		return false
	end
	local index = freeSlotIndex(data)
	if index then
		data.cars[index] = car.id
		if data.plot then
			renderSlot(data.plot, index)
		end
		return true
	end
	local cash = getCash(owner)
	if cash then
		cash.Value += car.price
	end
	return false
end

-- Rend une voiture invendue à son propriétaire
local function returnCar(slot)
	local listing = slot.listing
	clearSlot(slot)
	local seller, car = listing.seller, listing.car
	if giveCar(seller, car) then
		notify(seller, car.name .. " was not sold and is back in your garage.")
	else
		notify(seller, car.name .. " was not sold. Your garage is full: refunded $" .. formatMoney(car.price))
	end
end

local function buyCar(slot, buyer)
	local listing = slot.listing
	if not listing then
		return
	end
	local car, seller = listing.car, listing.seller
	if buyer == seller then
		returnCar(slot) -- le vendeur retire sa voiture
		return
	end
	local data = playerData[buyer]
	local cash = getCash(buyer)
	if not data or not data.plot or not cash then
		return
	end
	if not freeSlotIndex(data) then
		notify(buyer, "Your garage is full! Quick sell a car (F) or buy more parking.")
		return
	end
	local price = buyPrice(car)
	if cash.Value < price then
		notify(buyer, "Not enough cash! You need $" .. formatMoney(price))
		return
	end

	cash.Value -= price
	giveCar(buyer, car)
	clearSlot(slot)
	notify(buyer, "You bought " .. car.name .. "!")

	local sellerData = playerData[seller]
	local sellerCash = sellerData and getCash(seller)
	if sellerCash then
		local earned = math.floor(car.price * (Config.MarketSellerBonus + perkBonus(sellerData.owned, "marketBonus")))
		sellerCash.Value += earned
		notify(seller, displayName(buyer) .. " bought your " .. car.name .. "! +$" .. formatMoney(earned))
	end
end

for i = 1, Config.MarketSlots do
	local angle = (i - 0.5) * (2 * math.pi / Config.MarketSlots)
	local position = Vector3.new(math.cos(angle), 0, math.sin(angle)) * 22
	local ground = CFrame.lookAt(position + Vector3.new(0, 0.3, 0), Vector3.new(0, 0.3, 0))
	local podium, top = makePodium(marketFolder, ground, COLOR_GOLD)
	local display = Instance.new("Model")
	display.Name = "Display"
	display.Parent = marketFolder

	local prompt = Instance.new("ProximityPrompt")
	prompt.HoldDuration = 0.5
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Enabled = false
	prompt.Parent = podium

	local slot = {
		podium = podium,
		display = display,
		prompt = prompt,
		base = top,
	}
	prompt.Triggered:Connect(function(player)
		buyCar(slot, player)
	end)
	clearSlot(slot)
	slots[i] = slot
end

-- Met une voiture du garage en vente au marché
function listCar(plot, index)
	local seller = plot.owner
	local data = seller and playerData[seller]
	local car = data and data.cars[index] and carsById[data.cars[index]]
	if not car then
		return
	end
	local freeSlot = nil
	for _, slot in ipairs(slots) do
		if not slot.listing then
			freeSlot = slot
			break
		end
	end
	if not freeSlot then
		notify(seller, "The market is full, try again later!")
		return
	end

	-- La voiture quitte le garage du vendeur
	data.cars[index] = nil
	renderSlot(plot, index)

	local rarity = raritiesById[car.rarity]
	freeSlot.listing = { seller = seller, car = car, expires = os.clock() + Config.MarketDuration }
	decorateRarity(placeCar(car, freeSlot.display, freeSlot.base), car)
	freeSlot.prompt.ActionText = "Buy for $" .. formatMoney(buyPrice(car))
	freeSlot.prompt.ObjectText = car.name .. " (seller: " .. displayName(seller) .. ")"
	freeSlot.prompt.Enabled = true
	setSlotLabel(freeSlot, car.name .. " · " .. rarity.name,
		"$" .. formatMoney(buyPrice(car)) .. "  ·  " .. displayName(seller))
	local minutes = math.floor(Config.MarketDuration / 60 + 0.5)
	notify(seller, car.name .. " is on the market for " .. minutes .. " min. Sold = +$"
		.. formatMoney(math.floor(car.price * Config.MarketSellerBonus)) .. "!")
end

-- Annonces expirées : la voiture revient chez le vendeur
task.spawn(function()
	while true do
		task.wait(1)
		local now = os.clock()
		for _, slot in ipairs(slots) do
			if slot.listing and now >= slot.listing.expires then
				returnCar(slot)
			end
		end
	end
end)

-- Le vendeur quitte le jeu : ses voitures en vente lui sont rendues (avant la sauvegarde)
local function cancelListings(player)
	for _, slot in ipairs(slots) do
		if slot.listing and slot.listing.seller == player then
			local car = slot.listing.car
			clearSlot(slot)
			giveCar(player, car)
		end
	end
end

-- ============================================================
-- Tapis de livraison : un anneau autour du marché où défilent des voitures
-- de rareté aléatoire. Le premier qui l'achète la récupère !
-- ============================================================

local beltFolder = Instance.new("Folder")
beltFolder.Name = "DeliveryBelt"
beltFolder.Parent = workspace

local BELT_RADIUS = Config.DeliveryRadius or 44
local BELT_SEGMENTS = 64
for i = 1, BELT_SEGMENTS do
	local angle = (i / BELT_SEGMENTS) * 2 * math.pi
	local position = Vector3.new(math.cos(angle) * BELT_RADIUS, 0.15, math.sin(angle) * BELT_RADIUS)
	local tangent = Vector3.new(-math.sin(angle), 0, math.cos(angle))
	local length = 2 * math.pi * BELT_RADIUS / BELT_SEGMENTS + 0.3
	makePart(beltFolder, {
		Name = "Belt", Size = Vector3.new(11, 0.3, length), CFrame = CFrame.lookAt(position, position + tangent),
		Color = Color3.fromRGB(30, 30, 35), Material = Enum.Material.DiamondPlate, CastShadow = false,
	})
	for _, side in ipairs({ -5.6, 5.6 }) do
		local edge = Vector3.new(math.cos(angle) * (BELT_RADIUS + side), 0.35, math.sin(angle) * (BELT_RADIUS + side))
		makePart(beltFolder, {
			Name = "BeltEdge", Size = Vector3.new(0.3, 0.2, length), CFrame = CFrame.lookAt(edge, edge + tangent),
			Color = COLOR_GOLD, Material = Enum.Material.Neon, CastShadow = false,
		})
	end
end
local beltSign = makePart(beltFolder, {
	Name = "BeltSign", Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(BELT_RADIUS, 12, 0),
	Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false,
})
createBillboard(beltSign, "CAR DELIVERY", "Rare cars pass by... be fast!", 0, 22)

local beltCars = {} -- { car, model, root, offset, angle }

local function beltCFrame(angle)
	local position = Vector3.new(math.cos(angle) * BELT_RADIUS, 0.3, math.sin(angle) * BELT_RADIUS)
	local tangent = Vector3.new(-math.sin(angle), 0, math.cos(angle))
	return CFrame.lookAt(position, position + tangent)
end

-- Tire une rareté au hasard selon les chances (weight), puis une voiture de cette rareté
local function rollCar(rarityId)
	if not rarityId then
		local total = 0
		for _, rarity in ipairs(Config.Rarities) do
			total += rarity.weight
		end
		local pick = math.random() * total
		for _, rarity in ipairs(Config.Rarities) do
			pick -= rarity.weight
			if pick <= 0 then
				rarityId = rarity.id
				break
			end
		end
	end
	local candidates = {}
	for _, car in ipairs(Config.Cars) do
		if car.rarity == rarityId then
			table.insert(candidates, car)
		end
	end
	return candidates[math.random(#candidates)] or Config.Cars[1]
end

local function removeBeltCar(entry)
	entry.removed = true
	entry.model:Destroy()
	local position = table.find(beltCars, entry)
	if position then
		table.remove(beltCars, position)
	end
end

local function buyFromBelt(entry, buyer)
	if entry.removed then
		return
	end
	local car = entry.car
	local data = playerData[buyer]
	local cash = getCash(buyer)
	if not data or not data.plot or not cash then
		return
	end
	if not freeSlotIndex(data) then
		notify(buyer, "Your garage is full! Quick sell a car (F) or buy more parking.")
		return
	end
	if cash.Value < car.price then
		notify(buyer, "Not enough cash! " .. car.name .. " costs $" .. formatMoney(car.price))
		return
	end
	cash.Value -= car.price
	removeBeltCar(entry)
	giveCar(buyer, car)
	notify(buyer, "You got a " .. raritiesById[car.rarity].name .. " " .. car.name .. "!")
end

local function spawnBeltCar(rarityId)
	if #beltCars >= Config.DeliveryMaxCars then
		return
	end
	local car = rollCar(rarityId)
	local rarity = raritiesById[car.rarity]
	local model = Instance.new("Model")
	model.Name = "Delivery_" .. car.id
	model.Parent = beltFolder
	local start = beltCFrame(0)
	local carModel = placeCar(car, model, start, true)
	local root = carModel and carModel.PrimaryPart
	if not root then
		model:Destroy()
		return
	end
	decorateRarity(carModel, car)
	createBillboard(root, car.name, rarity.name .. "  ·  $" .. formatMoney(car.price), 6, 11, rarity.color)

	local entry = { car = car, model = model, root = root, offset = start:ToObjectSpace(root.CFrame), angle = 0 }
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Buy $" .. formatMoney(car.price)
	prompt.ObjectText = car.name .. " (" .. rarity.name .. ")"
	prompt.HoldDuration = 0.3
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt.Parent = root
	prompt.Triggered:Connect(function(player)
		buyFromBelt(entry, player)
	end)
	table.insert(beltCars, entry)

	if rarity.announce then
		for _, player in ipairs(Players:GetPlayers()) do
			notify(player, "A " .. rarity.name .. " " .. car.name .. " is on the delivery belt!")
		end
	end
end

-- Le tapis avance : on déplace seulement la pièce principale (le reste est soudé)
RunService.Heartbeat:Connect(function(dt)
	local speed = 2 * math.pi / Config.DeliveryLoopTime
	for i = #beltCars, 1, -1 do
		local entry = beltCars[i]
		entry.angle += speed * dt
		if entry.angle >= 2 * math.pi or not entry.root.Parent then
			removeBeltCar(entry)
		else
			entry.root.CFrame = beltCFrame(entry.angle) * entry.offset
		end
	end
end)

task.spawn(function()
	while true do
		task.wait(Config.DeliveryInterval)
		spawnBeltCar()
	end
end)

-- ============================================================
-- Niveau du garage : plus de rebirths = garage plus luxueux et plus grand
-- ============================================================

function applyTheme(plot)
	local tier, level = getTier(plot.owner)
	plot.floor.Color = tier.floorColor
	plot.floor.Material = tier.floorMaterial
	plot.signLabel.TextColor3 = tier.trimColor
	plot.decor:ClearAllChildren()

	local function deco(name, size, x, y, z, color, material, extra)
		local props = {
			Name = name, Size = size, CFrame = at(plot, x, y, z),
			Color = color, Material = material,
		}
		for key, value in pairs(extra or {}) do
			props[key] = value
		end
		return makePart(plot.decor, props)
	end

	-- Les murs déjà construits prennent la couleur du niveau
	for _, part in ipairs(plot.items:GetDescendants()) do
		if part:IsA("BasePart") and (part.Name == "Wall" or part.Name == "UpperWall") then
			part.Color = tier.wallColor
			part.Material = tier.wallMaterial
		end
	end

	if level >= 2 then
		-- Néons au sol tout autour du garage
		local trim = { Material = Enum.Material.Neon }
		deco("Trim", Vector3.new(80, 0.1, 0.4), 0, 0.05, -39.6, tier.trimColor, Enum.Material.Neon, trim)
		deco("Trim", Vector3.new(0.4, 0.1, 80), -39.6, 0.05, 0, tier.trimColor, Enum.Material.Neon, trim)
		deco("Trim", Vector3.new(0.4, 0.1, 80), 39.6, 0.05, 0, tier.trimColor, Enum.Material.Neon, trim)

		-- Façade derrière le garage : elle monte à chaque niveau, le bâtiment paraît plus grand
		local height = 16 + level * 8
		deco("Facade", Vector3.new(84, height, 2), 0, height / 2, -42, tier.wallColor, tier.wallMaterial)
		local crown = deco("FacadeCrown", Vector3.new(84, 1, 2.4), 0, height + 0.5, -42, tier.trimColor, Enum.Material.Neon)
		createBillboard(crown, tier.name .. " GARAGE", nil, 4, 40)
	end

	-- Lampadaires de chaque côté de l'entrée (plus nombreux à chaque niveau)
	local lampSpots = { { -22, 38 }, { 22, 38 }, { -38, 20 }, { 38, 20 }, { -38, -10 }, { 38, -10 } }
	for i = 1, math.min(tier.lamps, #lampSpots) do
		local spot = lampSpots[i]
		deco("LampPole", Vector3.new(0.6, 12, 0.6), spot[1], 6, spot[2], COLOR_DARK, Enum.Material.Metal)
		local bulb = deco("LampBulb", Vector3.new(1.6, 1.6, 1.6), spot[1], 12.5, spot[2], tier.trimColor,
			Enum.Material.Neon, { Shape = Enum.PartType.Ball })
		local light = Instance.new("PointLight")
		light.Color = tier.trimColor
		light.Range = 18
		light.Brightness = 1.5
		light.Parent = bulb
	end

	if level >= 3 then
		-- Plantes à l'entrée
		for _, x in ipairs({ -12, 12 }) do
			deco("Pot", Vector3.new(2.5, 2, 2.5), x, 1, 36, Color3.fromRGB(90, 60, 40), Enum.Material.Wood)
			deco("Plant", Vector3.new(4, 4, 4), x, 4, 36, Color3.fromRGB(40, 140, 60), Enum.Material.Grass,
				{ Shape = Enum.PartType.Ball })
		end
	end

	if level >= 4 then
		-- Tapis rouge de l'entrée
		deco("RedCarpet", Vector3.new(6, 0.1, 30), 0, 0.06, 25, Color3.fromRGB(170, 20, 30), Enum.Material.Fabric)
	end

	if level >= 5 then
		-- Paillettes sur l'enseigne
		local sparkles = Instance.new("Sparkles")
		sparkles.SparkleColor = tier.trimColor
		sparkles.Parent = plot.decor:FindFirstChild("FacadeCrown")
	end
end

-- ============================================================
-- Petite ville autour de la carte (décor)
-- ============================================================

local function buildTown()
	local town = Instance.new("Folder")
	town.Name = "Town"
	town.Parent = workspace
	local rng = Random.new(2026) -- toujours la même ville
	local function townPart(props)
		props.CastShadow = false -- décor lointain : pas d'ombres, moins de calculs
		return makePart(town, props)
	end

	-- Route circulaire
	local roadRadius, segments = Config.PlotDistance + 65, 64
	for i = 1, segments do
		local angle = (i / segments) * 2 * math.pi
		local position = Vector3.new(math.cos(angle) * roadRadius, 0.1, math.sin(angle) * roadRadius)
		local tangent = Vector3.new(-math.sin(angle), 0, math.cos(angle))
		townPart({
			Name = "RingRoad", Size = Vector3.new(14, 0.2, 2 * math.pi * roadRadius / segments + 1),
			CFrame = CFrame.lookAt(position, position + tangent),
			Color = Color3.fromRGB(45, 45, 50), Material = Enum.Material.Asphalt,
		})
	end

	-- Immeubles tournés vers le centre
	local palette = {
		Color3.fromRGB(200, 190, 175), Color3.fromRGB(150, 160, 175), Color3.fromRGB(180, 120, 100),
		Color3.fromRGB(110, 115, 125), Color3.fromRGB(225, 220, 210),
	}
	local count = 40
	for i = 1, count do
		local angle = (i / count) * 2 * math.pi + rng:NextNumber(-0.05, 0.05)
		local distance = rng:NextNumber(roadRadius + 25, roadRadius + 60)
		local width, depth, height = rng:NextNumber(18, 28), rng:NextNumber(16, 24), rng:NextNumber(22, 75)
		local ground = Vector3.new(math.cos(angle) * distance, 0, math.sin(angle) * distance)
		local facing = CFrame.lookAt(ground, Vector3.zero)
		townPart({
			Name = "Building", Size = Vector3.new(width, height, depth),
			CFrame = facing * CFrame.new(0, height / 2, 0),
			Color = palette[rng:NextInteger(1, #palette)], Material = Enum.Material.Concrete,
		})
		townPart({
			Name = "Windows", Size = Vector3.new(width * 0.8, height * 0.8, 0.3),
			CFrame = facing * CFrame.new(0, height * 0.5, -depth / 2 - 0.1),
			Color = Color3.fromRGB(120, 170, 210), Material = Enum.Material.Glass, Reflectance = 0.2,
		})
		townPart({
			Name = "Roof", Size = Vector3.new(width + 1, 1, depth + 1),
			CFrame = facing * CFrame.new(0, height + 0.5, 0),
			Color = COLOR_DARK, Material = Enum.Material.Metal,
		})
	end

	-- Arbres le long de la route
	for i = 1, 24 do
		local angle = (i / 24) * 2 * math.pi + math.pi / 24
		local position = Vector3.new(math.cos(angle) * (roadRadius + 12), 0, math.sin(angle) * (roadRadius + 12))
		townPart({
			Name = "Trunk", Size = Vector3.new(1.2, 6, 1.2), CFrame = CFrame.new(position + Vector3.new(0, 3, 0)),
			Color = Color3.fromRGB(100, 70, 45), Material = Enum.Material.Wood,
		})
		townPart({
			Name = "Leaves", Shape = Enum.PartType.Ball, Size = Vector3.new(7, 7, 7),
			CFrame = CFrame.new(position + Vector3.new(0, 8, 0)),
			Color = Color3.fromRGB(50, 130, 60), Material = Enum.Material.Grass,
		})
	end
end

-- Le sol doit être assez grand pour les garages et la ville
local baseplate = workspace:FindFirstChild("Baseplate")
if baseplate and baseplate:IsA("BasePart") then
	local size = (Config.PlotDistance + 165) * 2
	baseplate.Size = Vector3.new(size, baseplate.Size.Y, size)
end

buildTown()

local function getFreePlot()
	for _, plot in ipairs(plots) do
		if not plot.owner then
			return plot
		end
	end
	return nil
end

local function assignPlot(plot, player)
	local data = playerData[player]
	plot.owner = player
	data.plot = plot
	plot.signLabel.Text = displayName(player) .. "'s Garage"

	-- Reconstruit tout ce que le joueur avait acheté (sauvegarde)
	for _, item in ipairs(Config.Items) do
		if data.owned[item.id] then
			buildItem(plot, item)
		end
	end
	applyTheme(plot)
	renderSlots(plot)
	refreshButtons(plot)
	createGamePassPad(plot)
end

local function releasePlot(plot)
	plot.owner = nil
	plot.items:ClearAllChildren()
	plot.drops:ClearAllChildren()
	plot.carSlots:ClearAllChildren()
	for _, button in pairs(plot.buttons) do
		button:Destroy()
	end
	plot.buttons = {}
	if plot.passPad then
		plot.passPad:Destroy()
		plot.passPad = nil
	end
	if plot.rebirthButton then
		plot.rebirthButton:Destroy()
		plot.rebirthButton = nil
	end
	plot.signLabel.Text = "Free Garage"
	applyTheme(plot)
end

-- Fait (ré)apparaître le perso dans son garage
local function spawnPlayer(player)
	if not player.Parent then
		return
	end
	player:LoadCharacter() -- attend que le perso soit chargé
	local data = playerData[player]
	local character = player.Character
	if not character or not data or not data.plot then
		return
	end
	local target = at(data.plot, 0, 4, 30)
	local root = character:WaitForChild("HumanoidRootPart", 5)
	-- Roblox replace parfois le perso au point de spawn juste après :
	-- on vérifie pendant 2 secondes qu'il est bien dans son garage
	for _ = 1, 10 do
		if not root or not root.Parent then
			return
		end
		if (root.Position - target.Position).Magnitude > 15 then
			character:PivotTo(target)
		end
		task.wait(0.2)
	end
end

-- ============================================================
-- Sauvegarde
-- ============================================================

local function loadData(player)
	local startingCash = Config.StartingCash
	if RunService:IsStudio() and Config.StudioTestCash > 0 then
		startingCash = Config.StudioTestCash -- mode test : uniquement dans Studio
	end
	local data = { owned = {}, cars = {}, cash = startingCash, rebirths = 0, loaded = true }
	if not dataStore then
		return data
	end
	local ok, saved = pcall(function()
		return dataStore:GetAsync("player_" .. player.UserId)
	end)
	if not ok then
		-- On ne sauvegardera pas ce joueur, sinon on écraserait sa vraie partie
		warn("[Tycoon] Chargement impossible pour", player.Name, saved)
		data.loaded = false
	elseif type(saved) == "table" then
		data.cash = tonumber(saved.cash) or data.cash
		data.rebirths = tonumber(saved.rebirths) or 0
		if type(saved.owned) == "table" then
			for _, id in ipairs(saved.owned) do
				if itemsById[id] then
					data.owned[id] = true
				end
			end
		end
		if type(saved.cars) == "table" then
			for _, entry in ipairs(saved.cars) do
				if type(entry) == "table" and carsById[entry.car] and Config.CarSlots[entry.slot] then
					data.cars[entry.slot] = entry.car
				end
			end
		end
	end
	return data
end

local function saveData(player)
	local data = playerData[player]
	local cash = getCash(player)
	if not dataStore or not data or not data.loaded or not cash then
		return
	end
	local owned = {}
	for id in pairs(data.owned) do
		table.insert(owned, id)
	end
	local cars = {}
	for slot, carId in pairs(data.cars) do
		table.insert(cars, { slot = slot, car = carId })
	end
	local ok, err = pcall(function()
		dataStore:SetAsync("player_" .. player.UserId, {
			cash = cash.Value,
			owned = owned,
			cars = cars,
			rebirths = getRebirths(player),
		})
	end)
	if not ok then
		warn("[Tycoon] Sauvegarde impossible pour", player.Name, err)
	end
end

-- ============================================================
-- Arrivée / départ des joueurs
-- ============================================================

local freeBotPlot -- défini plus bas, dans la partie "Bots" : libère le garage d'un bot

local function onPlayerAdded(player)
	local data = loadData(player)
	if not player.Parent then
		return -- le joueur est parti pendant le chargement
	end
	playerData[player] = data

	-- "leaderstats" = le tableau des scores en haut à droite de l'écran
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	local cash = Instance.new("IntValue")
	cash.Name = "Cash"
	cash.Value = data.cash
	cash.Parent = leaderstats
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Value = data.rebirths
	rebirths.Parent = leaderstats
	leaderstats.Parent = player

	player:SetAttribute("CashMultiplier", 1)
	if Config.CashX2GamePassId ~= 0 then
		local ok, owns = pcall(function()
			return MarketplaceService:UserOwnsGamePassAsync(player.UserId, Config.CashX2GamePassId)
		end)
		if ok and owns then
			player:SetAttribute("CashMultiplier", 2)
		end
	end

	local plot = getFreePlot() or (freeBotPlot and freeBotPlot())
	if not plot then
		warn("[Tycoon] Plus de garage libre pour", player.Name)
		player:LoadCharacter()
		return
	end
	assignPlot(plot, player)
	print("[Tycoon] " .. player.Name .. " -> garage " .. plot.index)

	-- Quand le perso meurt, il réapparaît dans son garage après quelques secondes
	player.CharacterAdded:Connect(function(character)
		character:WaitForChild("Humanoid").Died:Connect(function()
			task.wait(Players.RespawnTime)
			spawnPlayer(player)
		end)
	end)
	spawnPlayer(player)
end

local function onPlayerRemoving(player)
	cancelListings(player)
	saveData(player)
	local data = playerData[player]
	if data and data.plot then
		releasePlot(data.plot)
	end
	playerData[player] = nil
end

-- ============================================================
-- Bots : faux joueurs qui jouent tout seuls (pour voir le jeu à plusieurs)
-- Ils achètent, font des rebirths et utilisent le marché comme des joueurs.
-- ============================================================

local BOT_NAMES = { "TurboMax", "NitroLina", "GearBoy", "DriftKing", "PistonPro", "RimQueen" }
local bots = {} -- [bot] = { plot, character }
local botsFolder = Instance.new("Folder")
botsFolder.Name = "Bots"
botsFolder.Parent = ServerStorage

local function createBotCharacter(bot, plot)
	local ok, character = pcall(function()
		local description = Instance.new("HumanoidDescription")
		local color = Color3.fromHSV(math.random(), 0.6, 0.9)
		description.HeadColor = Color3.fromRGB(240, 200, 160)
		description.TorsoColor = color
		description.LeftArmColor = color
		description.RightArmColor = color
		description.LeftLegColor = COLOR_DARK
		description.RightLegColor = COLOR_DARK
		return Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
	end)
	if not ok or not character or not bots[bot] then
		return nil
	end
	character.Name = bot.Name
	local state = bots[bot]
	character:FindFirstChildOfClass("Humanoid").DisplayName = bot.Name .. " [BOT · " .. state.personality.name .. "]"
	character.Parent = workspace
	character:PivotTo(at(plot, 0, 4, 30))
	local root = character:FindFirstChild("HumanoidRootPart")
	if root then
		root:SetNetworkOwner(nil)
	end
	return character
end

-- Le bot marche vers un point (abandonne au bout de quelques secondes s'il est bloqué)
-- Le bot marche vers un point en contournant les obstacles (tapis, murs, machines)
local function moveAndWait(humanoid, position, timeout)
	local arrived = false
	local connection = humanoid.MoveToFinished:Connect(function()
		arrived = true
	end)
	humanoid:MoveTo(position)
	local elapsed = 0
	while not arrived and elapsed < timeout do
		elapsed += task.wait(0.1)
	end
	connection:Disconnect()
	return arrived
end

local function botWalkTo(state, position)
	local character = state.character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root then
		return
	end
	local path = PathfindingService:CreatePath({ AgentRadius = 2, AgentHeight = 5, AgentCanJump = true })
	local ok = pcall(function()
		path:ComputeAsync(root.Position, position)
	end)
	if not ok or path.Status ~= Enum.PathStatus.Success then
		moveAndWait(humanoid, position, 6) -- pas de chemin trouvé : tout droit
		return
	end
	for _, waypoint in ipairs(path:GetWaypoints()) do
		if not humanoid.Parent then
			return
		end
		if waypoint.Action == Enum.PathWaypointAction.Jump then
			humanoid.Jump = true
		end
		if not moveAndWait(humanoid, waypoint.Position, 2) then
			moveAndWait(humanoid, position, 4) -- bloqué : on tente tout droit
			return
		end
	end
end

-- Bulle de pensée au-dessus de la tête du bot
local function setThought(state, text)
	local head = state.character and state.character:FindFirstChild("Head")
	if not head then
		return
	end
	local gui = head:FindFirstChild("Thought")
	if not gui then
		gui = Instance.new("BillboardGui")
		gui.Name = "Thought"
		gui.Size = UDim2.new(10, 0, 1.6, 0)
		gui.StudsOffset = Vector3.new(0, 3.2, 0)
		gui.MaxDistance = 70
		gui.Parent = head
		local label = Instance.new("TextLabel")
		label.Name = "Text"
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundColor3 = Color3.new(1, 1, 1)
		label.BackgroundTransparency = 0.15
		label.Font = Enum.Font.GothamMedium
		label.TextScaled = true
		label.TextColor3 = COLOR_DARK
		label.Parent = gui
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.3, 0)
		corner.Parent = label
	end
	gui.Text.Text = "💭 " .. text
end

-- Revenu estimé par seconde (machines x améliorations + voitures) : sert aux bots à réfléchir
local function estimateIncome(owner, owned, cars)
	local dropperIncome, upgrade, carIncome = 0, 1, 0
	for _, item in ipairs(Config.Items) do
		if owned[item.id] then
			if item.kind == "dropper" then
				dropperIncome += item.value / item.interval
			elseif item.kind == "upgrader" then
				upgrade *= item.multiplier
			end
		end
	end
	for _, carId in pairs(cars or {}) do
		local car = carsById[carId]
		if car then
			carIncome += car.income
		end
	end
	carIncome *= 1 + perkBonus(owned, "carIncomeBonus")
	return (dropperIncome * upgrade + carIncome) * getMultiplier(owner)
end

-- Combien d'argent par seconde rapporterait un achat (ou ce qu'il débloque)
local function incomeGain(owner, owned, item, cars)
	local with = table.clone(owned)
	with[item.id] = true
	local gain = estimateIncome(owner, with, cars) - estimateIncome(owner, owned, cars)
	if item.kind == "parking" or item.kind == "floor" then
		-- Des places en plus valent surtout quand le garage est plein
		local count, total = 0, 0
		for _, carId in pairs(cars or {}) do
			count += 1
			total += carsById[carId].income
		end
		local data = { owned = owned, cars = cars or {} }
		local full = freeSlotIndex(data) == nil
		gain = (full and math.max(total / math.max(count, 1), 5) * 2 or 2) * getMultiplier(owner)
	end
	if gain <= 0 then
		-- Pas de revenu direct (murs, étage) : on compte la moitié de ce qu'il débloque
		for _, other in ipairs(Config.Items) do
			if other.requires == item.id then
				local unlocked = table.clone(with)
				unlocked[other.id] = true
				gain += (estimateIncome(owner, unlocked, cars) - estimateIncome(owner, with, cars)) * 0.5
			end
		end
		gain = math.max(gain, 1)
	end
	return gain
end

-- Le bot liste ses options, estime le temps que chacune lui fera gagner ou perdre,
-- et choisit. Selon sa personnalité, il peut s'impatienter ou se tromper.
local function botBrain(bot, state)
	local personality = state.personality
	while bots[bot] do
		task.wait(math.random(20, 40) / 10)
		local plot = state.plot
		local data = playerData[bot]
		local cash = getCash(bot)
		if not bots[bot] or not data or not cash then
			break
		end
		local income = math.max(estimateIncome(bot, data.owned, data.cars), 1)

		-- 1) Lister les options
		local options = {}
		for _, item in ipairs(Config.Items) do
			if plot.buttons[item.id] then
				local gain = incomeGain(bot, data.owned, item, data.cars)
				local wait = math.max(0, item.price - cash.Value) / income
				-- temps total = temps pour réunir l'argent + temps pour le rembourser
				table.insert(options, { kind = "buy", item = item, wait = wait, score = wait + item.price / gain })
			end
		end
		-- Voitures : sur le tapis de livraison et au marché
		local hasFreeSlot = freeSlotIndex(data) ~= nil
		local worstSlot, worstIncome = worstCarSlot(data)
		local multiplier = getMultiplier(bot)
		local function considerCar(kind, car, price, extra)
			-- Garage plein : intéressant seulement si elle rapporte plus que la pire voiture
			local gain = car.income - (hasFreeSlot and 0 or worstIncome)
			if gain <= 0 then
				return
			end
			local wait = math.max(0, price - cash.Value) / income
			local option = { kind = kind, item = car, wait = wait, score = wait + price / (gain * multiplier) }
			for key, value in pairs(extra) do
				option[key] = value
			end
			table.insert(options, option)
		end
		local speed = 2 * math.pi / Config.DeliveryLoopTime
		for _, entry in ipairs(beltCars) do
			local timeLeft = (2 * math.pi - entry.angle) / speed
			-- Inutile d'économiser pour une voiture qui aura quitté le tapis avant
			if math.max(0, entry.car.price - cash.Value) / income < timeLeft then
				considerCar("belt", entry.car, entry.car.price, { entry = entry })
			end
		end
		for _, slot in ipairs(slots) do
			local listing = slot.listing
			if listing and listing.seller ~= bot then
				considerCar("market", listing.car, buyPrice(listing.car), { slot = slot })
			end
		end
		if plot.rebirthButton then
			local wait = math.max(0, getRebirthCost(bot) - cash.Value) / income
			table.insert(options, { kind = "rebirth", wait = wait, score = wait * 0.5 })
		end

		-- 2) Choisir : la meilleure option... sauf erreur ou impatience
		table.sort(options, function(a, b)
			return a.score < b.score
		end)
		local choice = options[1]
		local reason = nil
		if #options > 1 and math.random() > personality.smartness then
			choice = options[math.random(2, #options)]
			reason = "I have a feeling about this one..."
		elseif choice and choice.wait > personality.patience then
			-- Trop long à attendre : il prend ce qu'il peut s'offrir tout de suite (souvent moins rentable)
			for _, option in ipairs(options) do
				if option.wait == 0 then
					choice = option
					reason = "Too long to wait, I'll take this now!"
					break
				end
			end
		end

		-- 3) Agir
		if not choice then
			setThought(state, "Nothing to do... chilling")
			botWalkTo(state, at(plot, math.random(-15, 20), 3, math.random(-5, 32)).Position)
		elseif choice.wait > 0 then
			local name = choice.kind == "rebirth" and "a Rebirth" or choice.item.name
			setThought(state, string.format("Saving for %s... %d%%", name,
				math.floor(cash.Value / (cash.Value + choice.wait * income) * 100)))
			botWalkTo(state, at(plot, math.random(-15, 20), 3, math.random(-5, 32)).Position)
		elseif choice.kind == "buy" then
			setThought(state, reason or ("Buying " .. choice.item.name .. ", best deal!"))
			botWalkTo(state, at(plot, choice.item.button.X, 3, choice.item.button.Z).Position)
			if bots[bot] then
				purchase(plot, bot, choice.item)
			end
		elseif choice.kind == "belt" or choice.kind == "market" then
			if not freeSlotIndex(data) and worstSlot then
				quickSell(plot, worstSlot) -- fait de la place pour une meilleure voiture
			end
			if choice.kind == "belt" then
				local rarity = raritiesById[choice.item.rarity]
				setThought(state, reason or ("A " .. rarity.name .. " " .. choice.item.name .. "? I want it!"))
				buyFromBelt(choice.entry, bot)
			else
				setThought(state, reason or ("Cheap " .. choice.item.name .. " at the market!"))
				buyCar(choice.slot, bot)
			end
		elseif choice.kind == "rebirth" then
			setThought(state, "Rebirth time! My garage will level up!")
			botWalkTo(state, at(plot, Config.RebirthButton.X, 3, Config.RebirthButton.Z).Position)
			if bots[bot] then
				performRebirth(plot, bot)
			end
		end

		-- 4) Les commerçants mettent parfois une voiture en vente (une seule à la fois)
		local hasListing = false
		for _, slot in ipairs(slots) do
			if slot.listing and slot.listing.seller == bot then
				hasListing = true
			end
		end
		if not hasListing and os.clock() > (state.nextTrade or 0) and math.random() < personality.trading then
			local count = 0
			for _ in pairs(data.cars) do
				count += 1
			end
			local sellSlot = worstCarSlot(data) -- recalculé : il a pu vendre une voiture juste avant
			if count >= 3 and sellSlot then
				-- il vend sa moins bonne voiture et garde les meilleures
				setThought(state, "Selling my " .. carsById[data.cars[sellSlot]].name .. " for +50% profit!")
				listCar(plot, sellSlot)
				state.nextTrade = os.clock() + Config.BotTradeCooldown
			end
		end
	end
end

local function createBot(plot)
	local used = {}
	for bot in pairs(bots) do
		used[bot.Name] = true
	end
	local name = "Bot"
	for _, candidate in ipairs(BOT_NAMES) do
		if not used[candidate] then
			name = candidate
			break
		end
	end

	-- Un bot est un simple dossier qui imite un joueur (leaderstats, attributs)
	local bot = Instance.new("Folder")
	bot.Name = name
	bot:SetAttribute("IsBot", true)
	bot:SetAttribute("CashMultiplier", 1)
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	leaderstats.Parent = bot
	local cash = Instance.new("IntValue")
	cash.Name = "Cash"
	cash.Parent = leaderstats
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Parent = leaderstats
	bot.Parent = botsFolder

	playerData[bot] = { owned = {}, cars = {}, cash = 0, rebirths = 0, loaded = false }
	local personality = Config.BotPersonalities[math.random(#Config.BotPersonalities)]
	local state = { plot = plot, personality = personality }
	bots[bot] = state
	assignPlot(plot, bot)
	task.spawn(function()
		state.character = createBotCharacter(bot, plot)
	end)
	task.spawn(botBrain, bot, state)
	return bot
end

local function removeBot(bot)
	local state = bots[bot]
	if not state then
		return
	end
	bots[bot] = nil
	cancelListings(bot)
	if state.character then
		state.character:Destroy()
	end
	releasePlot(state.plot)
	playerData[bot] = nil
	bot:Destroy()
end

-- Un vrai joueur arrive et tous les garages sont pris : un bot lui laisse sa place
freeBotPlot = function()
	for bot, state in pairs(bots) do
		local plot = state.plot
		removeBot(bot)
		return plot
	end
	return nil
end

if Config.BotsEnabled and (RunService:IsStudio() or not Config.BotsOnlyInStudio) then
	task.delay(3, function()
		for _ = 1, Config.BotCount do
			local plot = getFreePlot()
			if plot then
				createBot(plot)
			end
		end
	end)
end

MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
	if purchased and passId == Config.CashX2GamePassId then
		player:SetAttribute("CashMultiplier", 2)
		local data = playerData[player]
		if data and data.plot and data.plot.passPad then
			data.plot.passPad:Destroy()
			data.plot.passPad = nil
		end
	end
end)

-- ============================================================
-- Commandes de test dans le chat (uniquement dans Studio) :
--   /cash 250000  -> te donne de l'argent
--   /rebirths 3   -> règle ton nombre de rebirths (pour voir les niveaux du garage)
-- ============================================================

local function onTestCommand(player, message)
	if not RunService:IsStudio() then
		return
	end
	local command, amount = message:match("^%s*/(%a+)%s+(%d+)")
	amount = tonumber(amount)
	if not command or not amount then
		return
	end
	local stats = player:FindFirstChild("leaderstats")
	if command == "cash" and stats then
		stats.Cash.Value = amount
		notify(player, "Test: cash set to $" .. formatMoney(amount))
	elseif command == "deliver" then
		local rarity = Config.Rarities[amount]
		if rarity then
			spawnBeltCar(rarity.id)
			notify(player, "Test: a " .. rarity.name .. " car is on the delivery belt")
		end
	elseif command == "rebirths" and stats then
		stats.Rebirths.Value = amount
		local data = playerData[player]
		if data and data.plot then
			applyTheme(data.plot)
		end
		notify(player, "Test: " .. amount .. " rebirths, garage level " .. getTier(player).name)
	end
end

-- Panneau de test à l'écran (boutons, Studio uniquement)
if RunService:IsStudio() then
	local testEvent = Instance.new("RemoteEvent")
	testEvent.Name = "TestCommand"
	testEvent.Parent = ReplicatedStorage
	testEvent.OnServerEvent:Connect(function(player, command, amount)
		if typeof(command) ~= "string" or typeof(amount) ~= "number" then
			return
		end
		if command == "addcash" then
			local cash = getCash(player)
			if cash then
				amount = cash.Value + amount
			end
			command = "cash"
		elseif command == "addrebirth" then
			amount = getRebirths(player) + amount
			command = "rebirths"
		end
		onTestCommand(player, "/" .. command .. " " .. math.floor(amount))
	end)
end

-- Nouveau chat Roblox (TextChatService) : commandes officielles, invisibles pour les autres
local TextChatService = game:GetService("TextChatService")
if RunService:IsStudio() then
	for _, name in ipairs({ "cash", "rebirths" }) do
		local command = Instance.new("TextChatCommand")
		command.Name = "Test_" .. name
		command.PrimaryAlias = "/" .. name
		command.Parent = TextChatService
		command.Triggered:Connect(function(source, text)
			local player = Players:GetPlayerByUserId(source.UserId)
			if player then
				onTestCommand(player, text)
			end
		end)
	end
end

-- Ancien chat Roblox : on lit les messages directement
local function listenChat(player)
	player.Chatted:Connect(function(message)
		if TextChatService.ChatVersion ~= Enum.ChatVersion.TextChatService then
			onTestCommand(player, message)
		end
	end)
end
Players.PlayerAdded:Connect(listenChat)
for _, player in ipairs(Players:GetPlayers()) do
	listenChat(player)
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
-- Joueurs déjà connectés avant que ce script démarre (arrive dans Studio)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end

-- Sauvegarde quand le serveur s'éteint
game:BindToClose(function()
	for _, player in ipairs(Players:GetPlayers()) do
		saveData(player)
	end
end)

-- Revenus des voitures : chaque voiture du showroom rapporte de l'argent chaque seconde
task.spawn(function()
	while true do
		task.wait(1)
		for _, plot in ipairs(plots) do
			local owner = plot.owner
			local data = owner and playerData[owner]
			local cash = owner and getCash(owner)
			if data and cash then
				local income = 0
				for _, carId in pairs(data.cars) do
					local car = carsById[carId]
					if car then
						income += car.income
					end
				end
				income *= 1 + perkBonus(data.owned, "carIncomeBonus")
				if income > 0 then
					cash.Value += math.floor(income * getMultiplier(owner) + 0.5)
				end
			end
		end
	end
end)

-- Sauvegarde automatique régulière (au cas où le serveur plante)
task.spawn(function()
	while true do
		task.wait(Config.AutosaveInterval)
		for _, player in ipairs(Players:GetPlayers()) do
			saveData(player)
		end
	end
end)
