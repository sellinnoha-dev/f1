	for _, x in ipairs({ -27.25, -22.75 }) do
		makePart(model, {
			Name = "Rail", Size = Vector3.new(0.5, 1.5, 52), CFrame = at(plot, x, 1.25, -2),
			Color = COLOR_DARK, Material = Enum.Material.Metal,
		})
	end

	local collector = makePart(model, {
		Name = "Collector", Size = Vector3.new(6, 3, 4), CFrame = at(plot, -25, 1.5, -30),
		Color = Color3.fromRGB(0, 255, 120), Material = Enum.Material.Neon,
	})
	createBillboard(collector, "SELL", nil, 3, 5)
	collector.Touched:Connect(function(hit)
		onCollect(plot, hit)
	end)

	-- Arche d'entrée avec le nom du propriétaire
	for _, x in ipairs({ -15.5, 15.5 }) do
		makePart(model, {
			Name = "SignPost", Size = Vector3.new(1, 14, 1), CFrame = at(plot, x, 7, 40),
			Color = COLOR_DARK, Material = Enum.Material.Metal,
		})
	end
	local sign = makePart(model, {
		Name = "Sign", Size = Vector3.new(32, 5, 1), CFrame = at(plot, 0, 14.5, 40),
		Color = COLOR_DARK, Material = Enum.Material.SmoothPlastic,
	})
	local surface = Instance.new("SurfaceGui")
	surface.Face = Enum.NormalId.Back -- face tournée vers le centre de la carte
	surface.Parent = sign
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextColor3 = COLOR_GOLD
	label.Text = "Free Garage"
	label.Parent = surface
	plot.signLabel = label

	-- Bouclier anti-voleurs (invisible tant que le garage n'est pas verrouillé)
	plot.shield = {}
	local shieldWalls = {
		{ Vector3.new(84, 30, 1), Vector3.new(0, 15, 41.5) },
		{ Vector3.new(84, 30, 1), Vector3.new(0, 15, -43.5) },
		{ Vector3.new(1, 30, 86), Vector3.new(-41.5, 15, -1) },
		{ Vector3.new(1, 30, 86), Vector3.new(41.5, 15, -1) },
	}
	for _, wall in ipairs(shieldWalls) do
		local part = makePart(model, {
			Name = "Shield", Size = wall[1], CFrame = at(plot, wall[2].X, wall[2].Y, wall[2].Z),
			Color = Color3.fromRGB(255, 40, 60), Material = Enum.Material.ForceField,
			Transparency = 1, CanCollide = false, CanQuery = false, CastShadow = false,
		})
		table.insert(plot.shield, part)
	end
	plot.lockedUntil = 0
	plot.lockReadyAt = 0

	-- Barrière laser à l'entrée (visible quand le garage est verrouillé)
	plot.lasers = {}
	for _, height in ipairs({ 1.5, 3.5, 5.5, 7.5, 9.5, 11.5 }) do
		local beam = makePart(model, {
			Name = "Laser", Size = Vector3.new(30, 0.2, 0.2), CFrame = at(plot, 0, height, 40),
			Color = Color3.fromRGB(255, 30, 50), Material = Enum.Material.Neon,
			Transparency = 1, CanCollide = false, CanQuery = false, CastShadow = false,
		})
		table.insert(plot.lasers, beam)
		for _, x in ipairs({ -15, 15 }) do
			makePart(model, {
				Name = "LaserEmitter", Size = Vector3.new(0.8, 0.5, 0.8), CFrame = at(plot, x, height, 40),
				Color = COLOR_DARK, Material = Enum.Material.Metal,
			})
		end
	end
	-- Gyrophares en haut des poteaux : verts = ouvert, rouges = verrouillé
	plot.beacons = {}
	for _, x in ipairs({ -15.5, 15.5 }) do
		local beacon = makePart(model, {
			Name = "Beacon", Shape = Enum.PartType.Ball, Size = Vector3.new(1.6, 1.6, 1.6),
			CFrame = at(plot, x, 18, 40), Color = Color3.fromRGB(0, 255, 120), Material = Enum.Material.Neon,
		})
		local light = Instance.new("PointLight")
		light.Range = 14
		light.Color = beacon.Color
		light.Parent = beacon
		table.insert(plot.beacons, beacon)
	end

	-- Console de sécurité : socle, écran incliné et gros bouton (touche E)
	makePart(model, {
		Name = "ConsoleBase", Size = Vector3.new(3, 3.2, 2), CFrame = at(plot, 10, 1.6, 34),
		Color = COLOR_DARK, Material = Enum.Material.DiamondPlate,
	})
	plot.consoleScreen = makePart(model, {
		Name = "ConsoleScreen", Size = Vector3.new(2.6, 1.6, 0.2),
		CFrame = at(plot, 10, 3.6, 34.6) * CFrame.Angles(math.rad(-25), 0, 0),
		Color = Color3.fromRGB(0, 255, 120), Material = Enum.Material.Neon,
	})
	local lockButton = makePart(model, {
		Name = "LockButton", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, 1.2, 1.2),
		CFrame = at(plot, 10, 3.4, 33.6) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(255, 30, 50), Material = Enum.Material.Neon,
	})
	plot.lockLabel = createBillboard(lockButton, "SECURITY", "Ready", 3, 8)
	plot.lockPrompt = Instance.new("ProximityPrompt")
	plot.lockPrompt.ActionText = "Lock Garage"
	plot.lockPrompt.ObjectText = "Shield " .. Config.LockDuration .. "s"
	plot.lockPrompt.HoldDuration = 0.5
	plot.lockPrompt.MaxActivationDistance = 10
	plot.lockPrompt.RequiresLineOfSight = false
	plot.lockPrompt:SetAttribute("OwnerId", 0)
	CollectionService:AddTag(plot.lockPrompt, "OwnerOnly")
	plot.lockPrompt.Parent = lockButton

	-- Grand panneau au-dessus de l'entrée : état du garage, visible de loin
	local status = makePart(model, {
		Name = "StatusAnchor", Size = Vector3.new(1, 1, 1), CFrame = at(plot, 0, 24, 40),
		Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false,
	})
	plot.statusGui = createBillboard(status, "OPEN", "", 0, 22, Color3.fromRGB(0, 255, 120))
	plot.statusGui.MaxDistance = 400

	-- Toit en verre (avec les murs) : reconstruit selon ce qui est acheté
	plot.roof = Instance.new("Folder")
	plot.roof.Name = "Roof"
	plot.roof.Parent = model

	-- Route entre le centre de la carte et l'entrée du garage
	local roadEnd = Config.PlotDistance - 30 -- s'arrête au bord du marché
	local roadLength = roadEnd - 40
	makePart(model, {
		Name = "Road", Size = Vector3.new(16, 0.2, roadLength), CFrame = at(plot, 0, -0.9, 40 + roadLength / 2),
		Color = Color3.fromRGB(45, 45, 50), Material = Enum.Material.Asphalt,
	})
	for z = 44, roadEnd - 4, 8 do
		makePart(model, {
			Name = "RoadLine", Size = Vector3.new(0.6, 0.2, 3), CFrame = at(plot, 0, -0.78, z),
			Color = Color3.new(1, 1, 1), Material = Enum.Material.SmoothPlastic,
		})
	end

	return plot
end

for i = 1, Config.PlotCount do
	plots[i] = createPlot(i)
end

-- ============================================================
-- Marché de voitures (au centre de la carte)
-- Un joueur y met une de ses voitures ; les autres peuvent l'acheter moins cher
-- qu'en boutique, et le vendeur touche un bonus. Invendue = elle revient.
-- ============================================================

-- Le point de spawn du centre ne sert plus (on apparaît dans son garage) : on le cache
local centerSpawn = workspace:FindFirstChildOfClass("SpawnLocation")
if centerSpawn then
	centerSpawn.Transparency = 1
	centerSpawn.CanCollide = false
	for _, child in ipairs(centerSpawn:GetChildren()) do
		if child:IsA("Decal") then
			child:Destroy()
		end
	end
end

local marketFolder = Instance.new("Folder")
marketFolder.Name = "CarMarket"
marketFolder.Parent = workspace

makePart(marketFolder, {
	Name = "MarketFloor", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, 64, 64),
	CFrame = CFrame.new(0, 0.1, 0) * CFrame.Angles(0, 0, math.rad(90)),
	Color = Color3.fromRGB(45, 45, 50), Material = Enum.Material.Asphalt,
})
local marketSign = makePart(marketFolder, {
	Name = "MarketSign", Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(0, 14, 0),
	Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false,
})
createBillboard(marketSign, "CAR MARKET", "Buy cars from other players!", 0, 26)

local slots = {}

local function setSlotLabel(slot, title, subtitle)
	if slot.label then
		slot.label:Destroy()
	end
	slot.label = createBillboard(slot.podium, title, subtitle, 7, 10)
end

local function buyPrice(entry)
	return math.floor(carValue(entry) * Config.MarketBuyerPrice)
end

local function clearSlot(slot)
	slot.listing = nil
	slot.display:ClearAllChildren()
	slot.prompt.Enabled = false
	setSlotLabel(slot, "EMPTY SPOT", "Sell a car from your garage")
end

-- Donne une voiture à quelqu'un : place libre, sinon on le rembourse
local function giveCar(owner, entry)
	local data = playerData[owner]
	if not data then
		return false
	end
	local index = freeSlotIndex(data)
	if index then
		data.cars[index] = entry
		if data.plot then
			renderSlot(data.plot, index)
		end
		return true
	end
	local cash = getCash(owner)
	if cash then
		cash.Value += carValue(entry)
	end
	return false
end

-- Rend une voiture invendue à son propriétaire
local function returnCar(slot)
	local listing = slot.listing
	clearSlot(slot)
	local seller, entry = listing.seller, listing.entry
	local car = carDef(entry)
	if giveCar(seller, entry) then
		notify(seller, car.name .. " was not sold and is back in your garage.")
	else
		notify(seller, car.name .. " was not sold. Your garage is full: refunded $" .. formatMoney(carValue(entry)))
	end
end

local function buyCar(slot, buyer)
	local listing = slot.listing
	if not listing then
		return
	end
	local entry, seller = listing.entry, listing.seller
	local car = carDef(entry)
	if buyer == seller then
		returnCar(slot) -- le vendeur retire sa voiture
		return
	end
	local data = playerData[buyer]
	local cash = getCash(buyer)
	if not data or not data.plot or not cash then
		return
	end
	if not freeSlotIndex(data) then
		notify(buyer, "Your garage is full! Quick sell a car (F) or buy more parking.")
		return
	end
	local price = buyPrice(entry)
	if cash.Value < price then
		notify(buyer, "Not enough cash! You need $" .. formatMoney(price))
		return
	end

	cash.Value -= price
	giveCar(buyer, entry)
	clearSlot(slot)
	notify(buyer, "You bought " .. car.name .. "!")

	local sellerData = playerData[seller]
	local sellerCash = sellerData and getCash(seller)
	if sellerCash then
		local earned = math.floor(carValue(entry) * (Config.MarketSellerBonus + perkBonus(sellerData.owned, "marketBonus")))
		sellerCash.Value += earned
		notify(seller, displayName(buyer) .. " bought your " .. car.name .. "! +$" .. formatMoney(earned))
	end
end

for i = 1, Config.MarketSlots do
	local angle = (i - 0.5) * (2 * math.pi / Config.MarketSlots)
	local position = Vector3.new(math.cos(angle), 0, math.sin(angle)) * 22
	local ground = CFrame.lookAt(position + Vector3.new(0, 0.3, 0), Vector3.new(0, 0.3, 0))
	local podium, top = makePodium(marketFolder, ground, COLOR_GOLD)
	local display = Instance.new("Model")
	display.Name = "Display"
	display.Parent = marketFolder

	local prompt = Instance.new("ProximityPrompt")
	prompt.HoldDuration = 0.5
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Enabled = false
	prompt.Parent = podium

	local slot = {
		podium = podium,
		display = display,
		prompt = prompt,
		base = top,
	}
	prompt.Triggered:Connect(function(player)
		buyCar(slot, player)
	end)
	clearSlot(slot)
	slots[i] = slot
end

-- Met une voiture du garage en vente au marché
function listCar(plot, index)
	local seller = plot.owner
	local data = seller and playerData[seller]
	local entry = data and data.cars[index]
	local car = carDef(entry)
	if not car then
		return
	end
	local freeSlot = nil
	for _, slot in ipairs(slots) do
		if not slot.listing then
			freeSlot = slot
			break
		end
	end
	if not freeSlot then
		notify(seller, "The market is full, try again later!")
		return
	end

	-- La voiture quitte le garage du vendeur
	data.cars[index] = nil
	renderSlot(plot, index)

	local rarity = raritiesById[car.rarity]
	freeSlot.listing = { seller = seller, entry = entry, expires = os.clock() + Config.MarketDuration }
	local listedModel = placeCar(car, freeSlot.display, freeSlot.base)
	if isWreck(entry) then
		makeRusty(listedModel)
	else
		decorateRarity(listedModel, car)
	end
	local label = (isWreck(entry) and "Wreck: " or "") .. car.name
	freeSlot.prompt.ActionText = "Buy for $" .. formatMoney(buyPrice(entry))
	freeSlot.prompt.ObjectText = label .. " (seller: " .. displayName(seller) .. ")"
	freeSlot.prompt.Enabled = true
	setSlotLabel(freeSlot, label .. " · " .. rarity.name,
		"$" .. formatMoney(buyPrice(entry)) .. "  ·  " .. displayName(seller))
	local minutes = math.floor(Config.MarketDuration / 60 + 0.5)
	notify(seller, car.name .. " is on the market for " .. minutes .. " min. Sold = +$"
		.. formatMoney(math.floor(carValue(entry) * Config.MarketSellerBonus)) .. "!")
end

-- Annonces expirées : la voiture revient chez le vendeur
task.spawn(function()
	while true do
		task.wait(1)
		local now = os.clock()
		for _, slot in ipairs(slots) do
			if slot.listing and now >= slot.listing.expires then
				returnCar(slot)
			end
		end
	end
end)

-- Le vendeur quitte le jeu : ses voitures en vente lui sont rendues (avant la sauvegarde)
local function cancelListings(player)
	for _, slot in ipairs(slots) do
		if slot.listing and slot.listing.seller == player then
			local entry = slot.listing.entry
			clearSlot(slot)
			giveCar(player, entry)
		end
	end
end

-- ============================================================
-- Livraison par camion : il arrive par l'autoroute (au bord de la carte),
-- dépose des épaves sur le parking de livraison, puis repart.
-- Le premier qui achète une épave la ramène dans son garage pour la restaurer.
-- ============================================================

local deliveryFolder = Instance.new("Folder")
deliveryFolder.Name = "Delivery"
deliveryFolder.Parent = workspace

local ROAD_ANGLE = math.rad(Config.RoadAngle or 22.5)
local ROAD_DIR = Vector3.new(math.cos(ROAD_ANGLE), 0, math.sin(ROAD_ANGLE)) -- du centre vers l'extérieur
local ROAD_SIDE = Vector3.new(-ROAD_DIR.Z, 0, ROAD_DIR.X)
local ROAD_START, ROAD_END = 50, Config.PlotDistance + 160 -- l'autoroute va du parking au bord de la carte
local TRUCK_STOP = 97 -- le camion s'arrête ici (le long du parking)

local function roadPoint(distance, lateral, height)
	return ROAD_DIR * distance + ROAD_SIDE * (lateral or 0) + Vector3.new(0, height or 0, 0)
end

-- Autoroute : asphalte, lignes blanches, bandes jaunes
do
	local length = ROAD_END - ROAD_START
	local middle = roadPoint(ROAD_START + length / 2, 0, 0.12)
	makePart(deliveryFolder, {
		Name = "Highway", Size = Vector3.new(20, 0.2, length),
		CFrame = CFrame.lookAt(middle, middle + ROAD_DIR),
		Color = Color3.fromRGB(40, 40, 45), Material = Enum.Material.Asphalt, CastShadow = false,
	})
	for distance = ROAD_START + 4, ROAD_END - 4, 10 do
		local point = roadPoint(distance, 0, 0.25)
		makePart(deliveryFolder, {
			Name = "RoadLine", Size = Vector3.new(0.6, 0.1, 4), CFrame = CFrame.lookAt(point, point + ROAD_DIR),
			Color = Color3.new(1, 1, 1), Material = Enum.Material.SmoothPlastic, CastShadow = false,
		})
	end
	for _, side in ipairs({ -9.4, 9.4 }) do
		local point = roadPoint(ROAD_START + length / 2, side, 0.25)
		makePart(deliveryFolder, {
			Name = "RoadEdge", Size = Vector3.new(0.4, 0.1, length), CFrame = CFrame.lookAt(point, point + ROAD_DIR),
			Color = COLOR_GOLD, Material = Enum.Material.Neon, CastShadow = false,
		})
	end
	-- Portique d'entrée de la carte : c'est par là que le camion arrive
	local gate = roadPoint(ROAD_END - 20, 0, 0)
	local facing = CFrame.lookAt(gate, gate - ROAD_DIR)
	for _, side in ipairs({ -12, 12 }) do
		makePart(deliveryFolder, {
			Name = "GatePost", Size = Vector3.new(1.5, 16, 1.5), CFrame = facing * CFrame.new(side, 8, 0),
			Color = COLOR_DARK, Material = Enum.Material.Metal,
		})
	end
	local beam = makePart(deliveryFolder, {
		Name = "GateBeam", Size = Vector3.new(26, 3, 1), CFrame = facing * CFrame.new(0, 16, 0),
		Color = Color3.fromRGB(30, 110, 60), Material = Enum.Material.SmoothPlastic,
	})
	createBillboard(beam, "HIGHWAY", "Wreck deliveries arrive here", 3, 16)
end

-- Parking de livraison : 2 rangées de places le long de l'autoroute
local lotSpots = {}
do
	local perRow = math.ceil(Config.LotSpots / 2)
	for i = 1, Config.LotSpots do
		local row = (i - 1) % perRow
		local side = (i <= perRow) and -1 or 1
		local distance = 76 + row * 14
		local ground = roadPoint(distance, side * 14.5, 0.2)
		local base = CFrame.lookAt(ground, ground + ROAD_DIR)
		makePart(deliveryFolder, {
			Name = "LotSpot", Size = Vector3.new(8, 0.2, 13.5), CFrame = base,
			Color = Color3.fromRGB(55, 55, 60), Material = Enum.Material.Asphalt, CastShadow = false,
		})
		for _, x in ipairs({ -4, 4 }) do
			makePart(deliveryFolder, {
				Name = "SpotLine", Size = Vector3.new(0.3, 0.1, 13.5), CFrame = base * CFrame.new(x, 0.12, 0),
				Color = Color3.new(1, 1, 1), Material = Enum.Material.SmoothPlastic, CastShadow = false,
			})
		end
		lotSpots[i] = { base = base * CFrame.new(0, 0.1, 0) }
	end
end

-- Panneau : compte à rebours jusqu'au prochain camion
local lotSignPart = makePart(deliveryFolder, {
	Name = "LotSign", Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(roadPoint(97, 0, 18)),
	Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false,
})
local lotSign = createBillboard(lotSignPart, "WRECK DELIVERY", "Truck incoming...", 0, 24)
lotSign.MaxDistance = 250
local lotSubtitle
for _, label in ipairs(lotSign:GetChildren()) do
	if label:IsA("TextLabel") and label.Text == "Truck incoming..." then
		lotSubtitle = label
	end
end

local lotCars = {} -- { car, model, root, spot, expires }

-- Tire une rareté au hasard selon les chances (weight), puis une voiture de cette rareté
local function rollCar(rarityId)
	if not rarityId then
		local total = 0
		for _, rarity in ipairs(Config.Rarities) do
			total += rarity.weight
		end
		local pick = math.random() * total
		for _, rarity in ipairs(Config.Rarities) do
			pick -= rarity.weight
			if pick <= 0 then
				rarityId = rarity.id
				break
			end
		end
	end
	-- Aucune voiture de cette rareté ? On descend à la rareté en dessous
	local startIndex = 1
	for i, rarity in ipairs(Config.Rarities) do
		if rarity.id == rarityId then
			startIndex = i
		end
	end
	for i = startIndex, 1, -1 do
		local candidates = {}
		for _, car in ipairs(Config.Cars) do
			if car.rarity == Config.Rarities[i].id then
				table.insert(candidates, car)
			end
		end
		if #candidates > 0 then
			return candidates[math.random(#candidates)]
		end
	end
	return Config.Cars[math.random(#Config.Cars)]
end

local function wreckPrice(car)
	return math.floor(car.price * Config.WreckPriceRatio)
end

local function removeLotCar(entry)
	entry.removed = true
	entry.model:Destroy()
	entry.spot.entry = nil
	local position = table.find(lotCars, entry)
	if position then
		table.remove(lotCars, position)
	end
end

local function buyFromLot(entry, buyer)
	if entry.removed or not entry.forSale then
		return
	end
	local car = entry.car
	local data = playerData[buyer]
	local cash = getCash(buyer)
	if not data or not data.plot or not cash then
		return
	end
	if not freeSlotIndex(data) then
		notify(buyer, "Your garage is full! Quick sell a car (F) or buy more parking.")
		return
	end
	local price = wreckPrice(car)
	if cash.Value < price then
		notify(buyer, "Not enough cash! This wreck costs $" .. formatMoney(price))
		return
	end
	cash.Value -= price
	removeLotCar(entry)
	giveCar(buyer, newWreck(car))
	notify(buyer, "You bought a " .. raritiesById[car.rarity].name .. " " .. car.name
		.. " wreck! Repair it in your garage: " .. needsText(Config.RepairParts[car.rarity] or {}))
end

-- Crée une épave (modèle rouillé + étiquette + bouton d'achat) à un endroit donné
local function makeLotCar(car, cframe)
	local rarity = raritiesById[car.rarity]
	local model = Instance.new("Model")
	model.Name = "Wreck_" .. car.id
	model.Parent = deliveryFolder
	local carModel = placeCar(car, model, cframe, true)
	local root = carModel and carModel.PrimaryPart
	if not root then
		model:Destroy()
		return nil
	end
	makeRusty(carModel)
	local entry = { car = car, model = model, root = root, offset = cframe:ToObjectSpace(root.CFrame) }
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Buy wreck $" .. formatMoney(wreckPrice(car))
	prompt.ObjectText = car.name .. " (" .. rarity.name .. ")"
	prompt.HoldDuration = 0.3
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt.Enabled = false
	prompt.Parent = root
	prompt.Triggered:Connect(function(player)
		buyFromLot(entry, player)
	end)
	entry.prompt = prompt
	return entry
end

local function setForSale(entry)
	local car = entry.car
	local rarity = raritiesById[car.rarity]
	entry.forSale = true
	entry.expires = os.clock() + Config.LotStay
	entry.prompt.Enabled = true
	createBillboard(entry.root, car.name .. " (wreck)",
		rarity.name .. "  ·  $" .. formatMoney(wreckPrice(car)) .. "  ·  worth $" .. formatMoney(car.price),
		6, 13, rarity.color)
	table.insert(lotCars, entry)
end

-- Le camion : cabine + remorque porte-voitures à 2 étages, tout soudé à une pièce racine
local function buildTruck()
	local truck = Instance.new("Model")
	truck.Name = "DeliveryTruck"
	truck.Parent = deliveryFolder
	local root = makePart(truck, {
		Name = "Chassis", Size = Vector3.new(8, 1, 46), CFrame = CFrame.new(0, 2, 0),
		Color = COLOR_DARK, Material = Enum.Material.Metal,
	})
	local function piece(name, size, offset, color, material, extra)
		local props = {
			Name = name, Size = size, CFrame = root.CFrame * offset,
			Color = color, Material = material or Enum.Material.SmoothPlastic, CanCollide = false,
		}
		for key, value in pairs(extra or {}) do
			props[key] = value
		end
		return makePart(truck, props)
	end
	local red = Color3.fromRGB(200, 40, 35)
	-- Cabine à l'avant (-Z = avant)
	piece("Cab", Vector3.new(8, 6, 8), CFrame.new(0, 3.5, -19), red)
	piece("Windshield", Vector3.new(7.4, 2.6, 0.2), CFrame.new(0, 4.6, -23.05), Color3.fromRGB(20, 25, 35),
		Enum.Material.Glass, { Transparency = 0.2 })
	piece("Grille", Vector3.new(6, 2, 0.3), CFrame.new(0, 1.4, -23.1), Color3.fromRGB(180, 180, 185), Enum.Material.Metal)
	for _, x in ipairs({ -3, 3 }) do
		piece("Headlight", Vector3.new(1.2, 0.8, 0.2), CFrame.new(x, 1.6, -23.15), Color3.new(1, 1, 0.85), Enum.Material.Neon)
		piece("Exhaust", Vector3.new(0.6, 5, 0.6), CFrame.new(x * 1.45, 6, -15.5), Color3.fromRGB(180, 180, 185), Enum.Material.Metal)
	end
	-- Remorque : 2 plateaux, montants
	piece("LowerDeck", Vector3.new(8, 0.4, 30), CFrame.new(0, 0.9, 7), Color3.fromRGB(90, 90, 95), Enum.Material.DiamondPlate)
	piece("UpperDeck", Vector3.new(8, 0.4, 30), CFrame.new(0, 7.6, 7), Color3.fromRGB(90, 90, 95), Enum.Material.DiamondPlate)
	for _, x in ipairs({ -3.8, 3.8 }) do
		for _, z in ipairs({ -7.5, 7, 21.5 }) do
			piece("Post", Vector3.new(0.4, 7, 0.4), CFrame.new(x, 4.3, z), red, Enum.Material.Metal)
		end
	end
	-- Roues
	for _, z in ipairs({ -19, -9, 12, 18 }) do
		for _, x in ipairs({ -4.2, 4.2 }) do
			piece("Wheel", Vector3.new(1.2, 3.2, 3.2), CFrame.new(x, -0.4, z), Color3.fromRGB(20, 20, 20),
				Enum.Material.SmoothPlastic, { Shape = Enum.PartType.Cylinder })
		end
	end
	for _, part in ipairs(truck:GetDescendants()) do
		if part:IsA("BasePart") and part ~= root then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = root
			weld.Part1 = part
			weld.Parent = root
			part.Anchored = false
			part.Massless = true
		end
	end
	root.Anchored = true
	truck.PrimaryPart = root
	return truck, root
end

-- Places des voitures sur la remorque (par rapport au châssis)
local TRUCK_DECKS = {
	CFrame.new(0, 7.8, 0), CFrame.new(0, 7.8, 14), CFrame.new(0, 1.1, 0), CFrame.new(0, 1.1, 14),
}

local truckBusy = false
local nextTruckAt = os.clock() + 4

-- Déplace le camion et sa cargaison d'un point à un autre
local function moveTruck(root, cargo, from, to, duration)
	local started = os.clock()
	while true do
		local alpha = math.min(1, (os.clock() - started) / duration)
		local eased = alpha * alpha * (3 - 2 * alpha) -- accélère puis freine en douceur
		local cframe = from:Lerp(to, eased)
		root.CFrame = cframe
		for _, item in ipairs(cargo) do
			if not item.unloaded and item.root.Parent then
				item.root.CFrame = cframe * item.deck * item.offset
			end
		end
		if alpha >= 1 then
			break
		end
		RunService.Heartbeat:Wait()
	end
end

-- Une livraison complète : arrivée, déchargement, départ. rarities = raretés imposées (optionnel)
local function deliveryRun(rarities)
	local truck, root = buildTruck()
	local height = 2 -- le châssis est au-dessus des roues
	local outside = CFrame.lookAt(roadPoint(ROAD_END + 30, -4.5, height), roadPoint(0, -4.5, height))
	local stop = CFrame.lookAt(roadPoint(TRUCK_STOP, -4.5, height), roadPoint(0, -4.5, height))
	root.CFrame = outside

	local cargo = {}
	local count = math.min(Config.TruckCars or 4, #TRUCK_DECKS)
	for i = 1, count do
		local car = rollCar(rarities and rarities[i])
		local item = makeLotCar(car, outside * TRUCK_DECKS[i])
		if item then
			item.deck = TRUCK_DECKS[i]
			table.insert(cargo, item)
		end
	end

	-- Annonce des épaves rares
	for _, item in ipairs(cargo) do
		local rarity = raritiesById[item.car.rarity]
		if rarity.announce then
			for _, player in ipairs(Players:GetPlayers()) do
				notify(player, "Delivery truck incoming with a " .. rarity.name .. " " .. item.car.name .. " wreck!")
			end
		end
	end

	moveTruck(root, cargo, outside, stop, 9)

	-- Déchargement : les épaves invendues repartent, les nouvelles prennent leur place
	for i = #lotCars, 1, -1 do
		local old = lotCars[i]
		if os.clock() >= old.expires then
			removeLotCar(old)
		end
	end
	for _, item in ipairs(cargo) do
		local spot
		for _, candidate in ipairs(lotSpots) do
			if not candidate.entry then
				spot = candidate
				break
			end
		end
		if not spot then
			-- Parking plein : on remplace l'épave la plus ancienne
			local oldest = lotCars[1]
			if oldest then
				spot = oldest.spot
				removeLotCar(oldest)
			end
		end
		if spot then
			spot.entry = item
			item.spot = spot
			item.unloaded = true
			local from = item.root.CFrame
			local to = spot.base * item.offset
			local started = os.clock()
			while os.clock() - started < 1 do
				local alpha = (os.clock() - started) / 1
				local lift = math.sin(alpha * math.pi) * 4
				item.root.CFrame = from:Lerp(to, alpha) + Vector3.new(0, lift, 0)
				RunService.Heartbeat:Wait()
			end
			item.root.CFrame = to
			setForSale(item)
		else
			item.model:Destroy()
		end
	end
	task.wait(1)

	-- Demi-tour puis départ
	local turned = stop * CFrame.Angles(0, math.pi, 0)
	moveTruck(root, {}, stop, turned, 2.5)
	local leave = CFrame.lookAt(roadPoint(ROAD_END + 30, 4.5, height), roadPoint(ROAD_END + 60, 4.5, height))
	local start = CFrame.lookAt(roadPoint(TRUCK_STOP, 4.5, height), roadPoint(ROAD_END, 4.5, height))
	moveTruck(root, {}, turned, start, 1)
	moveTruck(root, {}, start, leave, 8)
	truck:Destroy()
end

local function runDelivery(rarities)
	if truckBusy then
		return false
	end
	truckBusy = true
	local ok, err = pcall(deliveryRun, rarities)
	if not ok then
		warn("[Tycoon] Erreur pendant la livraison :", err)
		local leftover = deliveryFolder:FindFirstChild("DeliveryTruck")
		if leftover then
			leftover:Destroy()
		end
	end
	truckBusy = false
	nextTruckAt = os.clock() + Config.TruckInterval
	return ok
end

-- Les épaves qui attendent trop longtemps repartent ; le panneau affiche le compte à rebours
task.spawn(function()
	while true do
		for i = #lotCars, 1, -1 do
			local entry = lotCars[i]
			if os.clock() >= entry.expires + 120 then
				removeLotCar(entry)
			end
		end
		if lotSubtitle then
			if truckBusy then
				lotSubtitle.Text = "Truck is here! Grab a wreck!"
			else
				lotSubtitle.Text = "Next truck in " .. math.max(0, math.ceil(nextTruckAt - os.clock())) .. "s"
			end
		end
		task.wait(1)
	end
end)

task.spawn(function()
	-- Première livraison avec de belles voitures pour donner envie
	task.wait(3)
	runDelivery({ "legendary", "epic", nil, nil })
	while true do
		task.wait(1)
		if not truckBusy and os.clock() >= nextTruckAt then
			runDelivery()
		end
	end
end)

-- ============================================================
-- Vol de voitures : maintenir E sur la voiture d'un autre, la ramener dans son
-- garage sans se faire toucher par le propriétaire. Le bouclier protège 60 s.
-- ============================================================

local carrying = {} -- [voleur] = { entry, car, victim, model, deadline }

-- Personnage d'un joueur ou d'un bot
local function getCharacter(owner)
	if not owner then
		return nil
	end
	if owner:IsA("Player") then
		return owner.Character
	end
	local link = owner:FindFirstChild("Character")
	return link and link.Value
end

local function getRoot(owner)
	local character = getCharacter(owner)
	return character and character:FindFirstChild("HumanoidRootPart")
end

local function inPlot(plot, position)
	local localPosition = plot.cframe:PointToObjectSpace(position)
	return math.abs(localPosition.X) < 42 and math.abs(localPosition.Z) < 44
end

local function isLocked(plot)
	return os.clock() < plot.lockedUntil
end

-- Repousse hors du garage les intrus quand le bouclier est actif
local function pushOut(plot, character)
	character:PivotTo(at(plot, 0, 4, 50))
end

-- Apparence du système de sécurité : bouclier, lasers, gyrophares, écran
local function setSecurityVisual(plot, locked)
	local color = locked and Color3.fromRGB(255, 30, 50) or Color3.fromRGB(0, 255, 120)
	for _, part in ipairs(plot.shield) do
		part.Transparency = locked and 0.45 or 1
	end
	for _, beam in ipairs(plot.lasers) do
		beam.Transparency = locked and 0 or 1
	end
	for _, beacon in ipairs(plot.beacons) do
		beacon.Color = color
		beacon:FindFirstChildOfClass("PointLight").Color = color
	end
	plot.consoleScreen.Color = color
end

local function lockGarage(plot)
	if not plot.owner or isLocked(plot) or os.clock() < plot.lockReadyAt then
		return false
	end
	plot.lockedUntil = os.clock() + Config.LockDuration
	plot.lockReadyAt = plot.lockedUntil + Config.LockCooldown
	setSecurityVisual(plot, true)
	-- Les intrus déjà à l'intérieur sont repoussés
	for _, player in ipairs(Players:GetPlayers()) do
		local root = player ~= plot.owner and getRoot(player)
		if root and inPlot(plot, root.Position) then
			pushOut(plot, player.Character)
		end
	end
	notify(plot.owner, "Garage locked for " .. Config.LockDuration .. " seconds!")
	return true
end

for _, plot in ipairs(plots) do
	plot.lockPrompt.Triggered:Connect(function(player)
		if player == plot.owner then
			lockGarage(plot)
		end
	end)
	for _, part in ipairs(plot.shield) do
		part.Touched:Connect(function(hit)
			if not isLocked(plot) then
				return
			end
			local character = hit.Parent
			local player = Players:GetPlayerFromCharacter(character)
			if player and player ~= plot.owner then
				pushOut(plot, character)
				notify(player, "This garage is locked!")
			end
		end)
	end
end

-- Mini-voiture au-dessus de la tête du voleur
local function attachCarriedCar(character, entry)
	local car = carDef(entry)
	local head = character:FindFirstChild("Head")
	if not head then
		return nil
	end
	local holder = Instance.new("Model")
	holder.Name = "CarriedCar"
	holder.Parent = character
	local model = placeCar(car, holder, head.CFrame * CFrame.new(0, 2.5, 0), true)
	if not model or not model.PrimaryPart then
		holder:Destroy()
		return nil
	end
	if isWreck(entry) then
		makeRusty(model)
	end
	model:ScaleTo(0.35)
	model:PivotTo(head.CFrame * CFrame.new(0, 2, 0))
	for _, part in ipairs(getParts(model)) do
		part.Anchored = false
		part.Massless = true
		part.CanCollide = false
	end
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = head
	weld.Part1 = model.PrimaryPart
	weld.Parent = model.PrimaryPart
	createBillboard(model.PrimaryPart, "STOLEN!", car.name, 3, 7, Color3.fromRGB(255, 60, 60))
	return holder
end

-- Vitesse : 16 normalement, plus lent en portant une voiture
local function applySpeed(owner)
	local character = getCharacter(owner)
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		local base = carrying[owner] and Config.CarryWalkSpeed or 16
		humanoid.WalkSpeed = base
	end
end

local function endCarry(thief)
	local entry = carrying[thief]
	if not entry then
		return nil
	end
	carrying[thief] = nil
	if entry.model then
		entry.model:Destroy()
	end
	applySpeed(thief)
	return entry
end

function tryStealCar(thief, plot, index)
	local victim = plot.owner
	local victimData = victim and playerData[victim]
	local thiefData = playerData[thief]
	local stolen = victimData and victimData.cars[index]
	local car = carDef(stolen)
	if not car or not thiefData or not thiefData.plot or thiefData.plot == plot then
		return false
	end
	if carrying[thief] then
		notify(thief, "You are already carrying a car!")
		return false
	end
	if isLocked(plot) then
		notify(thief, "This garage is locked!")
		return false
	end
	if not freeSlotIndex(thiefData) then
		notify(thief, "Your garage is full! Make room before stealing.")
		return false
	end

	victimData.cars[index] = nil
	renderSlot(plot, index)
	local character = getCharacter(thief)
	carrying[thief] = {
		entry = stolen,
		car = car,
		victim = victim,
		model = character and attachCarriedCar(character, stolen),
		deadline = os.clock() + Config.CarryTimeout,
	}
	applySpeed(thief)
	notify(thief, "You stole " .. car.name .. "! Bring it back to YOUR garage!")
	notify(victim, displayName(thief) .. " is stealing your " .. car.name .. "! Catch them!")
	return true
end

-- Toutes les 0,2 s : voleur rentré chez lui ? attrapé par le propriétaire ? temps écoulé ?
task.spawn(function()
	while true do
		task.wait(0.2)
		for thief, entry in pairs(carrying) do
			local thiefData = playerData[thief]
			local thiefRoot = getRoot(thief)
			local victimRoot = getRoot(entry.victim)
			if not thiefData or not thiefRoot or os.clock() > entry.deadline then
				-- Voleur parti, mort ou trop lent : la voiture revient
				endCarry(thief)
				giveCar(entry.victim, entry.entry)
				notify(entry.victim, "Your " .. entry.car.name .. " came back!")
			elseif victimRoot and (victimRoot.Position - thiefRoot.Position).Magnitude < 6 then
				endCarry(thief)
				giveCar(entry.victim, entry.entry)
				notify(entry.victim, "You caught " .. displayName(thief) .. "! " .. entry.car.name .. " is back.")
				notify(thief, "Caught! " .. entry.car.name .. " went back to its owner.")
			elseif thiefData.plot and inPlot(thiefData.plot, thiefRoot.Position) then
				endCarry(thief)
				giveCar(thief, entry.entry)
				notify(thief, "Stolen car secured: " .. entry.car.name .. "!")
				notify(entry.victim, displayName(thief) .. " stole your " .. entry.car.name .. "!")
			end
		end
	end
end)

-- Panneaux de sécurité : compte à rebours au-dessus de chaque garage et sur la console
local function setLabels(gui, title, subtitle, color)
	local labels = gui:GetChildren() -- [1] titre, [2] sous-titre
	if labels[1] and labels[1]:IsA("TextLabel") then
		labels[1].Text = title
		if color then
			labels[1].TextColor3 = color
		end
	end
	if labels[2] and labels[2]:IsA("TextLabel") then
		labels[2].Text = subtitle
	end
end

task.spawn(function()
	while true do
		task.wait(0.5)
		local now = os.clock()
		for _, plot in ipairs(plots) do
			if not plot.owner then
				setLabels(plot.statusGui, "", "")
			elseif now < plot.lockedUntil then
				local left = math.ceil(plot.lockedUntil - now)
				setLabels(plot.statusGui, "LOCKED " .. left .. "s", "Opens soon...", Color3.fromRGB(255, 50, 60))
				setLabels(plot.lockLabel, "LOCKED", left .. "s left")
			else
				if plot.shield[1].Transparency < 1 then
					setSecurityVisual(plot, false)
				end
				setLabels(plot.statusGui, "OPEN", "Cars can be stolen!", Color3.fromRGB(0, 255, 120))
				if now < plot.lockReadyAt then
					setLabels(plot.lockLabel, "SECURITY", "Ready in " .. math.ceil(plot.lockReadyAt - now) .. "s")
				else
					setLabels(plot.lockLabel, "SECURITY", "Press E to lock")
				end
			end
		end
	end
end)

-- ============================================================
-- Niveau du garage : plus de rebirths = garage plus luxueux et plus grand
-- ============================================================

function applyTheme(plot)
	local tier, level = getTier(plot.owner)
	plot.floor.Color = tier.floorColor
	plot.floor.Material = tier.floorMaterial
	plot.signLabel.TextColor3 = tier.trimColor
	plot.decor:ClearAllChildren()

	local function deco(name, size, x, y, z, color, material, extra)
		local props = {
			Name = name, Size = size, CFrame = at(plot, x, y, z),
			Color = color, Material = material,
		}
		for key, value in pairs(extra or {}) do
			props[key] = value
		end
		return makePart(plot.decor, props)
	end

	-- Les murs déjà construits prennent la couleur du niveau
	for _, part in ipairs(plot.items:GetDescendants()) do
		if part:IsA("BasePart") and (part.Name == "Wall" or part.Name == "UpperWall") then
			part.Color = tier.wallColor
			part.Material = tier.wallMaterial
		end
	end

	if level >= 2 then
		-- Néons au sol tout autour du garage
		local trim = { Material = Enum.Material.Neon }
		deco("Trim", Vector3.new(80, 0.1, 0.4), 0, 0.05, -39.6, tier.trimColor, Enum.Material.Neon, trim)
		deco("Trim", Vector3.new(0.4, 0.1, 80), -39.6, 0.05, 0, tier.trimColor, Enum.Material.Neon, trim)
		deco("Trim", Vector3.new(0.4, 0.1, 80), 39.6, 0.05, 0, tier.trimColor, Enum.Material.Neon, trim)

		-- Façade derrière le garage : elle monte à chaque niveau, le bâtiment paraît plus grand
		local height = 16 + level * 8
		deco("Facade", Vector3.new(84, height, 2), 0, height / 2, -42, tier.wallColor, tier.wallMaterial)
		local crown = deco("FacadeCrown", Vector3.new(84, 1, 2.4), 0, height + 0.5, -42, tier.trimColor, Enum.Material.Neon)
		createBillboard(crown, tier.name .. " GARAGE", nil, 4, 40)
	end

	-- Lampadaires de chaque côté de l'entrée (plus nombreux à chaque niveau)
	local lampSpots = { { -22, 38 }, { 22, 38 }, { -38, 20 }, { 38, 20 }, { -38, -10 }, { 38, -10 } }
	for i = 1, math.min(tier.lamps, #lampSpots) do
		local spot = lampSpots[i]
		deco("LampPole", Vector3.new(0.6, 12, 0.6), spot[1], 6, spot[2], COLOR_DARK, Enum.Material.Metal)
		local bulb = deco("LampBulb", Vector3.new(1.6, 1.6, 1.6), spot[1], 12.5, spot[2], tier.trimColor,
			Enum.Material.Neon, { Shape = Enum.PartType.Ball })
		local light = Instance.new("PointLight")
		light.Color = tier.trimColor
		light.Range = 18
		light.Brightness = 1.5
		light.Parent = bulb
	end

	if level >= 3 then
		-- Plantes à l'entrée
		for _, x in ipairs({ -12, 12 }) do
			deco("Pot", Vector3.new(2.5, 2, 2.5), x, 1, 36, Color3.fromRGB(90, 60, 40), Enum.Material.Wood)
			deco("Plant", Vector3.new(4, 4, 4), x, 4, 36, Color3.fromRGB(40, 140, 60), Enum.Material.Grass,
				{ Shape = Enum.PartType.Ball })
		end
	end

	if level >= 4 then
		-- Tapis rouge de l'entrée
		deco("RedCarpet", Vector3.new(6, 0.1, 30), 0, 0.06, 25, Color3.fromRGB(170, 20, 30), Enum.Material.Fabric)
	end

	if level >= 5 then
		-- Paillettes sur l'enseigne
		local sparkles = Instance.new("Sparkles")
		sparkles.SparkleColor = tier.trimColor
		sparkles.Parent = plot.decor:FindFirstChild("FacadeCrown")
	end
end

-- ============================================================
-- Petite ville autour de la carte (décor)
-- ============================================================

local function buildTown()
	local town = Instance.new("Folder")
	town.Name = "Town"
	town.Parent = workspace
	local rng = Random.new(2026) -- toujours la même ville
	local function townPart(props)
		props.CastShadow = false -- décor lointain : pas d'ombres, moins de calculs
		return makePart(town, props)
	end

	-- Route circulaire
	local roadRadius, segments = Config.PlotDistance + 65, 64
	for i = 1, segments do
		local angle = (i / segments) * 2 * math.pi
		local position = Vector3.new(math.cos(angle) * roadRadius, 0.1, math.sin(angle) * roadRadius)
		local tangent = Vector3.new(-math.sin(angle), 0, math.cos(angle))
		townPart({
			Name = "RingRoad", Size = Vector3.new(14, 0.2, 2 * math.pi * roadRadius / segments + 1),
			CFrame = CFrame.lookAt(position, position + tangent),
			Color = Color3.fromRGB(45, 45, 50), Material = Enum.Material.Asphalt,
		})
	end

	-- Immeubles tournés vers le centre
	local palette = {
		Color3.fromRGB(200, 190, 175), Color3.fromRGB(150, 160, 175), Color3.fromRGB(180, 120, 100),
		Color3.fromRGB(110, 115, 125), Color3.fromRGB(225, 220, 210),
	}
	-- L'autoroute du camion traverse la ville : on n'y met ni immeuble ni arbre
	local highwayAngle = math.rad(Config.RoadAngle or 22.5)
	local function nearHighway(angle, margin)
		local diff = math.abs((angle - highwayAngle + math.pi) % (2 * math.pi) - math.pi)
		return diff < margin
	end

	local count = 40
	for i = 1, count do
		local angle = (i / count) * 2 * math.pi + rng:NextNumber(-0.05, 0.05)
		if nearHighway(angle, math.rad(10)) then
			continue
		end
		local distance = rng:NextNumber(roadRadius + 25, roadRadius + 60)
		local width, depth, height = rng:NextNumber(18, 28), rng:NextNumber(16, 24), rng:NextNumber(22, 75)
		local ground = Vector3.new(math.cos(angle) * distance, 0, math.sin(angle) * distance)
		local facing = CFrame.lookAt(ground, Vector3.zero)
		townPart({
			Name = "Building", Size = Vector3.new(width, height, depth),
			CFrame = facing * CFrame.new(0, height / 2, 0),
			Color = palette[rng:NextInteger(1, #palette)], Material = Enum.Material.Concrete,
		})
		townPart({
			Name = "Windows", Size = Vector3.new(width * 0.8, height * 0.8, 0.3),
			CFrame = facing * CFrame.new(0, height * 0.5, -depth / 2 - 0.1),
			Color = Color3.fromRGB(120, 170, 210), Material = Enum.Material.Glass, Reflectance = 0.2,
		})
		townPart({
			Name = "Roof", Size = Vector3.new(width + 1, 1, depth + 1),
			CFrame = facing * CFrame.new(0, height + 0.5, 0),
			Color = COLOR_DARK, Material = Enum.Material.Metal,
		})
	end

	-- Arbres le long de la route
	for i = 1, 24 do
		local angle = (i / 24) * 2 * math.pi + math.pi / 24
		if nearHighway(angle, math.rad(5)) then
			continue
		end
		local position = Vector3.new(math.cos(angle) * (roadRadius + 12), 0, math.sin(angle) * (roadRadius + 12))
		townPart({
			Name = "Trunk", Size = Vector3.new(1.2, 6, 1.2), CFrame = CFrame.new(position + Vector3.new(0, 3, 0)),
			Color = Color3.fromRGB(100, 70, 45), Material = Enum.Material.Wood,
		})
		townPart({
			Name = "Leaves", Shape = Enum.PartType.Ball, Size = Vector3.new(7, 7, 7),
			CFrame = CFrame.new(position + Vector3.new(0, 8, 0)),
			Color = Color3.fromRGB(50, 130, 60), Material = Enum.Material.Grass,
		})
	end
end

-- Le sol doit être assez grand pour les garages et la ville
local baseplate = workspace:FindFirstChild("Baseplate")
if baseplate and baseplate:IsA("BasePart") then
	local size = (Config.PlotDistance + 165) * 2
	baseplate.Size = Vector3.new(size, baseplate.Size.Y, size)
end

buildTown()

local function getFreePlot()
	for _, plot in ipairs(plots) do
		if not plot.owner then
			return plot
		end
	end
	return nil
end

local function assignPlot(plot, player)
	local data = playerData[player]
	plot.owner = player
	data.plot = plot
	plot.signLabel.Text = displayName(player) .. "'s Garage"

	-- Reconstruit tout ce que le joueur avait acheté (sauvegarde)
	for _, item in ipairs(Config.Items) do
		if data.owned[item.id] then
			buildItem(plot, item)
		end
	end
	plot.lockPrompt:SetAttribute("OwnerId", player:IsA("Player") and player.UserId or -1)
	applyTheme(plot)
	renderSlots(plot)
	updateRoof(plot)
	refreshButtons(plot)
	createGamePassPad(plot)
end

local function releasePlot(plot)
	plot.owner = nil
	plot.items:ClearAllChildren()
	plot.drops:ClearAllChildren()
	plot.carSlots:ClearAllChildren()
	for _, button in pairs(plot.buttons) do
		button:Destroy()
	end
	plot.buttons = {}
	if plot.passPad then
		plot.passPad:Destroy()
		plot.passPad = nil
	end
	if plot.rebirthButton then
		plot.rebirthButton:Destroy()
		plot.rebirthButton = nil
	end
	plot.signLabel.Text = "Free Garage"
	plot.lockedUntil = 0
	plot.lockReadyAt = 0
	plot.lockPrompt:SetAttribute("OwnerId", 0)
	setSecurityVisual(plot, false)
	plot.roof:ClearAllChildren()
	applyTheme(plot)
end

-- Fait (ré)apparaître le perso dans son garage
local function spawnPlayer(player)
	if not player.Parent then
		return
	end
	player:LoadCharacter() -- attend que le perso soit chargé
	local data = playerData[player]
	local character = player.Character
	if not character or not data or not data.plot then
		return
	end
	local target = at(data.plot, 0, 4, 30)
	local root = character:WaitForChild("HumanoidRootPart", 5)
	-- Roblox replace parfois le perso au point de spawn juste après :
	-- on vérifie pendant 2 secondes qu'il est bien dans son garage
	for _ = 1, 10 do
		if not root or not root.Parent then
			return
		end
		if (root.Position - target.Position).Magnitude > 15 then
			character:PivotTo(target)
		end
		task.wait(0.2)
	end
end

-- ============================================================
-- Sauvegarde
-- ============================================================

local function loadData(player)
	local startingCash = Config.StartingCash
	if RunService:IsStudio() and Config.StudioTestCash > 0 then
		startingCash = Config.StudioTestCash -- mode test : uniquement dans Studio
	end
	local data = { owned = {}, cars = {}, parts = {}, cash = startingCash, rebirths = 0, loaded = true }
	if not dataStore then
		return data
	end
	local ok, saved = pcall(function()
		return dataStore:GetAsync("player_" .. player.UserId)
	end)
	if not ok then
		-- On ne sauvegardera pas ce joueur, sinon on écraserait sa vraie partie
		warn("[Tycoon] Chargement impossible pour", player.Name, saved)
		data.loaded = false
	elseif type(saved) == "table" then
		data.cash = tonumber(saved.cash) or data.cash
		data.rebirths = tonumber(saved.rebirths) or 0
		if type(saved.owned) == "table" then
			for _, id in ipairs(saved.owned) do
				if itemsById[id] then
					data.owned[id] = true
				end
			end
		end
		if type(saved.cars) == "table" then
			for _, entry in ipairs(saved.cars) do
				if type(entry) == "table" and carsById[entry.car] and Config.CarSlots[entry.slot] then
					local needs = nil
					if type(entry.needs) == "table" then
						needs = {}
						for partId, amount in pairs(entry.needs) do
							if Config.PartNames[partId] and tonumber(amount) then
								needs[partId] = tonumber(amount)
							end
						end
					end
					data.cars[entry.slot] = { id = entry.car, needs = needs }
				end
			end
		end
		if type(saved.parts) == "table" then
			for partId, amount in pairs(saved.parts) do
				if Config.PartNames[partId] and tonumber(amount) then
					data.parts[partId] = tonumber(amount)
				end
			end
		end
	end
	return data
end

local function saveData(player)
	local data = playerData[player]
	local cash = getCash(player)
	if not dataStore or not data or not data.loaded or not cash then
		return
	end
	local owned = {}
	for id in pairs(data.owned) do
		table.insert(owned, id)
	end
	local cars = {}
	for slot, entry in pairs(data.cars) do
		table.insert(cars, { slot = slot, car = entry.id, needs = entry.needs })
	end
	local ok, err = pcall(function()
		dataStore:SetAsync("player_" .. player.UserId, {
			cash = cash.Value,
			owned = owned,
			cars = cars,
			parts = data.parts,
			rebirths = getRebirths(player),
		})
	end)
	if not ok then
		warn("[Tycoon] Sauvegarde impossible pour", player.Name, err)
	end
end

-- ============================================================
-- Arrivée / départ des joueurs
-- ============================================================

local freeBotPlot -- défini plus bas, dans la partie "Bots" : libère le garage d'un bot

local function onPlayerAdded(player)
	local data = loadData(player)
	if not player.Parent then
		return -- le joueur est parti pendant le chargement
	end
	playerData[player] = data

	-- "leaderstats" = le tableau des scores en haut à droite de l'écran
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	local cash = Instance.new("IntValue")
	cash.Name = "Cash"
	cash.Value = data.cash
	cash.Parent = leaderstats
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Value = data.rebirths
	rebirths.Parent = leaderstats
	leaderstats.Parent = player

	player:SetAttribute("CashMultiplier", 1)
	for partId, amount in pairs(data.parts) do
		player:SetAttribute("Parts_" .. partId, amount)
	end
	if Config.CashX2GamePassId ~= 0 then
		local ok, owns = pcall(function()
			return MarketplaceService:UserOwnsGamePassAsync(player.UserId, Config.CashX2GamePassId)
		end)
		if ok and owns then
			player:SetAttribute("CashMultiplier", 2)
		end
	end

	local plot = getFreePlot() or (freeBotPlot and freeBotPlot())
	if not plot then
		warn("[Tycoon] Plus de garage libre pour", player.Name)
		player:LoadCharacter()
		return
	end
	assignPlot(plot, player)
	print("[Tycoon] " .. player.Name .. " -> garage " .. plot.index)
	if RunService:IsStudio() then
		notify(player, #Config.Cars .. " cars can be delivered by the truck (from ServerStorage > Assets)")
	end

	-- Quand le perso meurt, il réapparaît dans son garage après quelques secondes
	player.CharacterAdded:Connect(function(character)
		character:WaitForChild("Humanoid").Died:Connect(function()
			task.wait(Players.RespawnTime)
			spawnPlayer(player)
		end)
	end)
	spawnPlayer(player)
end

local function onPlayerRemoving(player)
	local carried = endCarry(player)
	if carried then
		giveCar(carried.victim, carried.entry)
	end
	cancelListings(player)
	saveData(player)
	local data = playerData[player]
	if data and data.plot then
		releasePlot(data.plot)
	end
	playerData[player] = nil
end

-- ============================================================
-- Bots : faux joueurs qui jouent tout seuls (pour voir le jeu à plusieurs)
-- Ils achètent, font des rebirths et utilisent le marché comme des joueurs.
-- ============================================================

local BOT_NAMES = { "TurboMax", "NitroLina", "GearBoy", "DriftKing", "PistonPro", "RimQueen" }
local bots = {} -- [bot] = { plot, character }
local botsFolder = Instance.new("Folder")
botsFolder.Name = "Bots"
botsFolder.Parent = ServerStorage

local function createBotCharacter(bot, plot)
	local ok, character = pcall(function()
		local description = Instance.new("HumanoidDescription")
		local color = Color3.fromHSV(math.random(), 0.6, 0.9)
		description.HeadColor = Color3.fromRGB(240, 200, 160)
		description.TorsoColor = color
		description.LeftArmColor = color
		description.RightArmColor = color
		description.LeftLegColor = COLOR_DARK
		description.RightLegColor = COLOR_DARK
		return Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
	end)
	if not ok or not character or not bots[bot] then
		return nil
	end
	character.Name = bot.Name
	local link = Instance.new("ObjectValue")
	link.Name = "Character"
	link.Value = character
	link.Parent = bot
	local state = bots[bot]
	character:FindFirstChildOfClass("Humanoid").DisplayName = bot.Name .. " [BOT · " .. state.personality.name .. "]"
	character.Parent = workspace
	character:PivotTo(at(plot, 0, 4, 30))
	local root = character:FindFirstChild("HumanoidRootPart")
	if root then
		root:SetNetworkOwner(nil)
	end
	return character
end

-- Le bot marche vers un point (abandonne au bout de quelques secondes s'il est bloqué)
-- Le bot marche vers un point en contournant les obstacles (tapis, murs, machines)
local function moveAndWait(humanoid, position, timeout)
	local arrived = false
	local connection = humanoid.MoveToFinished:Connect(function()
		arrived = true
	end)
	humanoid:MoveTo(position)
	local elapsed = 0
	while not arrived and elapsed < timeout do
		elapsed += task.wait(0.1)
	end
	connection:Disconnect()
	return arrived
end

local function botWalkTo(state, position)
	local character = state.character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root then
		return
	end
	local path = PathfindingService:CreatePath({ AgentRadius = 2, AgentHeight = 5, AgentCanJump = true })
	local ok = pcall(function()
		path:ComputeAsync(root.Position, position)
	end)
	if not ok or path.Status ~= Enum.PathStatus.Success then
		moveAndWait(humanoid, position, 6) -- pas de chemin trouvé : tout droit
		return
	end
	for _, waypoint in ipairs(path:GetWaypoints()) do
		if not humanoid.Parent then
			return
		end
		if waypoint.Action == Enum.PathWaypointAction.Jump then
			humanoid.Jump = true
		end
		if not moveAndWait(humanoid, waypoint.Position, 2) then
			moveAndWait(humanoid, position, 4) -- bloqué : on tente tout droit
			return
		end
	end
end

-- Bulle de pensée au-dessus de la tête du bot
local function setThought(state, text)
	local head = state.character and state.character:FindFirstChild("Head")
	if not head then
		return
	end
	local gui = head:FindFirstChild("Thought")
	if not gui then
		gui = Instance.new("BillboardGui")
		gui.Name = "Thought"
		gui.Size = UDim2.new(10, 0, 1.6, 0)
		gui.StudsOffset = Vector3.new(0, 3.2, 0)
		gui.MaxDistance = 70
		gui.Parent = head
		local label = Instance.new("TextLabel")
		label.Name = "Text"
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundColor3 = Color3.new(1, 1, 1)
		label.BackgroundTransparency = 0.15
		label.Font = Enum.Font.GothamMedium
		label.TextScaled = true
		label.TextColor3 = COLOR_DARK
		label.Parent = gui
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.3, 0)
		corner.Parent = label
	end
	gui.Text.Text = "💭 " .. text
end

-- Revenu estimé par seconde (machines x améliorations + voitures) : sert aux bots à réfléchir
local function estimateIncome(owner, owned, cars)
	local dropperIncome, upgrade, carTotal = 0, 1, 0
	for _, item in ipairs(Config.Items) do
		if owned[item.id] then
			if item.kind == "dropper" then
				dropperIncome += item.value / item.interval
			elseif item.kind == "upgrader" then
				upgrade *= item.multiplier
			end
		end
	end
	for _, entry in pairs(cars or {}) do
		carTotal += carIncome(entry)
	end
	carTotal *= 1 + perkBonus(owned, "carIncomeBonus")
	return (dropperIncome * upgrade + carTotal) * getMultiplier(owner)
end

-- Combien d'argent par seconde rapporterait un achat (ou ce qu'il débloque)
local function incomeGain(owner, owned, item, cars)
	local with = table.clone(owned)
	with[item.id] = true
	local gain = estimateIncome(owner, with, cars) - estimateIncome(owner, owned, cars)
	if item.kind == "parking" or item.kind == "floor" then
		-- Des places en plus valent surtout quand le garage est plein
		local count, total = 0, 0
		for _, entry in pairs(cars or {}) do
			count += 1
			total += carIncome(entry)
		end
		local data = { owned = owned, cars = cars or {} }
		local full = freeSlotIndex(data) == nil
		gain = (full and math.max(total / math.max(count, 1), 5) * 2 or 2) * getMultiplier(owner)
	end
	if gain <= 0 then
		-- Pas de revenu direct (murs, étage) : on compte la moitié de ce qu'il débloque
		for _, other in ipairs(Config.Items) do
			if other.requires == item.id then
				local unlocked = table.clone(with)
				unlocked[other.id] = true
				gain += (estimateIncome(owner, unlocked, cars) - estimateIncome(owner, with, cars)) * 0.5
			end
		end
		gain = math.max(gain, 1)
	end
	return gain
end

-- Le bot liste ses options, estime le temps que chacune lui fera gagner ou perdre,
-- et choisit. Selon sa personnalité, il peut s'impatienter ou se tromper.
local function botBrain(bot, state)
	local personality = state.personality
	while bots[bot] do
		task.wait(math.random(20, 40) / 10)
		local plot = state.plot
		local data = playerData[bot]
		local cash = getCash(bot)
		if not bots[bot] or not data or not cash then
			break
		end
		local income = math.max(estimateIncome(bot, data.owned, data.cars), 1)

		-- 0) Urgences : on me vole une voiture -> je poursuis le voleur
		local chasing = false
		for thief, entry in pairs(carrying) do
			local thiefRoot = entry.victim == bot and getRoot(thief)
			if thiefRoot then
				setThought(state, "Hey! Give back my " .. entry.car.name .. "!")
				botWalkTo(state, thiefRoot.Position)
				chasing = true
				break
			end
		end
		if chasing then
			continue
		end
		-- Je porte une voiture volée -> je rentre vite chez moi
		if carrying[bot] then
			setThought(state, "Got it! Running home!")
			botWalkTo(state, at(plot, 0, 3, 20).Position)
			continue
		end
		-- J'ai de belles voitures et mon bouclier est prêt -> je verrouille parfois
		if next(data.cars) and not isLocked(plot) and os.clock() >= plot.lockReadyAt
			and math.random() < personality.lock then
			setThought(state, "Locking my garage, no thieves allowed!")
			botWalkTo(state, at(plot, 10, 3, 34).Position)
			lockGarage(plot)
			continue
		end
		-- Réparer une épave : quand il a toutes les pièces (ou de temps en temps pour avancer)
		local repaired = false
		for index, entry in pairs(data.cars) do
			if isWreck(entry) then
				local complete, some = true, false
				for partId, need in pairs(entry.needs) do
					local have = data.parts[partId] or 0
					if have < need then
						complete = false
					end
					if need > 0 and have > 0 then
						some = true
					end
				end
				if complete or (some and math.random() < 0.25) then
					local car = carDef(entry)
					setThought(state, complete and ("All parts ready! Restoring my " .. car.name .. "!")
						or ("Working on my " .. car.name .. " wreck..."))
					local p = Config.CarSlots[index].position
					botWalkTo(state, at(plot, p.X - 7, p.Y + 3, p.Z).Position)
					if bots[bot] and data.cars[index] == entry then
						repairCar(plot, index)
					end
					repaired = true
					break
				end
			end
		end
		if repaired then
			continue
		end
		-- Tenter un vol dans un garage ouvert
		if freeSlotIndex(data) and math.random() < personality.steal then
			local bestPlot, bestIndex, bestIncome = nil, nil, 0
			for _, other in ipairs(plots) do
				local otherData = other ~= plot and other.owner and playerData[other.owner]
				if otherData and not isLocked(other) then
					for index, entry in pairs(otherData.cars) do
						local value = carValue(entry)
						if value > bestIncome then
							bestPlot, bestIndex, bestIncome = other, index, value
						end
					end
				end
			end
			if bestPlot then
				local car = carDef(playerData[bestPlot.owner].cars[bestIndex])
				setThought(state, "That " .. car.name .. " looks nice... I'll steal it!")
				local p = Config.CarSlots[bestIndex].position
				local target = at(bestPlot, p.X - 7, p.Y + 3, p.Z).Position
				botWalkTo(state, target)
				local root = getRoot(bot)
				if bots[bot] and root and (root.Position - target).Magnitude < 15 then
					tryStealCar(bot, bestPlot, bestIndex)
				else
					setThought(state, "Couldn't reach it...")
				end
				continue
			end
		end

		-- 1) Lister les options
		local options = {}
		for _, item in ipairs(Config.Items) do
			if plot.buttons[item.id] then
				local gain = incomeGain(bot, data.owned, item, data.cars)
				local wait = math.max(0, item.price - cash.Value) / income
				-- temps total = temps pour réunir l'argent + temps pour le rembourser
				table.insert(options, { kind = "buy", item = item, wait = wait, score = wait + item.price / gain })
			end
		end
		-- Voitures : épaves du parking de livraison et voitures du marché
		local hasFreeSlot = freeSlotIndex(data) ~= nil
		local worstSlot, worstIncome = worstCarSlot(data)
		local multiplier = getMultiplier(bot)
		local function considerCar(kind, car, price, wreck, extra)
			-- Une épave rapportera plus tard (il faut la réparer) : elle compte moitié moins
			-- Garage plein : intéressant seulement si elle rapporte plus que la pire voiture
			local gain = car.income * (wreck and 0.5 or 1) - (hasFreeSlot and 0 or worstIncome)
			if gain <= 0 then
				return
			end
			local wait = math.max(0, price - cash.Value) / income
			local option = { kind = kind, item = car, wait = wait, score = wait + price / (gain * multiplier) }
			for key, value in pairs(extra) do
				option[key] = value
			end
			table.insert(options, option)
		end
		for _, entry in ipairs(lotCars) do
			local timeLeft = entry.expires - os.clock()
			-- Inutile d'économiser pour une épave qui sera repartie avant
			local price = wreckPrice(entry.car)
			if math.max(0, price - cash.Value) / income < timeLeft then
				considerCar("lot", entry.car, price, true, { entry = entry })
			end
		end
		for _, slot in ipairs(slots) do
			local listing = slot.listing
			if listing and listing.seller ~= bot then
				considerCar("market", carDef(listing.entry), buyPrice(listing.entry), isWreck(listing.entry), { slot = slot })
			end
		end
		if plot.rebirthButton then
			local wait = math.max(0, getRebirthCost(bot) - cash.Value) / income
			table.insert(options, { kind = "rebirth", wait = wait, score = wait * 0.5 })
		end

		-- 2) Choisir : la meilleure option... sauf erreur ou impatience
		table.sort(options, function(a, b)
			return a.score < b.score
		end)
		local choice = options[1]
		local reason = nil
		if #options > 1 and math.random() > personality.smartness then
			choice = options[math.random(2, #options)]
			reason = "I have a feeling about this one..."
		elseif choice and choice.wait > personality.patience then
			-- Trop long à attendre : il prend ce qu'il peut s'offrir tout de suite (souvent moins rentable)
			for _, option in ipairs(options) do
				if option.wait == 0 then
					choice = option
					reason = "Too long to wait, I'll take this now!"
					break
				end
			end
		end

		-- 3) Agir
		if not choice then
			setThought(state, "Nothing to do... chilling")
			botWalkTo(state, at(plot, math.random(-15, 20), 3, math.random(-5, 32)).Position)
		elseif choice.wait > 0 then
			local name = choice.kind == "rebirth" and "a Rebirth" or choice.item.name
			setThought(state, string.format("Saving for %s... %d%%", name,
				math.floor(cash.Value / (cash.Value + choice.wait * income) * 100)))
			botWalkTo(state, at(plot, math.random(-15, 20), 3, math.random(-5, 32)).Position)
		elseif choice.kind == "buy" then
			setThought(state, reason or ("Buying " .. choice.item.name .. ", best deal!"))
			botWalkTo(state, at(plot, choice.item.button.X, 3, choice.item.button.Z).Position)
			if bots[bot] then
				purchase(plot, bot, choice.item)
			end
		elseif choice.kind == "lot" or choice.kind == "market" then
			if not freeSlotIndex(data) and worstSlot then
				quickSell(plot, worstSlot) -- fait de la place pour une meilleure voiture
			end
			-- Le bot marche jusqu'à la voiture avant de l'acheter
			local function closeTo(position)
				local root = getRoot(bot)
				return root and (root.Position - position).Magnitude < 18
			end
			if choice.kind == "lot" then
				local rarity = raritiesById[choice.item.rarity]
				setThought(state, reason or ("A " .. rarity.name .. " " .. choice.item.name .. " wreck? I'll restore it!"))
				local entry = choice.entry
				botWalkTo(state, entry.root.Position + entry.root.CFrame.RightVector * 7)
				if not entry.removed and closeTo(entry.root.Position) then
					buyFromLot(entry, bot)
				else
					setThought(state, "Someone took the " .. choice.item.name .. "...")
				end
			else
				setThought(state, reason or ("Cheap " .. choice.item.name .. " at the market!"))
				botWalkTo(state, choice.slot.podium.Position + Vector3.new(0, 3, 0))
				if closeTo(choice.slot.podium.Position) then
					buyCar(choice.slot, bot)
				end
			end
		elseif choice.kind == "rebirth" then
			setThought(state, "Rebirth time! My garage will level up!")
			botWalkTo(state, at(plot, Config.RebirthButton.X, 3, Config.RebirthButton.Z).Position)
			if bots[bot] then
				performRebirth(plot, bot)
			end
		end

		-- 4) Les commerçants mettent parfois une voiture en vente (une seule à la fois)
		local hasListing = false
		for _, slot in ipairs(slots) do
			if slot.listing and slot.listing.seller == bot then
				hasListing = true
			end
		end
		if not hasListing and os.clock() > (state.nextTrade or 0) and math.random() < personality.trading then
			local count = 0
			for _ in pairs(data.cars) do
				count += 1
			end
			local sellSlot = worstCarSlot(data) -- recalculé : il a pu vendre une voiture juste avant
			if count >= 3 and sellSlot then
				-- il vend sa moins bonne voiture et garde les meilleures
				setThought(state, "Selling my " .. carDef(data.cars[sellSlot]).name .. " for +50% profit!")
				listCar(plot, sellSlot)
				state.nextTrade = os.clock() + Config.BotTradeCooldown
			end
		end
	end
end

local function createBot(plot)
	local used = {}
	for bot in pairs(bots) do
		used[bot.Name] = true
	end
	local name = "Bot"
	for _, candidate in ipairs(BOT_NAMES) do
		if not used[candidate] then
			name = candidate
			break
		end
	end

	-- Un bot est un simple dossier qui imite un joueur (leaderstats, attributs)
	local bot = Instance.new("Folder")
	bot.Name = name
	bot:SetAttribute("IsBot", true)
	bot:SetAttribute("CashMultiplier", 1)
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	leaderstats.Parent = bot
	local cash = Instance.new("IntValue")
	cash.Name = "Cash"
	cash.Parent = leaderstats
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Parent = leaderstats
	bot.Parent = botsFolder

	playerData[bot] = { owned = {}, cars = {}, parts = {}, cash = 0, rebirths = 0, loaded = false }
	local personality = Config.BotPersonalities[math.random(#Config.BotPersonalities)]
	local state = { plot = plot, personality = personality }
	bots[bot] = state
	assignPlot(plot, bot)
	task.spawn(function()
		state.character = createBotCharacter(bot, plot)
	end)
	task.spawn(botBrain, bot, state)
	return bot
end

local function removeBot(bot)
	local state = bots[bot]
	if not state then
		return
	end
	bots[bot] = nil
	cancelListings(bot)
	if state.character then
		state.character:Destroy()
	end
	releasePlot(state.plot)
	playerData[bot] = nil
	bot:Destroy()
end

-- Un vrai joueur arrive et tous les garages sont pris : un bot lui laisse sa place
freeBotPlot = function()
	for bot, state in pairs(bots) do
		local plot = state.plot
		removeBot(bot)
		return plot
	end
	return nil
end

if Config.BotsEnabled and (RunService:IsStudio() or not Config.BotsOnlyInStudio) then
	task.delay(3, function()
		for _ = 1, Config.BotCount do
			local plot = getFreePlot()
			if plot then
				createBot(plot)
			end
		end
	end)
end

MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
	if purchased and passId == Config.CashX2GamePassId then
		player:SetAttribute("CashMultiplier", 2)
		local data = playerData[player]
		if data and data.plot and data.plot.passPad then
			data.plot.passPad:Destroy()
			data.plot.passPad = nil
		end
	end
end)

-- ============================================================
-- Commandes de test dans le chat (uniquement dans Studio) :
--   /cash 250000  -> te donne de l'argent
--   /rebirths 3   -> règle ton nombre de rebirths (pour voir les niveaux du garage)
-- ============================================================

local function onTestCommand(player, message)
	if not RunService:IsStudio() then
		return
	end
	local command, amount = message:match("^%s*/(%a+)%s+(%d+)")
	amount = tonumber(amount)
	if not command or not amount then
		return
	end
	local stats = player:FindFirstChild("leaderstats")
	if command == "cash" and stats then
		stats.Cash.Value = amount
		notify(player, "Test: cash set to $" .. formatMoney(amount))
	elseif command == "deliver" then
		local rarity = Config.Rarities[amount]
		if rarity then
			notify(player, "Test: a truck is coming with a " .. rarity.name .. " wreck")
			task.spawn(function()
				while truckBusy do
					task.wait(1)
				end
				runDelivery({ rarity.id })
			end)
		end
	elseif command == "parts" then
		local data = playerData[player]
		if data then
			for _, partId in ipairs(PART_IDS) do
				addParts(player, partId, amount)
			end
			notify(player, "Test: +" .. amount .. " of each part")
		end
	elseif command == "rebirths" and stats then
		stats.Rebirths.Value = amount
		local data = playerData[player]
		if data and data.plot then
			applyTheme(data.plot)
		end
		notify(player, "Test: " .. amount .. " rebirths, garage level " .. getTier(player).name)
	end
end

-- Panneau de test à l'écran (boutons, Studio uniquement)
if RunService:IsStudio() then
	local testEvent = Instance.new("RemoteEvent")
	testEvent.Name = "TestCommand"
	testEvent.Parent = ReplicatedStorage
	testEvent.OnServerEvent:Connect(function(player, command, amount)
		if typeof(command) ~= "string" or typeof(amount) ~= "number" then
			return
		end
		if command == "addcash" then
			local cash = getCash(player)
			if cash then
				amount = cash.Value + amount
			end
			command = "cash"
		elseif command == "addrebirth" then
			amount = getRebirths(player) + amount
			command = "rebirths"
		end
		onTestCommand(player, "/" .. command .. " " .. math.floor(amount))
	end)
end

-- Nouveau chat Roblox (TextChatService) : commandes officielles, invisibles pour les autres
local TextChatService = game:GetService("TextChatService")
if RunService:IsStudio() then
	for _, name in ipairs({ "cash", "rebirths" }) do
		local command = Instance.new("TextChatCommand")
		command.Name = "Test_" .. name
		command.PrimaryAlias = "/" .. name
		command.Parent = TextChatService
		command.Triggered:Connect(function(source, text)
			local player = Players:GetPlayerByUserId(source.UserId)
			if player then
				onTestCommand(player, text)
			end
		end)
	end
end

-- Ancien chat Roblox : on lit les messages directement
local function listenChat(player)
	player.Chatted:Connect(function(message)
		if TextChatService.ChatVersion ~= Enum.ChatVersion.TextChatService then
			onTestCommand(player, message)
		end
	end)
end
Players.PlayerAdded:Connect(listenChat)
for _, player in ipairs(Players:GetPlayers()) do
	listenChat(player)
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
-- Joueurs déjà connectés avant que ce script démarre (arrive dans Studio)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end

-- Sauvegarde quand le serveur s'éteint
game:BindToClose(function()
	for _, player in ipairs(Players:GetPlayers()) do
		saveData(player)
	end
end)

-- Revenus des voitures : chaque voiture du showroom rapporte de l'argent chaque seconde
task.spawn(function()
	while true do
		task.wait(1)
		for _, plot in ipairs(plots) do
			local owner = plot.owner
			local data = owner and playerData[owner]
			local cash = owner and getCash(owner)
			if data and cash then
				local income = 0
				for _, entry in pairs(data.cars) do
					income += carIncome(entry)
				end
				income *= 1 + perkBonus(data.owned, "carIncomeBonus")
				if income > 0 then
					cash.Value += math.floor(income * getMultiplier(owner) + 0.5)
				end
			end
		end
	end
end)

-- Sauvegarde automatique régulière (au cas où le serveur plante)
task.spawn(function()
	while true do
		task.wait(Config.AutosaveInterval)
		for _, player in ipairs(Players:GetPlayers()) do
			saveData(player)
		end
	end
end)
