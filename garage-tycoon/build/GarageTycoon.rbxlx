  <Item class="ServerScriptService" referent="5">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="6">
      <Properties>
        <string name="Name">TycoonServer</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- ============================================================
-- Garage Tycoon : script serveur principal
-- Construit les garages, fait tourner les machines, gère l'argent,
-- les achats, la sauvegarde et le Game Pass.
-- Les réglages (prix, gains...) sont dans ReplicatedStorage > Config.
-- ============================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")
local MarketplaceService = game:GetService("MarketplaceService")
local Debris = game:GetService("Debris")
local PathfindingService = game:GetService("PathfindingService")
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local formatMoney = require(ReplicatedStorage:WaitForChild("FormatMoney"))
-- Le script serveur et Config doivent venir de la même mise à jour
local EXPECTED_CONFIG_VERSION = "20 - restauration et camion"
print("[Tycoon] Garage Tycoon version " .. tostring(Config.Version))
if Config.Version ~= EXPECTED_CONFIG_VERSION then
	warn("[Tycoon] ATTENTION : Config n'est pas à jour (" .. tostring(Config.Version) .. " au lieu de "
		.. EXPECTED_CONFIG_VERSION .. "). Ferme l'onglet Config s'il est ouvert, puis relance la mise à jour.")
end

-- On fait apparaître les persos nous-mêmes, directement dans leur garage
Players.CharacterAutoLoads = false

-- Couleurs utilisées partout
local COLOR_FLOOR = Color3.fromRGB(70, 70, 75)
local COLOR_DARK = Color3.fromRGB(35, 35, 40)
local COLOR_BUTTON = Color3.fromRGB(0, 200, 90)
local COLOR_BUTTON_DENIED = Color3.fromRGB(220, 40, 40)
local COLOR_GOLD = Color3.fromRGB(255, 200, 0)
local COLOR_REBIRTH = Color3.fromRGB(170, 70, 255)
local COLOR_CHOICE = Color3.fromRGB(60, 140, 255)

-- Accès rapide à un objet par son id : itemsById["paint"]
-- ============================================================
-- Catalogue automatique : toutes les voitures de ServerStorage > Assets,
-- classées de la moins détaillée (Common) à la plus détaillée (Extreme Legendary)
-- ============================================================
local function detailScore(model)
	local score = 0
	for _, part in ipairs(model:GetDescendants()) do
		if part:IsA("MeshPart") or part:IsA("UnionOperation") then
			score += 3 -- formes travaillées
		elseif part:IsA("BasePart") then
			score += 1
		elseif part:IsA("SpecialMesh") or part:IsA("SurfaceAppearance") or part:IsA("Texture") then
			score += 2
		end
	end
	return score
end

local function buildAutoCatalog()
	local folder = ServerStorage:FindFirstChild("Assets")
	if not Config.AutoCars or not folder or not Config.Rarities then
		return
	end
	local skip = {}
	for _, name in ipairs(Config.DropModelNames or {}) do
		skip[name] = true
	end
	-- Voitures rangées directement dans Assets, ou dans des dossiers à l'intérieur
	local models = {}
	local function scan(container)
		for _, child in ipairs(container:GetChildren()) do
			if child:IsA("Folder") then
				scan(child)
			elseif not skip[child.Name] and (child:IsA("Model") or child:IsA("BasePart")) then
				table.insert(models, { name = child.Name, score = detailScore(child), instance = child })
			end
		end
	end
	scan(folder)
	print("[Tycoon] " .. #models .. " voiture(s) trouvée(s) dans ServerStorage > Assets")
	if #models < 3 then
		warn("[Tycoon] Il faut au moins 3 voitures dans Assets pour le classement automatique.")
		return -- pas assez de voitures : on garde la liste de secours
	end
	-- Deux modèles avec le même nom : on les distingue
	local seen = {}
	for _, entry in ipairs(models) do
		if seen[entry.name] then
			seen[entry.name] += 1
			entry.name ..= " #" .. seen[entry.name]
		else
			seen[entry.name] = 1
		end
	end
	table.sort(models, function(a, b)
		return a.score < b.score
	end)

	-- Rareté de chaque voiture selon son rang
	local shares = Config.AutoRarityShares
	local byRarity = {}
	for rank, entry in ipairs(models) do
		local percent = (rank - 0.5) / #models
		local index, cumulative = #Config.Rarities, 0
		for i, share in ipairs(shares) do
			cumulative += share
			if percent <= cumulative then
				index = i
				break
			end
		end
		if rank == #models then
			index = #Config.Rarities -- la plus détaillée est toujours la rareté maximale
		end
		local override = Config.CarOverrides and Config.CarOverrides[entry.name]
		local rarityId = (override and override.rarity) or Config.Rarities[index].id
		byRarity[rarityId] = byRarity[rarityId] or {}
		table.insert(byRarity[rarityId], entry)
	end

	-- Prix, gain et nom
	local cars = {}
	print("[Tycoon] Voitures automatiques (" .. #models .. ") :")
	for _, rarity in ipairs(Config.Rarities) do
		local list = byRarity[rarity.id] or {}
		local pricing = Config.RarityPricing[rarity.id]
		local names = Config.CarNames[rarity.id] or { rarity.name }
		for rank, entry in ipairs(list) do
			local factor = 1 + 0.6 * (rank - 1) / math.max(#list - 1, 1)
			local override = Config.CarOverrides and Config.CarOverrides[entry.name]
			local name = (override and override.name) or names[(rank - 1) % #names + 1]
			if not (override and override.name) and rank > #names then
				name ..= " " .. string.rep("I", math.floor((rank - 1) / #names) + 1)
			end
			local car = {
				id = "auto_" .. entry.name, name = name, rarity = rarity.id, model = entry.name,
				instance = entry.instance,
				style = (rarity.id == "common" or rarity.id == "rare") and "coupe" or "super",
				price = math.floor(pricing.price * factor / 10) * 10,
				income = math.floor(pricing.income * factor),
				color = rarity.color,
			}
			table.insert(cars, car)
			print(string.format("   %-18s %-28s -> %s (detail %d, $%s, +$%s/s)", rarity.name, entry.name, name,
				entry.score, formatMoney(car.price), formatMoney(car.income)))
		end
	end
	Config.Cars = cars
end

buildAutoCatalog()

local carsById, raritiesById = {}, {}
for _, car in ipairs(Config.Cars or {}) do
	carsById[car.id] = car
end
for _, rarity in ipairs(Config.Rarities or {}) do
	raritiesById[rarity.id] = rarity
end

local itemsById = {}
for _, item in ipairs(Config.Items) do
	itemsById[item.id] = item
end

-- La DataStore peut échouer (jeu pas encore publié, accès API désactivé dans Studio).
-- Dans ce cas on joue sans sauvegarde au lieu de planter.
local dataStore = nil
if Config.SaveEnabled then
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		dataStore = result
	else
		warn("[Tycoon] Sauvegarde désactivée :", result)
	end
end

local plotsFolder = Instance.new("Folder")
plotsFolder.Name = "Tycoons"
plotsFolder.Parent = workspace

local plots = {}      -- la liste des garages
local playerData = {} -- [player] = { owned = {}, cash = n, loaded = bool, plot = garage }

-- ============================================================
-- Petits outils
-- ============================================================

-- Crée une pièce ancrée avec les propriétés données, puis la place dans parent
local function makePart(parent, props)
	local part = Instance.new("Part")
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in pairs(props) do
		part[key] = value
	end
	part.Parent = parent
	return part
end

-- Position dans le repère du garage : (0, 0, 0) = centre du sol du garage
local function at(plot, x, y, z)
	return plot.cframe * CFrame.new(x, y, z)
end

-- Texte flottant au-dessus d'une pièce
-- Texte flottant au-dessus d'une pièce : un titre blanc et, en option, une ligne dorée.
-- La taille est en studs : le texte rapetisse avec la distance, comme un vrai panneau,
-- donc les textes lointains ne se chevauchent plus.
local function createBillboard(part, title, subtitle, offsetY, width, titleColor)
	width = width or 7
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.new(width, 0, subtitle and 2.6 or 1.4, 0)
	gui.StudsOffset = Vector3.new(0, offsetY, 0)
	gui.MaxDistance = 80
	gui.LightInfluence = 0
	gui.Parent = part

	local function addLabel(text, posY, height, color)
		local label = Instance.new("TextLabel")
		label.Position = UDim2.fromScale(0, posY)
		label.Size = UDim2.fromScale(1, height)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.GothamBold
		label.TextScaled = true
		label.TextColor3 = color
		label.TextStrokeTransparency = 0
		label.Text = text
		label.Parent = gui
		return label
	end

	if subtitle then
		addLabel(title, 0, 0.5, titleColor or Color3.new(1, 1, 1))
		addLabel(subtitle, 0.52, 0.48, COLOR_GOLD)
	else
		addLabel(title, 0, 1, Color3.new(1, 1, 1))
	end
	return gui
end

local function getCash(player)
	local stats = player:FindFirstChild("leaderstats")
	return stats and stats:FindFirstChild("Cash")
end

local function getRebirths(player)
	local stats = player:FindFirstChild("leaderstats")
	local rebirths = stats and stats:FindFirstChild("Rebirths")
	return rebirths and rebirths.Value or 0
end

-- Nom affiché d'un propriétaire (joueur ou bot)
local function displayName(owner)
	return owner:IsA("Player") and owner.DisplayName or owner.Name
end

-- Messages en bas à droite de l'écran du joueur (ignorés pour les bots)
local notifyEvent = Instance.new("RemoteEvent")
notifyEvent.Name = "Notify"
notifyEvent.Parent = ReplicatedStorage

local function notify(owner, text)
	if owner and owner:IsA("Player") then
		notifyEvent:FireClient(owner, text)
	end
end

-- Niveau du garage selon le nombre de rebirths (Standard, Bronze, Argent...)
-- Niveau de secours si Config est une ancienne version (évite de bloquer le jeu)
local FALLBACK_TIERS = {
	{
		name = "STANDARD", lamps = 0,
		floorColor = Color3.fromRGB(70, 70, 75), floorMaterial = Enum.Material.Concrete,
		wallColor = Color3.fromRGB(200, 200, 205), wallMaterial = Enum.Material.Brick,
		trimColor = Color3.fromRGB(255, 200, 0),
	},
}

local function getTier(owner)
	local tiers = Config.GarageTiers or FALLBACK_TIERS
	local index = math.min((owner and getRebirths(owner) or 0) + 1, #tiers)
	return tiers[index], index
end

-- Somme d'un bonus donné par les "perks" possédés (ex : carIncomeBonus, marketBonus)
local function perkBonus(owned, field)
	local total = 0
	for _, item in ipairs(Config.Items) do
		if owned[item.id] and item[field] then
			total += item[field]
		end
	end
	return total
end

-- Embranchement : un autre objet du même choix a-t-il déjà été pris ?
local function choiceTaken(owned, item)
	if not item.choice then
		return false
	end
	for _, other in ipairs(Config.Items) do
		if other.choice == item.choice and other.id ~= item.id and owned[other.id] then
			return true
		end
	end
	return false
end

-- Multiplicateur total d'argent : Game Pass x2 et bonus de rebirth
local function getMultiplier(player)
	return (player:GetAttribute("CashMultiplier") or 1) * (1 + Config.RebirthBonus * getRebirths(player))
end

-- ============================================================
-- Les pièces qui roulent sur le tapis
-- ============================================================

-- ============================================================
-- Modèles de la Boîte à outils (optionnels)
-- Range tes modèles dans ServerStorage > Assets, avec les noms indiqués
-- dans Config ("model = ..."). S'ils n'y sont pas, on garde les formes simples.
-- ============================================================

local function getAsset(name)
	local folder = ServerStorage:FindFirstChild("Assets")
	return name and folder and folder:FindFirstChild(name)
end

-- Un élément ressemble-t-il à un logo de marque ? (autocollant, texte, pièce "Logo"...)
local LOGO_WORDS = { "logo", "badge", "emblem", "brand", "decal", "plate", "sticker" }
local function looksLikeLogo(instance)
	if instance:IsA("Decal") or instance:IsA("SurfaceGui") then
		return true -- les logos et plaques sont presque toujours des autocollants
	end
	if instance:IsA("BasePart") then
		local name = instance.Name:lower()
		for _, word in ipairs(LOGO_WORDS) do
			if name:find(word, 1, true) then
				return true
			end
		end
	end
	return false
end

-- Copie un modèle sans ses scripts (sécurité), ses sons ni ses logos, et le met à la bonne taille
local function cloneAsset(asset, targetSize)
	local clone = asset:Clone()
	for _, descendant in ipairs(clone:GetDescendants()) do
		if descendant.Parent and (descendant:IsA("LuaSourceContainer") or descendant:IsA("Sound")
			or (Config.RemoveLogos and looksLikeLogo(descendant))) then
			descendant:Destroy()
		end
	end
	if clone:IsA("BasePart") then
		local biggest = math.max(clone.Size.X, clone.Size.Y, clone.Size.Z)
		clone.Size *= targetSize / biggest
	elseif clone:IsA("Model") then
		local _, size = clone:GetBoundingBox()
		local biggest = math.max(size.X, size.Y, size.Z)
		clone:ScaleTo(clone:GetScale() * targetSize / biggest)
	else
		clone:Destroy()
		return nil
	end
	return clone
end

local function getParts(object)
	if object:IsA("BasePart") then
		return { object }
	end
	local parts = {}
	for _, descendant in ipairs(object:GetDescendants()) do
		if descendant:IsA("BasePart") then
			table.insert(parts, descendant)
		end
	end
	return parts
end

-- Retrouve la pièce (ou le modèle) qui porte la valeur à partir de la partie touchée
local function getDrop(hit)
	local current = hit
	while current and current ~= workspace do
		if current:GetAttribute("Value") then
			return current
		end
		current = current.Parent
	end
	return nil
end

-- Forme des pièces auto qui sortent des machines (voir "drop" dans Config)
local DROP_SHAPES = {
	bolt = { size = Vector3.new(1.4, 0.7, 0.7), shape = Enum.PartType.Cylinder, material = Enum.Material.Metal },
	tire = { size = Vector3.new(0.9, 2, 2), shape = Enum.PartType.Cylinder, material = Enum.Material.Rubber, flat = true },
	engine = { size = Vector3.new(1.8, 1.4, 1.6), shape = Enum.PartType.Block, material = Enum.Material.Metal },
	panel = { size = Vector3.new(2.2, 0.5, 1.6), shape = Enum.PartType.Block, material = Enum.Material.SmoothPlastic },
	rim = { size = Vector3.new(0.6, 2, 2), shape = Enum.PartType.Cylinder, material = Enum.Material.Foil, flat = true },
}

-- Crée une pièce à partir d'un modèle de la Boîte à outils, soudé en un seul bloc
-- Pièce à partir d'un modèle de la Boîte à outils.
-- Pour éviter le lag, la physique est gérée par une simple boîte invisible ;
-- le modèle n'est qu'un "habillage" soudé dessus, sans collisions.
local function makeDropFromAsset(asset, look, spawnCFrame)
	local clone = cloneAsset(asset, math.max(look.size.X, look.size.Y, look.size.Z) * 1.4)
	if not clone then
		return nil, nil
	end
	local parts = getParts(clone)
	if #parts == 0 then
		clone:Destroy()
		return nil, nil
	end

	local drop = Instance.new("Model")
	local root = Instance.new("Part")
	root.Name = "Hitbox"
	root.Size = look.size
	root.Transparency = 1
	root.CFrame = spawnCFrame
	root.Parent = drop
	drop.PrimaryPart = root

	-- Centre l'habillage sur la boîte
	local box = clone:IsA("Model") and clone:GetBoundingBox() or clone.CFrame
	clone:PivotTo(clone:GetPivot() + (spawnCFrame.Position - box.Position))
	for _, part in ipairs(parts) do
		part.Anchored = false
		part.CanCollide = false
		part.CanTouch = false
		part.CanQuery = false
		part.Massless = true
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = part
		weld.Parent = root
	end
	clone.Parent = drop
	return drop, root
end

local function spawnDrop(plot, item)
	local look = DROP_SHAPES[item.drop] or DROP_SHAPES.bolt
	local spawnCFrame = at(plot, -25, 5, item.z)
	local drop, root

	-- Trop de pièces sur le tapis : on attend qu'il se vide (évite le lag)
	if #plot.drops:GetChildren() >= Config.MaxDropsPerPlot then
		return
	end

	local asset = getAsset(item.model)
	if asset then
		drop, root = makeDropFromAsset(asset, look, spawnCFrame)
	end
	if not drop then
		drop = Instance.new("Part")
		drop.Shape = look.shape
		drop.Size = look.size
		drop.Color = item.color
		drop.Material = look.material
		drop.CFrame = spawnCFrame
		if look.flat then
			-- Pneus et jantes posés à plat sur le tapis
			drop.CFrame *= CFrame.Angles(0, 0, math.rad(90))
		end
		drop:SetAttribute("Tintable", true)
		root = drop
	end

	drop.Name = "Drop"
	drop:SetAttribute("Value", item.value)
	drop:SetAttribute("Part", item.drop)
	drop:SetAttribute("Plot", plot.index)
	drop.Parent = plot.drops
	-- Le serveur gère la physique : un tricheur ne peut pas déplacer les pièces
	root:SetNetworkOwner(nil)
	Debris:AddItem(drop, Config.DropLifetime)
end

-- Une pièce touche le collecteur : on la vend
local function onCollect(plot, hit)
	local drop = getDrop(hit)
	local value = drop and drop:GetAttribute("Value")
	if not value or drop:GetAttribute("Plot") ~= plot.index then
		return
	end
	drop:SetAttribute("Plot", nil) -- empêche de compter la même pièce deux fois
	drop:Destroy()

	local owner = plot.owner
	local cash = owner and getCash(owner)
	if cash then
		local multiplier = getMultiplier(owner)
		cash.Value += math.floor(value * multiplier + 0.5)
	end
	-- Chaque pièce arrivée = +1 pièce en stock pour réparer les épaves
	local partId = drop:GetAttribute("Part")
	local data = owner and playerData[owner]
	if partId and data and data.parts then
		data.parts[partId] = (data.parts[partId] or 0) + 1
		owner:SetAttribute("Parts_" .. partId, data.parts[partId])
	end
end

-- ============================================================
-- Construction des objets achetés
-- ============================================================

local function buildDropper(plot, item, model)
	makePart(model, {
		Name = "Pillar", Size = Vector3.new(1, 8, 1), CFrame = at(plot, -28, 4, item.z),
		Color = COLOR_DARK, Material = Enum.Material.Metal,
	})
	local head = makePart(model, {
		Name = "Head", Size = Vector3.new(6, 3, 4), CFrame = at(plot, -25.5, 7.5, item.z),
		Color = item.color, Material = Enum.Material.Metal,
	})
	createBillboard(head, item.name, "+$" .. formatMoney(item.value), 3.2, 6)

	-- Boucle de production : s'arrête toute seule quand la machine est détruite
	task.spawn(function()
		while model.Parent do
			task.wait(item.interval)
			if not model.Parent then
				break
			end
			spawnDrop(plot, item)
		end
	end)
end

local function buildUpgrader(plot, item, model)
	for _, x in ipairs({ -27.75, -22.25 }) do
		makePart(model, {
			Name = "Post", Size = Vector3.new(0.5, 5, 0.5), CFrame = at(plot, x, 2.5, item.z),
			Color = COLOR_DARK, Material = Enum.Material.Metal,
		})
	end
	makePart(model, {
		Name = "Top", Size = Vector3.new(6, 0.5, 0.5), CFrame = at(plot, -25, 5.25, item.z),
		Color = COLOR_DARK, Material = Enum.Material.Metal,
	})
	local gate = makePart(model, {
		Name = "Gate", Size = Vector3.new(5, 4, 0.4), CFrame = at(plot, -25, 2.5, item.z),
		Color = item.color, Material = Enum.Material.Neon, Transparency = 0.5, CanCollide = false,
	})
	createBillboard(gate, item.name, nil, 3.6, 6)

	local tag = "Upgraded_" .. item.id
	gate.Touched:Connect(function(hit)
		local drop = getDrop(hit)
		local value = drop and drop:GetAttribute("Value")
		if not value or drop:GetAttribute("Plot") ~= plot.index or drop:GetAttribute(tag) then
			return
		end
		drop:SetAttribute(tag, true)
		drop:SetAttribute("Value", value * item.multiplier)
		if drop:GetAttribute("Tintable") then
			drop.Color = item.color -- la pièce prend la couleur de la machine
		end
	end)
end

local function buildWalls(plot, item, model)
	local walls = {
		{ Vector3.new(80, 16, 1), Vector3.new(0, 8, -40) }, -- fond
		{ Vector3.new(1, 16, 80), Vector3.new(-40, 8, 0) }, -- gauche
		{ Vector3.new(1, 16, 80), Vector3.new(40, 8, 0) },  -- droite
	}
	local tier = getTier(plot.owner)
	for _, wall in ipairs(walls) do
		local size, pos = wall[1], wall[2]
		makePart(model, {
			Name = "Wall", Size = size, CFrame = at(plot, pos.X, pos.Y, pos.Z),
			Color = tier.wallColor, Material = tier.wallMaterial,
		})
	end
end

-- Prépare une voiture à tourner sur son podium.
-- La rotation est faite par chaque joueur (script CarSpinner) : le serveur ne déplace rien,
-- donc pas de lag réseau, même avec des voitures de centaines de pièces.
local function spinOnPodium(car, base, noSpin)
	local parts = getParts(car)
	if #parts == 0 then
		return
	end
	-- La plus grosse pièce sert d'axe, toutes les autres lui sont soudées
	local root = parts[1]
	for _, part in ipairs(parts) do
		if part.Size.Magnitude > root.Size.Magnitude then
			root = part
		end
	end
	for _, part in ipairs(parts) do
		part.CanCollide = false
		part.CanTouch = false
		if part ~= root then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = root
			weld.Part1 = part
			weld.Parent = root
		end
	end
	for _, part in ipairs(parts) do
		if part ~= root then
			part.Anchored = false
			part.Massless = true
		end
	end
	root.Anchored = true
	car.PrimaryPart = root
	if not noSpin then
		car:SetAttribute("SpinBase", base)
		CollectionService:AddTag(car, "SpinningCar")
	end
end

-- Place une voiture de la Boîte à outils sur le podium. Renvoie false si impossible.
local function placeAssetCar(item, model, base, noSpin)
	local asset = (item.instance and item.instance.Parent and item.instance) or getAsset(item.model)
	local clone = asset and cloneAsset(asset, item.style == "super" and 12 or 11)
	if not clone then
		return nil
	end
	local car = clone
	if clone:IsA("BasePart") then
		car = Instance.new("Model")
		clone.Parent = car
	end
	for _, part in ipairs(getParts(car)) do
		part.Anchored = true
	end
	-- Le point de pivot devient le dessous de la voiture, pour la poser pile sur le podium
	local box, size = car:GetBoundingBox()
	car.WorldPivot = CFrame.new(box.Position - Vector3.new(0, size.Y / 2, 0))
	car.Name = "Car"
	car.Parent = model
	car:PivotTo(base)
	spinOnPodium(car, base, noSpin)
	return car
end

-- Pose une voiture (modèle de la Boîte à outils, sinon voiture simple) sur un podium.
-- noSpin = true : elle ne tourne pas (voitures du tapis de livraison). Renvoie le modèle.
local function placeCar(item, model, base, noSpin)
	local assetCar = placeAssetCar(item, model, base, noSpin)
	if assetCar then
		return assetCar
	end

	local car = Instance.new("Model")
	car.Name = "Car"
	car.Parent = model

	local function carPart(name, size, x, y, z, color, material, extra)
		local props = {
			Name = name, Size = size, CFrame = base * CFrame.new(x, y, z),
			Color = color, Material = material,
		}
		for key, value in pairs(extra or {}) do
			props[key] = value
		end
		return makePart(car, props)
	end

	local glass = Color3.fromRGB(20, 25, 35)
	if item.style == "super" then
		carPart("Body", Vector3.new(5.4, 1.2, 11), 0, 1.4, 0, item.color, Enum.Material.SmoothPlastic)
		carPart("Cabin", Vector3.new(4.6, 1.1, 4.5), 0, 2.55, 0.5, glass, Enum.Material.Glass, { Transparency = 0.2 })
		carPart("Spoiler", Vector3.new(5, 0.3, 1.2), 0, 2.9, 5, COLOR_DARK, Enum.Material.SmoothPlastic)
		for _, x in ipairs({ -1.8, 1.8 }) do
			carPart("SpoilerLeg", Vector3.new(0.3, 0.9, 0.3), x, 2.35, 5, COLOR_DARK, Enum.Material.SmoothPlastic)
		end
	else
		carPart("Body", Vector3.new(5, 1.6, 10), 0, 1.6, 0, item.color, Enum.Material.SmoothPlastic)
		carPart("Cabin", Vector3.new(4.4, 1.6, 5), 0, 3.2, 0.5, glass, Enum.Material.Glass, { Transparency = 0.2 })
	end
	for _, x in ipairs({ -1.6, 1.6 }) do
		carPart("Headlight", Vector3.new(1, 0.4, 0.2), x, 1.6, -5.1, Color3.new(1, 1, 1), Enum.Material.Neon)
	end
	for _, x in ipairs({ -2.6, 2.6 }) do
		for _, z in ipairs({ -3.2, 3.2 }) do
			carPart("Wheel", Vector3.new(1, 2.4, 2.4), x, 1.2, z, Color3.fromRGB(20, 20, 20),
				Enum.Material.SmoothPlastic, { Shape = Enum.PartType.Cylinder })
		end
	end

	car.WorldPivot = base
	spinOnPodium(car, base, noSpin)
	return car
end

local makeRusty -- défini plus bas

-- Paillettes sur les voitures des raretés les plus hautes
local function decorateRarity(car, carDef)
	local rarity = raritiesById[carDef.rarity]
	if rarity and rarity.sparkles and car.PrimaryPart then
		local sparkles = Instance.new("Sparkles")
		sparkles.SparkleColor = rarity.color
		sparkles.Parent = car.PrimaryPart
	end
end

-- Aspect d'épave : carrosserie rouillée et terne
local RUST = Color3.fromRGB(120, 72, 40)
function makeRusty(car)
	if not car then
		return
	end
	for _, descendant in ipairs(car:GetDescendants()) do
		if descendant:IsA("SurfaceAppearance") or descendant:IsA("Texture") then
			descendant:Destroy()
		elseif descendant:IsA("BasePart") and descendant.Transparency < 0.5 then
			descendant.Color = descendant.Color:Lerp(RUST, 0.65)
			descendant.Material = Enum.Material.CorrodedMetal
			if descendant:IsA("MeshPart") then
				descendant.TextureID = ""
			end
		end
	end
end

-- Podium de luxe : socle sombre, anneau lumineux et plateau en marbre blanc.
-- ground = position au sol ; renvoie le plateau et le CFrame du dessus (où poser la voiture)
local function makePodium(parent, ground, trimColor)
	local turn = CFrame.Angles(0, 0, math.rad(90))
	makePart(parent, {
		Name = "PodiumBase", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.2, 13, 13),
		CFrame = ground * CFrame.new(0, 0.6, 0) * turn, Color = COLOR_DARK, Material = Enum.Material.Metal,
	})
	makePart(parent, {
		Name = "PodiumRing", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.25, 13.6, 13.6),
		CFrame = ground * CFrame.new(0, 0.75, 0) * turn, Color = trimColor, Material = Enum.Material.Neon,
	})
	local top = makePart(parent, {
		Name = "Podium", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 12, 12),
		CFrame = ground * CFrame.new(0, 1.35, 0) * turn,
		Color = Color3.fromRGB(240, 240, 245), Material = Enum.Material.Marble,
	})
	return top, ground * CFrame.new(0, 1.5, 0)
end

local listCar -- défini plus bas, dans la partie "Marché"

-- ============================================================
-- Places de parking du garage : chaque voiture possédée y est exposée
-- ============================================================

-- ============================================================
-- Voitures possédées : { id = voiture, needs = pièces manquantes } (needs = nil : réparée)
-- ============================================================

local PART_IDS = { "bolt", "tire", "engine", "panel", "rim" }

local function carDef(entry)
	return entry and carsById[entry.id]
end

local function isWreck(entry)
	return entry ~= nil and entry.needs ~= nil
end

-- Une épave ne rapporte rien : il faut la réparer
local function carIncome(entry)
	local def = carDef(entry)
	return (def and not isWreck(entry)) and def.income or 0
end

-- Valeur d'une voiture : plein prix réparée, prix d'épave sinon
local function carValue(entry)
	local def = carDef(entry)
	if not def then
		return 0
	end
	return isWreck(entry) and math.floor(def.price * Config.WreckPriceRatio) or def.price
end

local function newWreck(def)
	return { id = def.id, needs = table.clone(Config.RepairParts[def.rarity] or {}) }
end

local function needsText(needs)
	local parts = {}
	for _, partId in ipairs(PART_IDS) do
		local amount = needs[partId] or 0
		if amount > 0 then
			table.insert(parts, amount .. " " .. Config.PartNames[partId])
		end
	end
	return table.concat(parts, " · ")
end

-- Stock de pièces d'un propriétaire (copié en attributs pour l'affichage du joueur)
local function addParts(owner, partId, amount)
	local data = playerData[owner]
	if not data then
		return
	end
	data.parts[partId] = (data.parts[partId] or 0) + amount
	owner:SetAttribute("Parts_" .. partId, data.parts[partId])
end

local function slotUnlocked(data, slotDef)
	return slotDef.requires == nil or data.owned[slotDef.requires] == true
end

-- Première place libre et débloquée (nil si le garage est plein)
local function freeSlotIndex(data)
	for index, slotDef in ipairs(Config.CarSlots) do
		if slotUnlocked(data, slotDef) and not data.cars[index] then
			return index
		end
	end
	return nil
end

-- Voiture qui rapporte le moins (pour la remplacer par une meilleure)
local function worstCarSlot(data)
	local worstIndex, worstIncome = nil, math.huge
	for index, entry in pairs(data.cars) do
		local value = carIncome(entry) + carValue(entry) / 1000
		if value < worstIncome then
			worstIndex, worstIncome = index, value
		end
	end
	return worstIndex, worstIncome
end

local quickSell -- défini juste après
local repairCar -- défini juste après
local tryStealCar -- défini dans la partie "Vol de voitures"

-- Les touches E/F ne s'affichent que pour les bonnes personnes (script PromptFilter côté joueur) :
-- "OwnerOnly" = seulement le propriétaire, "ThiefOnly" = seulement les autres joueurs
local function tagPrompt(prompt, tag, owner)
	prompt:SetAttribute("OwnerId", owner:IsA("Player") and owner.UserId or -1)
	CollectionService:AddTag(prompt, tag)
end

-- (Re)construit une place : podium + voiture + touches E (marché) et F (vente rapide)
local function renderSlot(plot, index)
	local old = plot.carSlots:FindFirstChild("Slot" .. index)
	if old then
		old:Destroy()
	end
	local owner = plot.owner
	local data = owner and playerData[owner]
	local slotDef = Config.CarSlots[index]
	if not data or not slotDef or not slotUnlocked(data, slotDef) then
		return
	end

	local model = Instance.new("Model")
	model.Name = "Slot" .. index
	model.Parent = plot.carSlots
	local p = slotDef.position
	local podium, top = makePodium(model, at(plot, p.X, p.Y, p.Z), getTier(owner).trimColor)
	local entry = data.cars[index]
	local car = carDef(entry)
	if not car then
		createBillboard(podium, "EMPTY SPOT", "Buy wrecks at the car lot", 7, 10)
		return
	end

	local rarity = raritiesById[car.rarity]
	local wreck = isWreck(entry)
	if wreck then
		createBillboard(podium, "WRECK: " .. car.name, "Needs " .. needsText(entry.needs), 7, 13, rarity.color)
	else
		createBillboard(podium, car.name, rarity.name .. "  ·  +$" .. formatMoney(car.income) .. "/s", 7, 11, rarity.color)
	end

	if wreck then
		-- Épave : la touche E sert à la réparer avec les pièces du stock
		local repairPrompt = Instance.new("ProximityPrompt")
		repairPrompt.ActionText = "Repair"
		repairPrompt.ObjectText = "Uses your parts"
		repairPrompt.HoldDuration = 0.5
		repairPrompt.MaxActivationDistance = 12
		repairPrompt.RequiresLineOfSight = false
		tagPrompt(repairPrompt, "OwnerOnly", owner)
		repairPrompt.Parent = podium
		repairPrompt.Triggered:Connect(function(player)
			if player == plot.owner then
				repairCar(plot, index)
			end
		end)
	else
		local sellPrompt = Instance.new("ProximityPrompt")
		sellPrompt.ActionText = "Sell at Market"
		sellPrompt.ObjectText = "Get $" .. formatMoney(math.floor(carValue(entry) * Config.MarketSellerBonus))
		sellPrompt.HoldDuration = 1
		sellPrompt.MaxActivationDistance = 12
		sellPrompt.RequiresLineOfSight = false
		tagPrompt(sellPrompt, "OwnerOnly", owner)
		sellPrompt.Parent = podium
		sellPrompt.Triggered:Connect(function(player)
			if player == plot.owner then
				listCar(plot, index)
			end
		end)
	end

	local quickPrompt = Instance.new("ProximityPrompt")
	quickPrompt.ActionText = "Quick Sell $" .. formatMoney(math.floor(carValue(entry) * Config.QuickSellRatio))
	quickPrompt.ObjectText = car.name
	quickPrompt.KeyboardKeyCode = Enum.KeyCode.F
	quickPrompt.HoldDuration = 1.5
	quickPrompt.MaxActivationDistance = 12
	quickPrompt.RequiresLineOfSight = false
	quickPrompt.UIOffset = Vector2.new(0, 70)
	tagPrompt(quickPrompt, "OwnerOnly", owner)
	quickPrompt.Parent = podium
	quickPrompt.Triggered:Connect(function(player)
		if player == plot.owner then
			quickSell(plot, index)
		end
	end)

	-- Les autres joueurs peuvent la voler (maintenir E)
	local stealPrompt = Instance.new("ProximityPrompt")
	stealPrompt.ActionText = "STEAL"
	stealPrompt.ObjectText = car.name .. " (" .. rarity.name .. ")"
	stealPrompt.HoldDuration = Config.StealHoldTime
	stealPrompt.MaxActivationDistance = 12
	stealPrompt.RequiresLineOfSight = false
	tagPrompt(stealPrompt, "ThiefOnly", owner)
	stealPrompt.Parent = podium
	stealPrompt.Triggered:Connect(function(player)
		if player ~= plot.owner then
			tryStealCar(player, plot, index)
		end
	end)

	local carModel = placeCar(car, model, top)
	if wreck then
		makeRusty(carModel)
	else
		decorateRarity(carModel, car)
	end
end

local function renderSlots(plot)
	plot.carSlots:ClearAllChildren()
	for index in ipairs(Config.CarSlots) do
		renderSlot(plot, index)
	end
end

-- Toit en verre : posé avec les murs. Au-dessus de l'étage VIP quand il est acheté
-- (avec une ouverture pour l'escalier).
local function updateRoof(plot)
	plot.roof:ClearAllChildren()
	local data = plot.owner and playerData[plot.owner]
	if not data or not data.owned.walls then
		return
	end
	local hasFloor = data.owned.floor2
	local pieces = {
		{ x = -19, z = 0, w = 42, l = 80, y = 16.25 }, -- côté machines
		{ x = 9, z = 14, w = 14, l = 52, y = 16.25 }, -- milieu, devant l'escalier
	}
	if hasFloor then
		table.insert(pieces, { x = 28, z = 0, w = 24, l = 80, y = 26.25 }) -- au-dessus de l'étage VIP
	else
		table.insert(pieces, { x = 9, z = -26, w = 14, l = 28, y = 16.25 })
		table.insert(pieces, { x = 28, z = 0, w = 24, l = 80, y = 16.25 })
	end
	for _, piece in ipairs(pieces) do
		makePart(plot.roof, {
			Name = "RoofGlass", Size = Vector3.new(piece.w, 0.5, piece.l), CFrame = at(plot, piece.x, piece.y, piece.z),
			Color = Color3.fromRGB(170, 210, 240), Material = Enum.Material.Glass, Transparency = 0.45,
			CastShadow = false,
		})
		-- Cadre métallique autour de chaque vitre
		for _, side in ipairs({ -1, 1 }) do
			makePart(plot.roof, {
				Name = "RoofFrame", Size = Vector3.new(piece.w, 0.7, 0.6),
				CFrame = at(plot, piece.x, piece.y + 0.1, piece.z + side * (piece.l / 2 - 0.3)),
				Color = COLOR_DARK, Material = Enum.Material.Metal,
			})
			makePart(plot.roof, {
				Name = "RoofFrame", Size = Vector3.new(0.6, 0.7, piece.l),
				CFrame = at(plot, piece.x + side * (piece.w / 2 - 0.3), piece.y + 0.1, piece.z),
				Color = COLOR_DARK, Material = Enum.Material.Metal,
			})
		end
	end
end

-- Vente rapide : la voiture disparaît, on récupère une partie de son prix
function quickSell(plot, index)
	local owner = plot.owner
	local data = owner and playerData[owner]
	local cash = owner and getCash(owner)
	local entry = data and data.cars[index]
	local car = carDef(entry)
	if not car or not cash then
		return
	end
	data.cars[index] = nil
	local earned = math.floor(carValue(entry) * Config.QuickSellRatio)
	cash.Value += earned
	renderSlot(plot, index)
	notify(owner, "Sold " .. car.name .. " for $" .. formatMoney(earned))
end

-- Réparation : utilise les pièces du stock. Quand il ne manque plus rien, la voiture est réparée.
function repairCar(plot, index)
	local owner = plot.owner
	local data = owner and playerData[owner]
	local entry = data and data.cars[index]
	local car = carDef(entry)
	if not car or not isWreck(entry) then
		return false
	end
	local used = 0
	for _, partId in ipairs(PART_IDS) do
		local need = entry.needs[partId] or 0
		local take = math.min(need, data.parts[partId] or 0)
		if take > 0 then
			entry.needs[partId] = need - take
			addParts(owner, partId, -take)
			used += take
		end
	end
	local done = true
	for _, partId in ipairs(PART_IDS) do
		if (entry.needs[partId] or 0) > 0 then
			done = false
		end
	end
	if done then
		entry.needs = nil
		notify(owner, car.name .. " is fully restored! +$" .. formatMoney(car.income) .. "/s")
	elseif used > 0 then
		notify(owner, "Repairing " .. car.name .. "... still needs " .. needsText(entry.needs))
	else
		notify(owner, "No parts! Your factory makes them: " .. needsText(entry.needs))
	end
	renderSlot(plot, index)
	if done then
		local slotModel = plot.carSlots:FindFirstChild("Slot" .. index)
		local root = slotModel and slotModel:FindFirstChild("Car", true)
		if root and root:IsA("Model") and root.PrimaryPart then
			local sparkles = Instance.new("Sparkles")
			sparkles.Parent = root.PrimaryPart
			Debris:AddItem(sparkles, 4)
		end
	end
	return done
end

-- Étage VIP : dalle sur la moitié droite du garage, escalier, rambardes et murs
local FLOOR_Y = 16 -- hauteur du sol de l'étage

local function buildUpperFloor(plot, item, model)
	local function block(name, size, x, y, z, color, material, extra)
		local props = {
			Name = name, Size = size, CFrame = at(plot, x, y, z),
			Color = color, Material = material,
		}
		for key, value in pairs(extra or {}) do
			props[key] = value
		end
		return makePart(model, props)
	end
	local tier = getTier(plot.owner)
	local floorColor = Color3.fromRGB(225, 225, 230)
	local glass = { Transparency = 0.5 }

	-- Dalle de l'étage et palier en haut de l'escalier
	block("UpperFloor", Vector3.new(24, 1, 80), 28, FLOOR_Y - 0.5, 0, floorColor, Enum.Material.Marble)
	block("Landing", Vector3.new(14, 1, 4.5), 9, FLOOR_Y - 0.5, -37.25, floorColor, Enum.Material.Marble)

	-- Escalier contre le mur du fond : 16 marches de 1 stud
	local steps = 16
	local depth = 1.6
	for i = 1, steps do
		local height = FLOOR_Y * i / steps
		block("Step", Vector3.new(6, height, depth), 5, height / 2, -12 - (i - 0.5) * depth,
			COLOR_DARK, Enum.Material.Concrete)
	end

	-- Piliers sous la dalle
	for _, z in ipairs({ 36, 4, -24 }) do
		block("Pillar", Vector3.new(1, FLOOR_Y - 1, 1), 16.5, (FLOOR_Y - 1) / 2, z, COLOR_DARK, Enum.Material.Metal)
	end

	-- Rambardes en verre et murs de l'étage
	block("Railing", Vector3.new(0.4, 3, 75), 16.2, FLOOR_Y + 1.5, 2.5, item.color, Enum.Material.Glass, glass)
	block("Railing", Vector3.new(8, 3, 0.4), 12, FLOOR_Y + 1.5, -35.2, item.color, Enum.Material.Glass, glass)
	block("Railing", Vector3.new(24, 3, 0.4), 28, FLOOR_Y + 1.5, 39.8, item.color, Enum.Material.Glass, glass)
	block("UpperWall", Vector3.new(1, 10, 80), 40, FLOOR_Y + 5, 0, tier.wallColor, tier.wallMaterial)
	block("UpperWall", Vector3.new(38, 10, 1), 21, FLOOR_Y + 5, -40, tier.wallColor, tier.wallMaterial)

	-- Bande lumineuse et panneau
	local strip = block("NeonStrip", Vector3.new(0.3, 0.4, 78), 39.4, FLOOR_Y + 9, 0, tier.trimColor, Enum.Material.Neon)
	createBillboard(strip, "VIP SHOWROOM", nil, 2, 16)
end

-- Bureau d'un "perk" (bonus permanent choisi dans un embranchement)
local function buildPerk(plot, item, model)
	local p = item.position
	makePart(model, {
		Name = "Desk", Size = Vector3.new(6, 3, 3), CFrame = at(plot, p.X, 1.5, p.Z),
		Color = Color3.fromRGB(90, 60, 40), Material = Enum.Material.Wood,
	})
	local screen = makePart(model, {
		Name = "Screen", Size = Vector3.new(3, 2, 0.3), CFrame = at(plot, p.X, 4, p.Z),
		Color = item.color, Material = Enum.Material.Neon,
	})
	createBillboard(screen, item.name, "ACTIVE", 3, 9)
end

-- Places de parking en plus : marquage au sol
local function buildParking(plot, item, model)
	for _, z in ipairs({ -16, -30 }) do
		makePart(model, {
			Name = "ParkingLine", Size = Vector3.new(14, 0.1, 0.4), CFrame = at(plot, 28, 0.05, z + 7),
			Color = Color3.new(1, 1, 1), Material = Enum.Material.SmoothPlastic,
		})
	end
end

local builders = {
	perk = buildPerk,
	parking = buildParking,
	dropper = buildDropper,
	upgrader = buildUpgrader,
	walls = buildWalls,
	floor = buildUpperFloor,
}

local function buildItem(plot, item)
	local model = Instance.new("Model")
	model.Name = item.id
	model.Parent = plot.items
	builders[item.kind](plot, item, model)
end

-- ============================================================
-- Boutons d'achat
-- ============================================================

local refreshButtons -- déclarée ici car createButton en a besoin

-- Pas assez d'argent : le bouton clignote en rouge
local function flashDenied(button)
	if button:GetAttribute("Flashing") then
		return
	end
	local original = button.Color
	button:SetAttribute("Flashing", true)
	button.Color = COLOR_BUTTON_DENIED
	task.delay(0.5, function()
		button.Color = original
		button:SetAttribute("Flashing", nil)
	end)
end

-- Achat d'un objet par le propriétaire du garage (joueur ou bot). Renvoie true si acheté.
local function purchase(plot, owner, item)
	if owner ~= plot.owner or plot.buying then
		return false
	end
	local data = playerData[owner]
	local cash = getCash(owner)
	if not data or not cash or data.owned[item.id] or cash.Value < item.price then
		return false
	end
	plot.buying = true
	cash.Value -= item.price
	data.owned[item.id] = true
	buildItem(plot, item)
	refreshButtons(plot)
	if item.kind == "parking" or item.kind == "floor" then
		renderSlots(plot) -- nouvelles places de parking
	end
	if item.kind == "walls" or item.kind == "floor" then
		updateRoof(plot)
	end
	plot.buying = false
	return true
end

local function tryBuy(plot, item, button, hit)
	local player = Players:GetPlayerFromCharacter(hit.Parent)
	if not player or player ~= plot.owner then
		return
	end
	local cash = getCash(player)
	if cash and cash.Value < item.price then
		flashDenied(button)
		return
	end
	purchase(plot, player, item)
end

local function createButton(plot, item)
	local pos = item.button
	-- Les boutons d'un embranchement sont bleus : on ne peut en prendre qu'un
	local button = makePart(plot.model, {
		Name = "Button_" .. item.id, Size = Vector3.new(4, 0.6, 4),
		CFrame = at(plot, pos.X, 0.3, pos.Z), Color = item.choice and COLOR_CHOICE or COLOR_BUTTON,
		Material = Enum.Material.Neon,
	})
	local priceText = item.price == 0 and "FREE" or ("$" .. formatMoney(item.price))
	if item.choice then
		priceText = priceText .. " · CHOOSE ONE"
	end
	createBillboard(button, item.name, priceText, 3, 8)
	button.Touched:Connect(function(hit)
		tryBuy(plot, item, button, hit)
	end)
	return button
end

-- ============================================================
-- Rebirth : quand tout est acheté, on recommence à zéro
-- contre un bonus d'argent permanent
-- ============================================================

local function getRebirthCost(player)
	return Config.RebirthCost * (getRebirths(player) + 1)
end

local applyTheme -- défini plus bas : décore le garage selon son niveau

-- Rebirth du propriétaire (joueur ou bot). Renvoie true si effectué.
local function performRebirth(plot, owner)
	if owner ~= plot.owner or plot.buying then
		return false
	end
	local data = playerData[owner]
	local cash = getCash(owner)
	local rebirths = owner.leaderstats:FindFirstChild("Rebirths")
	if not data or not cash or not rebirths or cash.Value < getRebirthCost(owner) then
		return false
	end

	plot.buying = true
	rebirths.Value += 1
	cash.Value = Config.StartingCash
	data.owned = {}
	for index in pairs(data.cars) do
		if index > Config.RebirthKeepSlots then
			data.cars[index] = nil
		end
	end
	plot.items:ClearAllChildren()
	plot.drops:ClearAllChildren()
	for _, oldButton in pairs(plot.buttons) do
		oldButton:Destroy()
	end
	plot.buttons = {}
	plot.rebirthButton:Destroy()
	plot.rebirthButton = nil
	applyTheme(plot)
	renderSlots(plot)
	updateRoof(plot)
	refreshButtons(plot)
	plot.buying = false
	local tier = getTier(owner)
	notify(owner, "Rebirth! Your garage is now " .. tier.name .. " level!")
	return true
end

local function doRebirth(plot, button, hit)
	local player = Players:GetPlayerFromCharacter(hit.Parent)
	if not player or player ~= plot.owner then
		return
	end
	local cash = getCash(player)
	if cash and cash.Value < getRebirthCost(player) then
		flashDenied(button)
		return
	end
	performRebirth(plot, player)
end

local function createRebirthButton(plot)
	local pos = Config.RebirthButton
	local button = makePart(plot.model, {
		Name = "RebirthButton", Size = Vector3.new(5, 0.6, 5),
		CFrame = at(plot, pos.X, 0.3, pos.Z), Color = COLOR_REBIRTH, Material = Enum.Material.Neon,
	})
	local bonus = math.floor(Config.RebirthBonus * 100 + 0.5)
	createBillboard(button, "REBIRTH (+" .. bonus .. "% cash)", "$" .. formatMoney(getRebirthCost(plot.owner)), 3, 9)
	button.Touched:Connect(function(hit)
		doRebirth(plot, button, hit)
	end)
	return button
end

-- Affiche les boutons des objets débloqués et pas encore achetés
function refreshButtons(plot)
	local data = plot.owner and playerData[plot.owner]
	if not data then
		return
	end
	for _, item in ipairs(Config.Items) do
		local visible = not data.owned[item.id] and not choiceTaken(data.owned, item)
			and (item.requires == nil or data.owned[item.requires])
		local button = plot.buttons[item.id]
		if visible and not button then
			plot.buttons[item.id] = createButton(plot, item)
		elseif not visible and button then
			button:Destroy()
			plot.buttons[item.id] = nil
		end
	end

	-- Le bouton de rebirth apparaît quand tout est acheté
	local allOwned = true
	for _, item in ipairs(Config.Items) do
		if not data.owned[item.id] and not choiceTaken(data.owned, item) then
			allOwned = false
			break
		end
	end
	if allOwned and not plot.rebirthButton then
		plot.rebirthButton = createRebirthButton(plot)
	elseif not allOwned and plot.rebirthButton then
		plot.rebirthButton:Destroy()
		plot.rebirthButton = nil
	end
end

-- Bouton doré pour acheter le Game Pass "Argent x2"
local function createGamePassPad(plot)
	local owner = plot.owner
	if Config.CashX2GamePassId == 0 or not owner or not owner:IsA("Player") or owner:GetAttribute("CashMultiplier") == 2 then
		return
	end
	local pad = makePart(plot.model, {
		Name = "GamePassPad", Size = Vector3.new(5, 0.6, 5), CFrame = at(plot, Config.GamePassPad.X, 0.3, Config.GamePassPad.Z),
		Color = COLOR_GOLD, Material = Enum.Material.Neon,
	})
	createBillboard(pad, "2x CASH", "Game Pass", 3, 7)

	local cooldown = false
	pad.Touched:Connect(function(hit)
		local player = Players:GetPlayerFromCharacter(hit.Parent)
		if cooldown or not player or player ~= plot.owner or player:GetAttribute("CashMultiplier") == 2 then
			return
		end
		cooldown = true
		MarketplaceService:PromptGamePassPurchase(player, Config.CashX2GamePassId)
		task.delay(5, function()
			cooldown = false
		end)
	end)
	plot.passPad = pad
end

-- ============================================================
-- Création des garages (vides au démarrage)
-- ============================================================

local function createPlot(index)
	-- Les garages sont répartis en cercle, l'entrée tournée vers le centre
	local angle = (index - 1) * (2 * math.pi / Config.PlotCount)
	local position = Vector3.new(math.cos(angle), 0, math.sin(angle)) * Config.PlotDistance + Vector3.new(0, 1, 0)
	local outward = Vector3.new(position.X, 0, position.Z).Unit

	local model = Instance.new("Model")
	model.Name = "Plot" .. index
	model.Parent = plotsFolder

	local plot = {
		index = index,
		cframe = CFrame.lookAt(position, position + outward),
		model = model,
		owner = nil,
		buttons = {},
		buying = false,
	}

	plot.items = Instance.new("Folder")
	plot.items.Name = "Items"
	plot.items.Parent = model
	plot.drops = Instance.new("Folder")
	plot.drops.Name = "Drops"
