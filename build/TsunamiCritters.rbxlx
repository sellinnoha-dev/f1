    <Item class="ModuleScript" referent="2">
      <Properties>
        <string name="Name">Config</string>
        <string name="Source"><![CDATA[-- ============================================================
-- Tsunami Critters : TOUS LES RÉGLAGES DU JEU
-- Change les chiffres ici pour équilibrer le jeu, sans toucher au reste du code.
-- ============================================================

local Config = {}

-- Version du jeu, affichée dans la Sortie au lancement
Config.Version = "2 - vague qui fait peur"
Config.GameName = "Tsunami Critters"

Config.StartingCash = 0

-- Sauvegarde (marche seulement une fois le jeu publié, ou avec l'accès API dans Studio)
Config.SaveEnabled = true
Config.DataStoreName = "TsunamiCritters_v1"
Config.AutosaveInterval = 120

-- ============================================================
-- CARTE : un long chemin entre deux falaises, de la base (X = 0) jusqu'à la mer
-- ============================================================
Config.PathLength = 1500
Config.PathWidth = 60
-- Tranchées où se cacher (position le long du chemin) : de plus en plus espacées
Config.Trenches = { 100, 200, 310, 430, 560, 700, 850, 1010, 1180, 1360 }
Config.TrenchLength = 14
Config.TrenchDepth = 9

-- ============================================================
-- RARETÉS : plus on va loin, plus les créatures sont rares
-- ============================================================
Config.Rarities = {
	{ id = "common", name = "COMMON", color = Color3.fromRGB(200, 200, 200) },
	{ id = "rare", name = "RARE", color = Color3.fromRGB(70, 150, 255) },
	{ id = "epic", name = "EPIC", color = Color3.fromRGB(180, 80, 255) },
	{ id = "legendary", name = "LEGENDARY", color = Color3.fromRGB(255, 190, 0) },
	{ id = "mythic", name = "MYTHIC", color = Color3.fromRGB(255, 50, 80) },
	{ id = "secret", name = "SECRET", color = Color3.fromRGB(0, 255, 220) },
	-- Jamais sur le chemin : apparaît parfois devant les bases après une vague
	{ id = "divine", name = "DIVINE", color = Color3.fromRGB(255, 255, 255) },
}

-- Zones du chemin (dans l'ordre, depuis la base)
--   chances = probabilité de chaque rareté dans la zone ; count = créatures en même temps
Config.Zones = {
	{ rarity = "common", from = 0, to = 200, count = 6, color = Color3.fromRGB(120, 180, 95),
		chances = { common = 90, rare = 10 } },
	{ rarity = "rare", from = 200, to = 450, count = 5, color = Color3.fromRGB(95, 150, 200),
		chances = { common = 30, rare = 62, epic = 8 } },
	{ rarity = "epic", from = 450, to = 700, count = 5, color = Color3.fromRGB(150, 110, 200),
		chances = { rare = 35, epic = 58, legendary = 7 } },
	{ rarity = "legendary", from = 700, to = 950, count = 4, color = Color3.fromRGB(220, 180, 80),
		chances = { epic = 45, legendary = 50, mythic = 5 } },
	{ rarity = "mythic", from = 950, to = 1250, count = 3, color = Color3.fromRGB(200, 90, 100),
		chances = { legendary = 55, mythic = 42, secret = 3 } },
	{ rarity = "secret", from = 1250, to = 1500, count = 3, color = Color3.fromRGB(60, 200, 190),
		chances = { mythic = 80, secret = 20 } },
}
Config.SpawnInterval = 4 -- secondes entre deux apparitions (par zone)

-- Créature DIVINE : après chaque vague, petite chance qu'elle apparaisse devant les bases
-- (elle reste jusqu'à la vague suivante)
Config.DivineChance = 0.04

-- ============================================================
-- LA VAGUE
-- ============================================================
Config.WaveInterval = 35 -- secondes de calme entre deux vagues
Config.WaveWarning = 7 -- alerte avant l'arrivée
Config.WaveStartX = 1580 -- la vague part de la mer
Config.WaveThickness = 40
Config.SafeDepth = -3 -- dans une tranchée (plus bas que ça), la vague passe au-dessus
Config.WaveTypes = {
	{ name = "TSUNAMI", speed = 50, height = 60, weight = 60, color = Color3.fromRGB(30, 100, 190) },
	{ name = "FAST TSUNAMI", speed = 80, height = 50, weight = 25, color = Color3.fromRGB(25, 140, 200) },
	{ name = "GIANT TSUNAMI", speed = 40, height = 120, weight = 12, color = Color3.fromRGB(15, 55, 140) },
	{ name = "LIGHTNING TSUNAMI", speed = 120, height = 55, weight = 3, color = Color3.fromRGB(110, 60, 200) },
}

-- ============================================================
-- BASE ET AMÉLIORATIONS
-- ============================================================
Config.PlotCount = 8
Config.BasePedestals = 6
Config.SellMultiplier = 30 -- prix de vente d'une créature = son gain par seconde x 30

Config.Upgrades = {
	{ id = "speed", name = "SPEED", perLevel = 2, description = "+2 walk speed",
		prices = { 150, 500, 1500, 5000, 15000, 50000, 150000, 500000 } },
	{ id = "carry", name = "CARRY", perLevel = 1, description = "+1 critter carried",
		prices = { 3000, 50000, 750000 } },
	{ id = "pedestals", name = "PEDESTALS", perLevel = 2, description = "+2 pedestals",
		prices = { 800, 8000, 80000 } },
}

-- ============================================================
-- OBJETS (boutique au fond de la zone des bases). Un objet = une utilisation.
-- requires = rareté qu'il faut avoir déjà obtenue pour le débloquer
-- ============================================================
Config.Items = {
	{ id = "cloak", name = "Invisibility Cloak", requires = "rare", price = 5000, duration = 12,
		color = Color3.fromRGB(170, 200, 255), description = "Invisible for 12s" },
	{ id = "freeze", name = "Freeze Ray", requires = "epic", price = 25000, duration = 4, range = 45,
		color = Color3.fromRGB(120, 230, 255), description = "Freeze the closest player for 4s" },
	{ id = "raidkey", name = "Raid Key", requires = "legendary", price = 100000, duration = 20,
		color = Color3.fromRGB(255, 200, 40), description = "Enter another base for 20s and steal a critter" },
}

-- ============================================================
-- CRÉATURES : 3 par rareté. income = argent par seconde dans ta base.
-- look : body = "ball", "block" ou "cylinder" ; extras = accessoires
--   (antenna, feet, mustache, tophat, shades, propeller, headband, crown,
--    wizardhat, shell, wings, halo, horns, brows)
-- Musique et sons : voir le README (dossiers Music et Sounds dans SoundService)
-- Pour utiliser ton propre modèle : range-le dans ServerStorage > Assets
-- avec exactement le même nom que la créature (ex. "Bloop").
-- ============================================================
Config.Creatures = {
	{ id = "bloop", name = "Bloop", rarity = "common", income = 1,
		look = { body = "ball", size = 3, color = Color3.fromRGB(90, 200, 90), accent = Color3.fromRGB(255, 230, 0),
			eyes = 2, extras = { "antenna", "feet" } } },
	{ id = "toasty", name = "Toasty", rarity = "common", income = 2,
		look = { body = "block", size = 3, color = Color3.fromRGB(225, 180, 110), accent = Color3.fromRGB(140, 90, 40),
			eyes = 2, extras = { "feet", "brows" } } },
	{ id = "pebble", name = "Pebble Pete", rarity = "common", income = 3,
		look = { body = "ball", size = 3.2, color = Color3.fromRGB(150, 150, 155), accent = Color3.fromRGB(60, 40, 30),
			eyes = 1, extras = { "mustache", "feet" }, material = Enum.Material.Slate } },

	{ id = "noodle", name = "Captain Noodle", rarity = "rare", income = 10,
		look = { body = "cylinder", size = 3.2, color = Color3.fromRGB(250, 220, 100), accent = Color3.fromRGB(30, 30, 35),
			eyes = 2, extras = { "tophat", "mustache" } } },
	{ id = "potato", name = "Disco Potato", rarity = "rare", income = 13,
		look = { body = "ball", size = 3.4, color = Color3.fromRGB(170, 120, 70), accent = Color3.fromRGB(255, 80, 200),
			eyes = 2, extras = { "shades", "feet", "antenna" } } },
	{ id = "cloud", name = "Grumpy Cloud", rarity = "rare", income = 16,
		look = { body = "ball", size = 3.6, color = Color3.fromRGB(240, 240, 250), accent = Color3.fromRGB(80, 80, 100),
			eyes = 2, extras = { "brows", "wings" } } },

	{ id = "frog", name = "Rocket Frog", rarity = "epic", income = 45,
		look = { body = "ball", size = 3.6, color = Color3.fromRGB(40, 160, 70), accent = Color3.fromRGB(255, 90, 30),
			eyes = 2, extras = { "propeller", "feet" } } },
	{ id = "banana", name = "Banana Ninja", rarity = "epic", income = 55,
		look = { body = "cylinder", size = 3.4, color = Color3.fromRGB(255, 225, 60), accent = Color3.fromRGB(220, 30, 40),
			eyes = 2, extras = { "headband", "brows", "feet" } } },
	{ id = "cactus", name = "Cactus Cowboy", rarity = "epic", income = 65,
		look = { body = "cylinder", size = 3.6, color = Color3.fromRGB(60, 140, 70), accent = Color3.fromRGB(130, 80, 40),
			eyes = 2, extras = { "tophat", "mustache" } } },

	{ id = "wobbleton", name = "Sir Wobbleton", rarity = "legendary", income = 220,
		look = { body = "ball", size = 4, color = Color3.fromRGB(140, 70, 200), accent = Color3.fromRGB(255, 200, 0),
			eyes = 2, extras = { "crown", "mustache", "feet" } } },
	{ id = "pizza", name = "Pizza Wizard", rarity = "legendary", income = 260,
		look = { body = "block", size = 3.8, color = Color3.fromRGB(240, 150, 50), accent = Color3.fromRGB(60, 50, 180),
			eyes = 2, extras = { "wizardhat", "brows" } } },
	{ id = "snail", name = "Turbo Snail", rarity = "legendary", income = 300,
		look = { body = "ball", size = 3.6, color = Color3.fromRGB(120, 220, 200), accent = Color3.fromRGB(230, 60, 60),
			eyes = 2, extras = { "shell", "antenna", "shades" } } },

	{ id = "spaghetti", name = "Lord Spaghetti", rarity = "mythic", income = 1100,
		look = { body = "cylinder", size = 4, color = Color3.fromRGB(250, 210, 120), accent = Color3.fromRGB(200, 30, 30),
			eyes = 2, extras = { "crown", "wings", "mustache" } } },
	{ id = "toast", name = "Cosmic Toast", rarity = "mythic", income = 1300,
		look = { body = "block", size = 4, color = Color3.fromRGB(80, 60, 160), accent = Color3.fromRGB(0, 230, 255),
			eyes = 3, extras = { "halo", "wings" }, material = Enum.Material.Neon } },
	{ id = "pickle", name = "Dragon Pickle", rarity = "mythic", income = 1500,
		look = { body = "cylinder", size = 4.2, color = Color3.fromRGB(90, 170, 50), accent = Color3.fromRGB(255, 120, 0),
			eyes = 2, extras = { "horns", "wings", "brows" } } },

	{ id = "duck", name = "The Golden Duck", rarity = "secret", income = 6000,
		look = { body = "ball", size = 4.5, color = Color3.fromRGB(255, 200, 30), accent = Color3.fromRGB(255, 120, 0),
			eyes = 2, extras = { "crown", "halo", "feet" }, material = Enum.Material.Foil } },
	{ id = "glitch", name = "Glitch Cat", rarity = "secret", income = 8000,
		look = { body = "block", size = 4.4, color = Color3.fromRGB(20, 20, 30), accent = Color3.fromRGB(0, 255, 120),
			eyes = 3, extras = { "horns", "antenna", "shades" } } },
	{ id = "kingbloop", name = "King Bloop", rarity = "secret", income = 10000,
		look = { body = "ball", size = 5, color = Color3.fromRGB(0, 230, 200), accent = Color3.fromRGB(255, 215, 0),
			eyes = 2, extras = { "crown", "wings", "halo", "feet" }, material = Enum.Material.Glass } },

	{ id = "prism", name = "Prism Prince", rarity = "divine", income = 50000,
		look = { body = "ball", size = 5, color = Color3.fromRGB(255, 255, 255), accent = Color3.fromRGB(255, 120, 255),
			eyes = 3, extras = { "crown", "wings", "halo" }, material = Enum.Material.Glass } },
	{ id = "astral", name = "Astral Noodle", rarity = "divine", income = 75000,
		look = { body = "cylinder", size = 5, color = Color3.fromRGB(40, 20, 90), accent = Color3.fromRGB(255, 230, 120),
			eyes = 2, extras = { "horns", "wings", "halo", "mustache" }, material = Enum.Material.Neon } },
}

return Config
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="3">
      <Properties>
        <string name="Name">FormatMoney</string>
        <string name="Source"><![CDATA[-- Transforme un nombre en texte court : 1500 -> "1.5K", 2000000 -> "2M"
-- Utilisé par le serveur (panneaux) et par le client (compteur d'argent).
return function(n)
	n = math.floor(n)
	local text
	if n >= 1e9 then
		text = string.format("%.1fB", n / 1e9)
	elseif n >= 1e6 then
		text = string.format("%.1fM", n / 1e6)
	elseif n >= 1e3 then
		text = string.format("%.1fK", n / 1e3)
	else
		return tostring(n)
	end
	return (text:gsub("%.0([KMB])", "%1"))
end
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="4">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="5">
      <Properties>
        <string name="Name">WaveServer</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- ============================================================
-- Tsunami Critters : le moteur du jeu (côté serveur)
-- Carte, vague, créatures, bases des joueurs, améliorations, sauvegarde.
-- ============================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local DataStoreService = game:GetService("DataStoreService")
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local formatMoney = require(ReplicatedStorage:WaitForChild("FormatMoney"))

print("[Tsunami] Version " .. tostring(Config.Version))

-- On gère nous-mêmes l'apparition des personnages (dans sa base)
Players.CharacterAutoLoads = false

local raritiesById, rarityIndex, creaturesById, creaturesByRarity = {}, {}, {}, {}
for index, rarity in ipairs(Config.Rarities) do
	raritiesById[rarity.id] = rarity
	rarityIndex[rarity.id] = index
	creaturesByRarity[rarity.id] = {}
end
for _, def in ipairs(Config.Creatures) do
	creaturesById[def.id] = def
	table.insert(creaturesByRarity[def.rarity], def)
end

local notifyEvent = Instance.new("RemoteEvent")
notifyEvent.Name = "Notify"
notifyEvent.Parent = ReplicatedStorage

local function notify(player, text)
	if player and player.Parent then
		notifyEvent:FireClient(player, text)
	end
end

local function notifyAll(text)
	notifyEvent:FireAllClients(text)
end

-- ============================================================
-- Petits outils
-- ============================================================

local function makePart(parent, props)
	local part = Instance.new("Part")
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in pairs(props) do
		part[key] = value
	end
	part.Parent = parent
	return part
end

-- Étiquette au-dessus d'un objet : un titre et un sous-titre
local function createBillboard(part, title, subtitle, offsetY, width, titleColor, maxDistance)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.new(width or 8, 0, subtitle and 2.4 or 1.3, 0)
	gui.StudsOffset = Vector3.new(0, offsetY or 3, 0)
	gui.MaxDistance = maxDistance or 90
	gui.LightInfluence = 0
	gui.AlwaysOnTop = false
	gui.Parent = part
	local function addLabel(name, text, posY, height, color)
		local label = Instance.new("TextLabel")
		label.Name = name
		label.Position = UDim2.fromScale(0, posY)
		label.Size = UDim2.fromScale(1, height)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.GothamBlack
		label.TextScaled = true
		label.TextColor3 = color
		label.TextStrokeTransparency = 0
		label.Text = text
		label.Parent = gui
	end
	if subtitle then
		addLabel("Title", title, 0, 0.55, titleColor or Color3.new(1, 1, 1))
		addLabel("Subtitle", subtitle, 0.57, 0.43, Color3.fromRGB(255, 220, 80))
	else
		addLabel("Title", title, 0, 1, titleColor or Color3.new(1, 1, 1))
	end
	return gui
end

local function setBillboard(gui, title, subtitle)
	local titleLabel = gui:FindFirstChild("Title")
	local subtitleLabel = gui:FindFirstChild("Subtitle")
	if titleLabel and title then
		titleLabel.Text = title
	end
	if subtitleLabel and subtitle then
		subtitleLabel.Text = subtitle
	end
end

local function getCash(player)
	local stats = player:FindFirstChild("leaderstats")
	return stats and stats:FindFirstChild("Cash")
end

local function getRoot(player)
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid(player)
	local character = player.Character
	return character and character:FindFirstChildOfClass("Humanoid")
end

local function vertical(cframe)
	-- Les cylindres Roblox sont couchés (axe X) : on les met debout
	return cframe * CFrame.Angles(0, 0, math.rad(90))
end

-- ============================================================
-- Construction des créatures (formes simples + accessoires)
-- ============================================================

local assetsFolder = ServerStorage:FindFirstChild("Assets")

-- Une créature : modèle dont le pivot est sous ses pieds, tourné vers -Z
local function buildCreature(def)
	local look = def.look
	local rarity = raritiesById[def.rarity]
	local s = look.size or 3
	local accent = look.accent or Color3.new(1, 1, 1)
	local model = Instance.new("Model")
	model.Name = def.name

	local function piece(props)
		props.CanCollide = false
		props.CanTouch = false
		props.CastShadow = false
		if not props.Material then
			props.Material = Enum.Material.SmoothPlastic
		end
		return makePart(model, props)
	end

	-- Corps
	local body, height, front
	if look.body == "block" then
		height = s * 0.9
		body = piece({ Name = "Body", Size = Vector3.new(s, height, s * 0.8), CFrame = CFrame.new(0, height / 2, 0),
			Color = look.color, Material = look.material })
		front = -s * 0.4
	elseif look.body == "cylinder" then
		height = s * 1.3
		body = piece({ Name = "Body", Shape = Enum.PartType.Cylinder, Size = Vector3.new(height, s * 0.8, s * 0.8),
			CFrame = vertical(CFrame.new(0, height / 2, 0)), Color = look.color, Material = look.material })
		front = -s * 0.4
	else
		height = s
		body = piece({ Name = "Body", Shape = Enum.PartType.Ball, Size = Vector3.new(s, s, s),
			CFrame = CFrame.new(0, height / 2, 0), Color = look.color, Material = look.material })
		front = -s * 0.44
	end
	local top = height
	local eyeY = height * 0.62

	-- Yeux (blanc + pupille noire)
	local eyeCount = look.eyes or 2
	local eyeX = ({ { 0 }, { -0.2, 0.2 }, { -0.26, 0, 0.26 } })[math.clamp(eyeCount, 1, 3)]
	for _, x in ipairs(eyeX) do
		piece({ Name = "Eye", Shape = Enum.PartType.Ball, Size = Vector3.one * s * 0.3,
			CFrame = CFrame.new(x * s, eyeY, front), Color = Color3.new(1, 1, 1) })
		piece({ Name = "Pupil", Shape = Enum.PartType.Ball, Size = Vector3.one * s * 0.15,
			CFrame = CFrame.new(x * s, eyeY, front - s * 0.12), Color = Color3.fromRGB(15, 15, 20) })
	end
	-- Bouche
	piece({ Name = "Mouth", Size = Vector3.new(s * 0.3, s * 0.07, s * 0.06), CFrame = CFrame.new(0, height * 0.36, front - s * 0.02),
		Color = Color3.fromRGB(60, 20, 20) })

	local dark = Color3.fromRGB(25, 25, 30)
	local extras = {}
	for _, extra in ipairs(look.extras or {}) do
		extras[extra] = true
	end

	if extras.antenna then
		piece({ Name = "Antenna", Shape = Enum.PartType.Cylinder, Size = Vector3.new(s * 0.6, s * 0.06, s * 0.06),
			CFrame = vertical(CFrame.new(0, top + s * 0.28, 0)), Color = dark })
		piece({ Name = "AntennaBall", Shape = Enum.PartType.Ball, Size = Vector3.one * s * 0.2,
			CFrame = CFrame.new(0, top + s * 0.62, 0), Color = accent, Material = Enum.Material.Neon })
		top += s * 0.7
	end
	if extras.feet then
		for _, x in ipairs({ -0.25, 0.25 }) do
			piece({ Name = "Foot", Shape = Enum.PartType.Ball, Size = Vector3.new(s * 0.3, s * 0.18, s * 0.38),
				CFrame = CFrame.new(x * s, s * 0.06, -s * 0.12), Color = accent })
		end
	end
	if extras.mustache then
		for _, side in ipairs({ -1, 1 }) do
			piece({ Name = "Mustache", Size = Vector3.new(s * 0.24, s * 0.08, s * 0.06),
				CFrame = CFrame.new(side * s * 0.12, height * 0.45, front - s * 0.04) * CFrame.Angles(0, 0, math.rad(side * -15)),
				Color = dark })
		end
	end
	if extras.brows then
		for _, x in ipairs(eyeX) do
			local side = x < 0 and -1 or (x > 0 and 1 or 0)
			piece({ Name = "Brow", Size = Vector3.new(s * 0.22, s * 0.06, s * 0.06),
				CFrame = CFrame.new(x * s, eyeY + s * 0.2, front - s * 0.06) * CFrame.Angles(0, 0, math.rad(side * 20)),
				Color = dark })
		end
	end
	if extras.shades then
		piece({ Name = "Shades", Size = Vector3.new(s * (eyeCount == 3 and 0.95 or 0.75), s * 0.17, s * 0.06),
			CFrame = CFrame.new(0, eyeY, front - s * 0.16), Color = dark, Reflectance = 0.4 })
	end
	if extras.headband then
		piece({ Name = "Headband", Shape = Enum.PartType.Cylinder, Size = Vector3.new(s * 0.14, s * 0.86, s * 0.86),
			CFrame = vertical(CFrame.new(0, height * 0.86, 0)), Color = accent })
		piece({ Name = "BandTail", Size = Vector3.new(s * 0.08, s * 0.1, s * 0.4),
			CFrame = CFrame.new(s * 0.1, height * 0.82, s * 0.55) * CFrame.Angles(math.rad(-20), 0, 0), Color = accent })
	end
	if extras.tophat then
		piece({ Name = "HatBrim", Shape = Enum.PartType.Cylinder, Size = Vector3.new(s * 0.06, s * 0.85, s * 0.85),
			CFrame = vertical(CFrame.new(0, top - s * 0.02, 0)), Color = accent })
		piece({ Name = "Hat", Shape = Enum.PartType.Cylinder, Size = Vector3.new(s * 0.5, s * 0.52, s * 0.52),
			CFrame = vertical(CFrame.new(0, top + s * 0.25, 0)), Color = accent })
		top += s * 0.5
	end
	if extras.wizardhat then
		local y = top - s * 0.05
		for i, size in ipairs({ { 0.12, 0.9 }, { 0.35, 0.55 }, { 0.35, 0.3 } }) do
			piece({ Name = "WizardHat", Shape = Enum.PartType.Cylinder, Size = Vector3.new(s * size[1], s * size[2], s * size[2]),
				CFrame = vertical(CFrame.new(0, y + s * size[1] / 2, 0)), Color = accent })
			y += s * size[1]
			if i == 3 then
				piece({ Name = "Star", Shape = Enum.PartType.Ball, Size = Vector3.one * s * 0.18,
					CFrame = CFrame.new(0, y + s * 0.05, 0), Color = Color3.fromRGB(255, 230, 0), Material = Enum.Material.Neon })
			end
		end
		top = y + s * 0.15
	end
	if extras.crown then
		local gold = Color3.fromRGB(255, 200, 30)
		piece({ Name = "Crown", Shape = Enum.PartType.Cylinder, Size = Vector3.new(s * 0.22, s * 0.55, s * 0.55),
			CFrame = vertical(CFrame.new(0, top + s * 0.08, 0)), Color = gold, Reflectance = 0.3, Material = Enum.Material.Metal })
		for i = 0, 4 do
			local angle = i / 5 * 2 * math.pi
			piece({ Name = "CrownSpike", Size = Vector3.new(s * 0.09, s * 0.2, s * 0.09),
				CFrame = CFrame.new(math.cos(angle) * s * 0.24, top + s * 0.28, math.sin(angle) * s * 0.24),
				Color = gold, Material = Enum.Material.Metal, Reflectance = 0.3 })
		end
		piece({ Name = "Gem", Shape = Enum.PartType.Ball, Size = Vector3.one * s * 0.12,
			CFrame = CFrame.new(0, top + s * 0.1, -s * 0.28), Color = Color3.fromRGB(255, 40, 60), Material = Enum.Material.Neon })
		top += s * 0.4
	end
	if extras.propeller then
		piece({ Name = "PropRod", Shape = Enum.PartType.Cylinder, Size = Vector3.new(s * 0.3, s * 0.07, s * 0.07),
			CFrame = vertical(CFrame.new(0, top + s * 0.13, 0)), Color = dark })
		for _, angle in ipairs({ 0, 90 }) do
			piece({ Name = "PropBlade", Size = Vector3.new(s * 1.1, s * 0.04, s * 0.16),
				CFrame = CFrame.new(0, top + s * 0.3, 0) * CFrame.Angles(0, math.rad(angle), 0), Color = accent })
		end
		top += s * 0.35
	end
	if extras.shell then
		piece({ Name = "Shell", Shape = Enum.PartType.Ball, Size = Vector3.one * s * 0.9,
			CFrame = CFrame.new(0, height * 0.6, s * 0.42), Color = accent })
		piece({ Name = "ShellSpiral", Shape = Enum.PartType.Ball, Size = Vector3.one * s * 0.4,
			CFrame = CFrame.new(s * 0.36, height * 0.62, s * 0.45), Color = Color3.new(1, 1, 1) })
		for _, side in ipairs({ -1, 1 }) do
			piece({ Name = "Exhaust", Shape = Enum.PartType.Cylinder, Size = Vector3.new(s * 0.3, s * 0.12, s * 0.12),
				CFrame = CFrame.new(side * s * 0.15, height * 0.4, s * 0.9) * CFrame.Angles(0, math.rad(90), 0),
				Color = Color3.fromRGB(180, 180, 190), Material = Enum.Material.Metal })
		end
	end
	if extras.wings then
		for _, side in ipairs({ -1, 1 }) do
			piece({ Name = "Wing", Size = Vector3.new(s * 0.08, s * 0.5, s * 0.75),
				CFrame = CFrame.new(side * s * 0.55, height * 0.62, s * 0.15) * CFrame.Angles(0, 0, math.rad(side * -30)),
				Color = Color3.new(1, 1, 1), Transparency = 0.15 })
		end
	end
	if extras.horns then
		for _, side in ipairs({ -1, 1 }) do
			piece({ Name = "Horn", Shape = Enum.PartType.Cylinder, Size = Vector3.new(s * 0.4, s * 0.12, s * 0.12),
				CFrame = CFrame.new(side * s * 0.25, height + s * 0.05, 0) * CFrame.Angles(0, 0, math.rad(90 - side * 25)),
				Color = accent })
		end
	end
	if extras.halo then
		piece({ Name = "Halo", Shape = Enum.PartType.Cylinder, Size = Vector3.new(s * 0.06, s * 0.65, s * 0.65),
			CFrame = vertical(CFrame.new(0, top + s * 0.3, 0)), Color = Color3.fromRGB(255, 240, 120),
			Material = Enum.Material.Neon, Transparency = 0.2 })
		top += s * 0.35
	end

	-- Effets des grandes raretés
	local level = rarityIndex[def.rarity] or 1
	if level >= 4 then
		local light = Instance.new("PointLight")
		light.Color = rarity.color
		light.Range = 10
		light.Brightness = 2
		light.Parent = body
	end
	if level >= 5 then
		local sparkles = Instance.new("Sparkles")
		sparkles.SparkleColor = rarity.color
		sparkles.Parent = body
	end

	model.PrimaryPart = body
	model.WorldPivot = CFrame.new()
	model:SetAttribute("Height", top)
	return model
end

-- Version "modèle perso" : si un modèle porte le nom de la créature dans ServerStorage > Assets
local function buildCustomCreature(def)
	local asset = assetsFolder and assetsFolder:FindFirstChild(def.name)
	if not asset or not (asset:IsA("Model") or asset:IsA("BasePart")) then
		return nil
	end
	local clone = asset:Clone()
	for _, descendant in ipairs(clone:GetDescendants()) do
		if descendant:IsA("LuaSourceContainer") then
			descendant:Destroy()
		end
	end
	local model = clone
	if clone:IsA("BasePart") then
		model = Instance.new("Model")
		clone.Parent = model
	end
	model.Name = def.name
	local parts = {}
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("BasePart") then
			table.insert(parts, descendant)
		end
	end
	if #parts == 0 then
		return nil
	end
	local box, size = model:GetBoundingBox()
	local target = (def.look.size or 3) * 1.4
	model.WorldPivot = CFrame.new(box.Position - Vector3.new(0, size.Y / 2, 0))
	model:ScaleTo(model:GetScale() * target / math.max(size.X, size.Y, size.Z))
	local biggest = parts[1]
	for _, part in ipairs(parts) do
		part.CanCollide = false
		part.CanTouch = false
		if part.Size.Magnitude > biggest.Size.Magnitude then
			biggest = part
		end
	end
	model.PrimaryPart = biggest
	model:PivotTo(CFrame.new())
	local _, newSize = model:GetBoundingBox()
	model:SetAttribute("Height", newSize.Y)
	return model
end

-- Construit la créature puis soude tout à la pièce principale (ancrée seule)
local function makeCreatureModel(def)
	local model = buildCustomCreature(def) or buildCreature(def)
	local root = model.PrimaryPart
	for _, part in ipairs(model:GetDescendants()) do
		if part:IsA("BasePart") and part ~= root then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = root
			weld.Part1 = part
			weld.Parent = root
			part.Anchored = false
			part.Massless = true
		end
	end
	root.Anchored = true
	return model
end

local function creatureLabel(model, def, offset)
	local rarity = raritiesById[def.rarity]
	return createBillboard(model.PrimaryPart, def.name, rarity.name .. "  ·  $" .. formatMoney(def.income) .. "/s",
		offset or ((model:GetAttribute("Height") or 3) - model.PrimaryPart.Position.Y + model:GetPivot().Y + 1.8), 9, rarity.color)
end

-- La créature flotte et tourne doucement (animé côté joueur, voir WaveClient)
local function makeBobbing(model)
	model:SetAttribute("BaseCFrame", model.PrimaryPart.CFrame)
	CollectionService:AddTag(model, "Bobbing")
end

